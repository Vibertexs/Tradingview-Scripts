//@version=6
indicator("Flow MA", overlay=true)

// ─────────────────── Inputs
intelligence = input.int(20, "Intelligence Period", minval=5, maxval=200)
erPower      = input.float(2.0, "ER Adaptability", minval=0.5, maxval=4.0, step=0.5)
invertAlpha  = input.bool(true, "Corrected Alpha")
colorMode    = input.string("Price Position", "Coloring Mode", options=["Price Position", "Line Direction"])
bool use_gate  = input.bool(true, "Range Gate")
float gate_mult = input.float(1.5, "Range Gate Multiplier", minval=0.5, maxval=4.0, step=0.1)

// ─────────────────── Flow MA Engine
flow_hybrid(src, intel, erAdapt, correctAlpha) =>
    len  = intel
    half = len / 2
    float n1 = (ta.highest(high, half) - ta.lowest(low, half)) / half
    float n2 = (ta.highest(high[half], half) - ta.lowest(low[half], half)) / half
    float n3 = (ta.highest(high, len) - ta.lowest(low, len)) / len
    float dimension = (n1 > 0 and n2 > 0 and n3 > 0) ? (math.log(n1 + n2) - math.log(n3)) / math.log(2.0) : 1.5
    dimension := math.min(math.max(dimension, 1.0), 2.0)

    float signal = math.abs(src - src[len])
    float noise  = 0.0
    for i = 0 to len - 1
        noise += math.abs(src[i] - src[i + 1])
    float efficiency = (noise > 0) ? signal / noise : 0.0

    float power = 0.45
    float beta  = power * (len - 1) / ((power * (len - 1)) + 2)
    float len1  = math.max(math.log(math.sqrt(0.5 * (len - 1))) / math.log(2.0) + 2.0, 0)
    float pow1  = math.max(len1 - 2.0, 0.5)

    float rawFrama   = math.exp(-4.6 * (dimension - 1.0))
    float framaAlpha = correctAlpha ? 1.0 - rawFrama : rawFrama
    framaAlpha := math.min(math.max(framaAlpha, 0.01), 1.0)
    float kamaWeight = math.pow(efficiency, erAdapt)
    float jmaAlpha   = math.pow(beta, 1.0 / pow1)
    float alpha      = kamaWeight * framaAlpha + (1.0 - kamaWeight) * jmaAlpha
    alpha := math.min(math.max(alpha, 0.01), 0.95)

    var float ma1    = na
    var float det0   = na
    var float det1   = na
    var float result = na
    ma1    := na(ma1)    ? src : src + (alpha * (ma1 - src))
    det0   := na(det0)   ? 0.0 : (src - ma1) * (1.0 - beta) + beta * det0
    float ma2          = ma1 + 1.5 * det0
    float alphaSq      = alpha * alpha
    float oneMinusAlphaSq = (1.0 - alpha) * (1.0 - alpha)
    det1   := na(det1)   ? 0.0 : (ma2 - nz(result, src)) * oneMinusAlphaSq + alphaSq * det1
    result := na(result) ? src : nz(result, src) + det1

    [result, dimension, efficiency, alpha]

// ─────────────────── Execute
[flowMA_raw, fractalD, efficiencyER, adaptiveAlpha] = flow_hybrid(close, intelligence, erPower, invertAlpha)

// ─────────────────── Range Gate
int fast_p = math.max(intelligence / 2, 3)
int slow_p = intelligence

float fast_range = ta.ema(math.abs(close - nz(close[1], close)), fast_p)
float fast_smooth = ta.ema(fast_range, fast_p * 2 - 1)
float slow_range = ta.ema(math.abs(close - nz(close[1], close)), slow_p)
float slow_smooth = ta.ema(slow_range, slow_p * 2 - 1)
float gate = ((fast_smooth + slow_smooth) / 2.0) * gate_mult

var float flowMA_gated = na
if na(flowMA_gated)
    flowMA_gated := flowMA_raw
else
    float diff = flowMA_raw - flowMA_gated
    if math.abs(diff) > gate
        flowMA_gated := diff > 0 ? flowMA_raw - gate : flowMA_raw + gate

float flowMA = use_gate ? flowMA_gated : flowMA_raw

// ─────────────────── Coloring
color upColor   = color.rgb(0, 255, 0)
color downColor = color.rgb(255, 0, 0)
bool priceAbove = close > flowMA
bool slopingUp  = flowMA > nz(flowMA[1], flowMA)
color maColor   = colorMode == "Price Position" ? (priceAbove ? upColor : downColor) : (slopingUp ? upColor : downColor)

// ─────────────────── Plotting
plot(flowMA, "Flow MA", color=maColor, linewidth=3)
