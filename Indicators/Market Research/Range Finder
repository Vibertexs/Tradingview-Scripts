indicator("Range Finder [Range-First v1]", overlay = true, max_boxes_count = 300, max_labels_count = 300)

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
var string G_CORE  = "Range Detection"
var string G_STYLE = "Style"

rangeLength = input.int(30, "Range Length", minval = 10, maxval = 150, group = G_CORE,
     tooltip = "Lookback used to judge whether price is rotating inside a horizontal area. 20-40 is a good starting zone.")

rangeSensitivity = input.int(7, "Range Sensitivity", minval = 1, maxval = 10, group = G_CORE,
     tooltip = "Higher = detect ranges earlier/more often. Lower = only accept cleaner, tighter ranges.")

showRangeBoxes = input.bool(true, "Show Range Boxes", group = G_STYLE)
boxTransparency = input.int(86, "Box Transparency", minval = 0, maxval = 100, group = G_STYLE)
rangeColor = input.color(#808080, "Range Color", group = G_STYLE)

// ─────────────────────────────────────────────────────────────────────────────
// Adaptive thresholds
// ─────────────────────────────────────────────────────────────────────────────
// One sensitivity control drives all range tests so the menu stays simple.
// Higher sensitivity is deliberately more permissive.
float s = rangeSensitivity
float maxEfficiency = 0.14 + s * 0.032          // 0.17 .. 0.46
float maxAtrRatio   = 0.70 + s * 0.035          // 0.74 .. 1.05
float maxWidthAtr   = 3.50 + s * 0.55           // 4.05 .. 9.00 ATR
float minOverlap    = 0.68 - s * 0.038          // 0.64 .. 0.30
float maxSlopeAtr   = 0.018 + s * 0.011         // 0.03 .. 0.13 ATR/bar
float maxDrift      = 0.30 + s * 0.035          // 0.34 .. 0.65 of box width
int confirmBars     = rangeSensitivity >= 9 ? 2 : rangeSensitivity >= 6 ? 3 : rangeSensitivity >= 3 ? 4 : 5
float breakBufferAtr = rangeSensitivity >= 9 ? 0.10 : rangeSensitivity >= 6 ? 0.15 : 0.20
int breakConfirmBars = rangeSensitivity >= 8 ? 1 : 2

// ─────────────────────────────────────────────────────────────────────────────
// Core range measurements
// ─────────────────────────────────────────────────────────────────────────────
float atr = ta.atr(14)
float atrBaseline = ta.sma(atr, 50)
float atrRatio = atr / math.max(nz(atrBaseline, atr), syminfo.mintick)

float rollingTop = ta.highest(high, rangeLength)
float rollingBottom = ta.lowest(low, rangeLength)
float rollingWidth = math.max(rollingTop - rollingBottom, syminfo.mintick)
float widthAtr = rollingWidth / math.max(atr, syminfo.mintick)

// Kaufman-style efficiency ratio: low values mean lots of back-and-forth movement
// relative to net displacement, which is exactly what we want for a range.
float path = ta.sma(math.abs(close - close[1]), rangeLength) * rangeLength
float efficiency = math.abs(close - close[rangeLength]) / math.max(path, syminfo.mintick)

// Normalized linear-regression slope. A real range should have limited directional slope.
float lrNow = ta.linreg(close, rangeLength, 0)
float lrPrev = ta.linreg(close, rangeLength, 1)
float slopeAtr = math.abs(lrNow - lrPrev) / math.max(atr, syminfo.mintick)

// Candle-to-candle overlap. Ranges usually have repeated overlap; clean trends do not.
float overlapAmount = math.max(0.0, math.min(high, high[1]) - math.max(low, low[1]))
float overlapBase = math.max(math.min(high - low, high[1] - low[1]), syminfo.mintick)
float barOverlap = math.min(1.0, overlapAmount / overlapBase)
float avgOverlap = ta.sma(barOverlap, rangeLength)

// Net drift across the lookback relative to the full horizontal envelope.
float driftRatio = math.abs(close - close[rangeLength]) / rollingWidth

// Optional shape check: current price should still be materially inside the envelope,
// not simply sitting at an extreme after a one-way move.
float positionInRange = (close - rollingBottom) / rollingWidth
bool notPinnedToEdge = positionInRange > 0.08 and positionInRange < 0.92

// ─────────────────────────────────────────────────────────────────────────────
// Range score
// ─────────────────────────────────────────────────────────────────────────────
bool efficiencyPass = efficiency <= maxEfficiency
bool compressionPass = atrRatio <= maxAtrRatio
bool widthPass = widthAtr <= maxWidthAtr
bool overlapPass = avgOverlap >= minOverlap
bool slopePass = slopeAtr <= maxSlopeAtr
bool driftPass = driftRatio <= maxDrift

int rangeScore =
     (efficiencyPass ? 1 : 0) +
     (compressionPass ? 1 : 0) +
     (widthPass ? 1 : 0) +
     (overlapPass ? 1 : 0) +
     (slopePass ? 1 : 0) +
     (driftPass ? 1 : 0)

// We require broad agreement instead of trusting a single indicator.
// Sensitivity 8-10 can enter with 4/6; lower settings require 5/6.
int requiredScore = rangeSensitivity >= 8 ? 4 : 5
bool rangeCandidate = rangeScore >= requiredScore and notPinnedToEdge and not na(close[rangeLength])

// Consecutive confirmation prevents a single quiet candle from creating a box.
var int candidateStreak = 0
candidateStreak := rangeCandidate ? candidateStreak + 1 : 0
bool confirmedRangeCandidate = candidateStreak >= confirmBars

// ─────────────────────────────────────────────────────────────────────────────
// Persistent range state
// ─────────────────────────────────────────────────────────────────────────────
var bool inRange = false
var float rangeTop = na
var float rangeBottom = na
var int rangeStartBar = na
var int upBreakStreak = 0
var int downBreakStreak = 0
var box activeRangeBox = na

// Enter using the envelope that existed when the range was confirmed.
// Back-date the visual start by the confirmation streak so the box covers the setup.
bool rangeStarted = false
if not inRange and confirmedRangeCandidate
    inRange := true
    rangeTop := rollingTop
    rangeBottom := rollingBottom
    rangeStartBar := math.max(0, bar_index - confirmBars + 1)
    upBreakStreak := 0
    downBreakStreak := 0
    rangeStarted := true

// While inside a range, allow small wick expansion without instantly ending the range.
// This makes the range finder tolerant of liquidity sweeps.
if inRange
    float softExpand = atr * 0.20
    if high > rangeTop and high <= rangeTop + softExpand
        rangeTop := high
    if low < rangeBottom and low >= rangeBottom - softExpand
        rangeBottom := low

    float breakBuffer = atr * breakBufferAtr
    bool upBreak = close > rangeTop + breakBuffer
    bool downBreak = close < rangeBottom - breakBuffer

    upBreakStreak := upBreak ? upBreakStreak + 1 : 0
    downBreakStreak := downBreak ? downBreakStreak + 1 : 0

bool rangeEndedUp = false
bool rangeEndedDown = false

if inRange and upBreakStreak >= breakConfirmBars
    rangeEndedUp := true
    inRange := false
    candidateStreak := 0

if inRange and downBreakStreak >= breakConfirmBars
    rangeEndedDown := true
    inRange := false
    candidateStreak := 0

// ─────────────────────────────────────────────────────────────────────────────
// Boxes
// ─────────────────────────────────────────────────────────────────────────────
if rangeStarted and showRangeBoxes
    if not na(activeRangeBox)
        box.set_right(activeRangeBox, bar_index)
    activeRangeBox := box.new(
         left = rangeStartBar,
         top = rangeTop,
         right = bar_index,
         bottom = rangeBottom,
         xloc = xloc.bar_index,
         bgcolor = color.new(rangeColor, boxTransparency),
         border_color = rangeColor,
         border_style = line.style_dotted,
         border_width = 1,
         text = "RANGE",
         text_color = rangeColor,
         text_size = size.tiny,
         text_halign = text.align_left,
         text_valign = text.align_top)

if inRange and showRangeBoxes and not na(activeRangeBox)
    box.set_right(activeRangeBox, bar_index)
    box.set_top(activeRangeBox, rangeTop)
    box.set_bottom(activeRangeBox, rangeBottom)

if (rangeEndedUp or rangeEndedDown) and not na(activeRangeBox)
    box.set_right(activeRangeBox, bar_index)
    activeRangeBox := na

if not showRangeBoxes and not na(activeRangeBox)
    box.delete(activeRangeBox)
    activeRangeBox := na

// ─────────────────────────────────────────────────────────────────────────────
// Alerts
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(rangeStarted, "Range Started", "A new price range was detected")
alertcondition(rangeEndedUp, "Range Breakout Up", "Price closed above the active range")
alertcondition(rangeEndedDown, "Range Breakout Down", "Price closed below the active range")
