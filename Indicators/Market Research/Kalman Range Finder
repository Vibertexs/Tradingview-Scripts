//@version=6
// Range Finder [Kalman] v2 — adaptive range lifecycle
//
// v1 seeded a range from a fixed 30-bar high/low, froze it, and killed it on the
// first confirmed close outside. Inside a long shelf that is fatal: the frozen
// boundary is a 30-bar sub-extreme, every interior swing clears it, and one shelf
// draws five boxes.
//
// v2 keeps the same detector and the same Kalman filter. What changed is what
// happens AFTER a range is found:
//   1. the left edge is backfilled to where the shelf actually started
//   2. rejected wicks widen the boundary instead of being ignored
//   3. a close outside is provisional — it must also travel, or it is absorbed
//      as a failed breakout and the boundary widens to the excursion
//   4. a broken range stays revivable: if price closes back inside it, the same
//      box resumes and the false break's label is deleted
//   5. the width ceiling scales with sqrt(bars), not a flat ATR multiple
//
// CC BY-NC-SA 4.0
// https://creativecommons.org/licenses/by-nc-sa/4.0/

indicator("Range Finder [Kalman] v2", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_bars_back = 600)

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
var string G_CORE = "Range Detection"
var string G_LIFE = "Range Lifecycle"
var string G_KAL  = "Kalman Filter"
var string G_BRK  = "Breakout"
var string G_STY  = "Style"

rangeLength      = input.int(30, "Detection Window", minval = 10, maxval = 150, group = G_CORE,
     tooltip = "Bars used to FIND a range. It no longer caps how long a range can live or how wide it can grow.")
rangeSensitivity = input.int(7, "Range Sensitivity", minval = 1, maxval = 10, group = G_CORE,
     tooltip = "Higher finds ranges sooner. Lower requires cleaner ranges.")
anchorLookback   = input.int(250, "Backfill Left Edge (bars)", minval = 0, maxval = 500, group = G_CORE,
     tooltip = "On seed, walk backwards while closes stay inside the range to find where the shelf actually began. 0 disables backfill.")

absorbWicks   = input.bool(true, "Absorb Rejected Wicks", group = G_LIFE,
     tooltip = "A wick outside the boundary that closes back inside moves the boundary to the rejection instead of being ignored.")
absorbFails   = input.bool(true, "Absorb Failed Breakouts", group = G_LIFE,
     tooltip = "A close outside that returns before the break confirms widens the range to the excursion. This is what keeps one shelf as one box.")
maxGrowth     = input.float(2.00, "Max Growth vs Seed Width", minval = 1.0, maxval = 5.0, step = 0.1, group = G_LIFE,
     tooltip = "A range may never grow past this multiple of the width it was seeded at.")
reviveOn      = input.bool(true, "Revive Range on Re-entry", group = G_LIFE)
reviveBars    = input.int(3, "Bars Inside to Revive", minval = 1, maxval = 20, group = G_LIFE)
reviveWindow  = input.int(80, "Revive Window (bars)", minval = 5, maxval = 300, group = G_LIFE)
escapeAtr     = input.float(1.75, "Escape to Retire (ATR)", minval = 0.25, maxval = 10.0, step = 0.25, group = G_LIFE,
     tooltip = "Once price has travelled this far past the broken boundary, the range is dead and can no longer be revived.")

useKalman      = input.bool(true, "Use Kalman Filter", group = G_KAL)
kalmanWeight   = input.float(0.40, "Kalman Influence", minval = 0.0, maxval = 1.0, step = 0.05, group = G_KAL)
showKalmanLine = input.bool(false, "Show Kalman Center", group = G_KAL)

breakDispAtr   = input.float(0.50, "Min Break Displacement (ATR)", minval = 0.0, maxval = 5.0, step = 0.05, group = G_BRK,
     tooltip = "A break must clear the boundary by this much. Closes that go nowhere are treated as failed breakouts.")
maxOutsideBars = input.int(6, "Force Break After N Bars Outside", minval = 1, maxval = 40, group = G_BRK,
     tooltip = "Backstop for a slow grind out that never produces displacement.")
cooldownBars   = input.int(5, "Bars Before New Range", minval = 0, maxval = 50, group = G_BRK)
showBreakLbls  = input.bool(true, "Show Breakout Labels", group = G_BRK)

showBoxes  = input.bool(true, "Show Range Boxes", group = G_STY)
showStats  = input.bool(true, "Show Rejection Count", group = G_STY)
boxTransp  = input.int(90, "Range Fill Transparency", minval = 0, maxval = 100, group = G_STY)
rangeColor = input.color(#787B86, "Range", group = G_STY)
bullColor  = input.color(#26A69A, "Bullish Breakout", group = G_STY)
bearColor  = input.color(#EF5350, "Bearish Breakout", group = G_STY)

// ─────────────────────────────────────────────────────────────────────────────
// Detection thresholds
// ─────────────────────────────────────────────────────────────────────────────
float s = float(rangeSensitivity)

float maxEfficiency = 0.14  + s * 0.032
float maxAtrRatio   = 0.80  + s * 0.050   // v1 used 0.70 + s*0.035 -> see note below
float minOverlap    = 0.68  - s * 0.038
float maxSlopeAtr   = 0.018 + s * 0.011
float maxDrift      = 0.30  + s * 0.035

// v1's width gate was a flat ATR multiple. A random walk's range over n bars is
// ~sqrt(n) * ATR, so any multi-bar width threshold has to scale with sqrt(n) or
// it silently means something different at every window length. widthK is v1's
// number re-expressed as a multiple of the random-walk expectation, so the seed
// gate is unchanged at defaults but the same constant now governs growth too.
float widthK = (3.50 + s * 0.55) / math.sqrt(rangeLength)

int   confirmBars     = rangeSensitivity >= 9 ? 2 : rangeSensitivity >= 6 ? 3 : rangeSensitivity >= 3 ? 4 : 5
float breakBufferAtr  = rangeSensitivity >= 9 ? 0.10 : rangeSensitivity >= 6 ? 0.15 : 0.20
int   breakConfirmBars = rangeSensitivity >= 8 ? 1 : 2

// ─────────────────────────────────────────────────────────────────────────────
// Measurements
// ─────────────────────────────────────────────────────────────────────────────
float atr         = ta.atr(14)
float atrSafe     = math.max(atr, syminfo.mintick)
float atrBaseline = ta.sma(atr, 50)
float atrRatio    = atr / math.max(nz(atrBaseline, atr), syminfo.mintick)

float rollingTop    = ta.highest(high, rangeLength)
float rollingBottom = ta.lowest(low, rangeLength)
float rollingWidth  = math.max(rollingTop - rollingBottom, syminfo.mintick)
float widthAtr      = rollingWidth / atrSafe

float path       = ta.sma(math.abs(close - close[1]), rangeLength) * rangeLength
float efficiency = math.abs(close - close[rangeLength]) / math.max(path, syminfo.mintick)

float lrNow      = ta.linreg(close, rangeLength, 0)
float lrPrev     = ta.linreg(close, rangeLength, 1)
float lrSlopeAtr = math.abs(lrNow - lrPrev) / atrSafe

float overlapAmount = math.max(0.0, math.min(high, high[1]) - math.max(low, low[1]))
float overlapBase   = math.max(math.min(high - low, high[1] - low[1]), syminfo.mintick)
float barOverlap    = math.min(1.0, overlapAmount / overlapBase)
float avgOverlap    = ta.sma(barOverlap, rangeLength)

float driftRatio      = math.abs(close - close[rangeLength]) / rollingWidth
float positionInRange = (close - rollingBottom) / rollingWidth

// v1 required 0.08..0.92. Right after any break price sits at an edge by
// construction, so that band blocked re-detection exactly when it was needed.
bool notPinnedToEdge = positionInRange > 0.03 and positionInRange < 0.97

// ─────────────────────────────────────────────────────────────────────────────
// Kalman level + velocity filter (unchanged from v1)
// ─────────────────────────────────────────────────────────────────────────────
float kalmanProcessLevelAtr    = 0.020 + s * 0.002
float kalmanProcessVelocityAtr = 0.004 + s * 0.0007
float kalmanMeasurementAtr     = 0.80

float qLevel    = math.pow(atrSafe * kalmanProcessLevelAtr, 2)
float qVelocity = math.pow(atrSafe * kalmanProcessVelocityAtr, 2)
float rMeasure  = math.pow(atrSafe * kalmanMeasurementAtr, 2)

var float kLevel    = na
var float kVelocity = 0.0
var float p00 = 1.0
var float p01 = 0.0
var float p10 = 0.0
var float p11 = 1.0

if na(kLevel)
    kLevel    := close
    kVelocity := 0.0
    p00 := rMeasure
    p01 := 0.0
    p10 := 0.0
    p11 := rMeasure
else
    float predLevel    = kLevel + kVelocity
    float predVelocity = kVelocity

    float pp00 = p00 + p01 + p10 + p11 + qLevel
    float pp01 = p01 + p11
    float pp10 = p10 + p11
    float pp11 = p11 + qVelocity

    float innovation         = close - predLevel
    float innovationVariance = math.max(pp00 + rMeasure, syminfo.mintick * syminfo.mintick)
    float gainLevel          = pp00 / innovationVariance
    float gainVelocity       = pp10 / innovationVariance

    kLevel    := predLevel + gainLevel * innovation
    kVelocity := predVelocity + gainVelocity * innovation

    p00 := (1.0 - gainLevel) * pp00
    p01 := (1.0 - gainLevel) * pp01
    p10 := pp10 - gainVelocity * pp00
    p11 := pp11 - gainVelocity * pp01

float kalmanSlopeAtr = math.abs(kVelocity) / atrSafe
float kalmanDriftRatio = not na(kLevel[rangeLength]) ? math.abs(kLevel - kLevel[rangeLength]) / rollingWidth : driftRatio

float slopeAtr     = useKalman ? lrSlopeAtr * (1.0 - kalmanWeight) + kalmanSlopeAtr * kalmanWeight : lrSlopeAtr
float blendedDrift = useKalman ? driftRatio * (1.0 - kalmanWeight) + kalmanDriftRatio * kalmanWeight : driftRatio

// ─────────────────────────────────────────────────────────────────────────────
// Range score
// ─────────────────────────────────────────────────────────────────────────────
bool efficiencyPass  = efficiency <= maxEfficiency
bool compressionPass = atrRatio   <= maxAtrRatio
bool widthPass       = widthAtr   <= widthK * math.sqrt(rangeLength)
bool overlapPass     = avgOverlap >= minOverlap
bool slopePass       = slopeAtr   <= maxSlopeAtr
bool driftPass       = blendedDrift <= maxDrift

int rangeScore =
     (efficiencyPass  ? 1 : 0) +
     (compressionPass ? 1 : 0) +
     (widthPass       ? 1 : 0) +
     (overlapPass     ? 1 : 0) +
     (slopePass       ? 1 : 0) +
     (driftPass       ? 1 : 0)

int  requiredScore  = rangeSensitivity >= 8 ? 4 : 5
bool rangeCandidate = rangeScore >= requiredScore and notPinnedToEdge and not na(close[rangeLength])

var int candidateStreak = 0
candidateStreak := rangeCandidate ? candidateStreak + 1 : 0
bool confirmedRangeCandidate = candidateStreak >= confirmBars

// ─────────────────────────────────────────────────────────────────────────────
// State
// ─────────────────────────────────────────────────────────────────────────────
var bool  inRange = false
var float rTop    = na
var float rBot    = na
var float rSeedW  = na
var int   rLeft   = na
var int   rejects = 0
var box   rBox    = na

// live breakout attempt
var int   outDir    = 0
var int   outStreak = 0
var float outExt    = na

// retired-but-revivable range ("ghost")
var bool  ghostAlive = false
var float gTop       = na
var float gBot       = na
var float gSeedW     = na
var int   gLeft      = na
var int   gBreakBar  = na
var int   gRejects   = 0
var bool  gUp        = false
var float gEscape    = na
var box   gBox       = na
var label gLabel     = na
var int   reentry    = 0

var int lastBreakBar = na

// ─────────────────────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────────────────────

// Width ceiling. Two caps: geometric (sqrt of elapsed bars) and relative to the
// width the range was seeded at, so absorption can never inflate a range without
// bound and can never turn a tight shelf into a trend channel.
f_widthCap(nBars) =>
    widthK * math.sqrt(math.max(nBars, rangeLength)) * atrSafe

f_fits(hiEdge, loEdge, nBars, seedW) =>
    float w = hiEdge - loEdge
    w > 0 and w <= f_widthCap(nBars) and (na(seedW) or w <= seedW * maxGrowth)

// Walk backwards from the seed bar while closes stay inside the seed envelope.
// Returns the real left edge plus the boundaries widened to the wicks found there.
f_backfill(top0, bot0, doIt) =>
    int   startBar = bar_index
    float top = top0
    float bot = bot0
    float tol = atrSafe * 0.25
    if doIt and anchorLookback >= 1
        bool stop = false
        for i = 1 to anchorLookback
            if not stop and i <= bar_index
                // A bar whose own displacement over the detection window was large
                // was passing THROUGH this band, not sitting in it. That is where
                // the shelf began; without this the walk eats the approach leg.
                if math.abs(close[i] - close[i + rangeLength]) > (top0 - bot0) * maxDrift
                    stop := true
                else if close[i] <= top0 + tol and close[i] >= bot0 - tol
                    startBar := bar_index - i
                    top := math.max(top, math.min(high[i], top0 + atrSafe))
                    bot := math.min(bot, math.max(low[i],  bot0 - atrSafe))
                else
                    stop := true
    // a range can never start before the previous one ended, and is never shorter
    // than the window its boundaries were measured over
    int floorBar = math.max(0, nz(lastBreakBar, -1) + 1)
    int windowBar = math.max(0, bar_index - rangeLength + 1)
    startBar := math.max(math.min(startBar, windowBar), floorBar)
    int   bars   = bar_index - startBar + 1
    float noSeed = na
    if not f_fits(top, bot, bars, noSeed)
        top      := top0
        bot      := bot0
        startBar := math.max(floorBar, windowBar)
    [startBar, top, bot]

// ─────────────────────────────────────────────────────────────────────────────
// Lifecycle
// ─────────────────────────────────────────────────────────────────────────────
bool rangeStarted = false
bool rangeResumed = false
bool brokeUp      = false
bool brokeDown    = false

float buf = atr * breakBufferAtr

// 1. Maintain the live range
if inRange
    int  rBars  = bar_index - rLeft + 1
    bool cAbove = close > rTop + buf
    bool cBelow = close < rBot - buf

    // Rejected probe: traded through the boundary, closed back inside it.
    // The close must be back inside the OLD boundary (not merely inside the
    // buffer) or the boundary ratchets up one buffer-width per bar during a
    // real breakout, and the break signal never fires.
    if absorbWicks and close < rTop and high > rTop and high - rTop <= atrSafe and f_fits(high, rBot, rBars, rSeedW)
        rTop := high
    if absorbWicks and close > rBot and low < rBot and rBot - low <= atrSafe and f_fits(rTop, low, rBars, rSeedW)
        rBot := low

    if cAbove
        if outDir == 1
            outStreak += 1
            outExt := math.max(outExt, high)
        else
            outDir    := 1
            outStreak := 1
            outExt    := high
    else if cBelow
        if outDir == -1
            outStreak += 1
            outExt := math.min(outExt, low)
        else
            outDir    := -1
            outStreak := 1
            outExt    := low
    else
        // closed back inside before the break confirmed -> failed breakout.
        // This is the case v1 had no representation for.
        if outDir != 0
            rejects += 1
            if absorbFails and outDir == 1 and f_fits(math.max(rTop, outExt), rBot, rBars, rSeedW)
                rTop := math.max(rTop, outExt)
            if absorbFails and outDir == -1 and f_fits(rTop, math.min(rBot, outExt), rBars, rSeedW)
                rBot := math.min(rBot, outExt)
        outDir    := 0
        outStreak := 0
        outExt    := na

    float disp = outDir == 1 ? (close - rTop) / atrSafe : outDir == -1 ? (rBot - close) / atrSafe : 0.0
    bool confirmed = outDir != 0 and ((outStreak >= breakConfirmBars and disp >= breakDispAtr) or outStreak >= maxOutsideBars)

    if confirmed
        brokeUp   := outDir == 1
        brokeDown := outDir == -1
        inRange   := false
        candidateStreak := 0
        lastBreakBar    := bar_index

        // hand the range to the ghost so a false break can still be undone
        gTop      := rTop
        gBot      := rBot
        gSeedW    := rSeedW
        gLeft     := rLeft
        gRejects  := rejects
        gBox      := rBox
        gUp       := brokeUp
        gBreakBar := bar_index
        gEscape   := brokeUp ? high : low
        ghostAlive := reviveOn

        rBox      := na
        gLabel    := na
        outDir    := 0
        outStreak := 0
        outExt    := na
        reentry   := 0

// 2. Age the ghost (never on the bar it was created)
if ghostAlive and not (brokeUp or brokeDown)
    if gUp
        gEscape := math.max(gEscape, high)
        if (gEscape - gTop) / atrSafe > escapeAtr
            ghostAlive := false
    else
        gEscape := math.min(gEscape, low)
        if (gBot - gEscape) / atrSafe > escapeAtr
            ghostAlive := false
    if bar_index - gBreakBar > reviveWindow
        ghostAlive := false
    if not ghostAlive
        gBox   := na   // drops the handle, leaves the finished box drawn
        gLabel := na

// 3. Re-entry streak
bool backInside = ghostAlive and not na(gTop) and close <= gTop and close >= gBot
reentry := backInside ? reentry + 1 : 0

// 4. Revive or seed
bool cooldownReady = na(lastBreakBar) or bar_index - lastBreakBar > cooldownBars
bool canStart      = not inRange and not (brokeUp or brokeDown)
bool wantRevive    = canStart and reviveOn and ghostAlive and reentry >= reviveBars
bool wantSeed      = canStart and not wantRevive and confirmedRangeCandidate and cooldownReady

// called every bar; the backwards walk only runs when wantSeed is true
[sb, st, sb2] = f_backfill(rollingTop, rollingBottom, wantSeed)

if wantRevive
    inRange := true
    rTop    := gTop
    rBot    := gBot
    rSeedW  := gSeedW
    rLeft   := gLeft
    rejects := gRejects + 1
    rBox    := gBox
    rangeResumed := true

    ghostAlive := false
    gBox       := na
    if not na(gLabel)
        label.delete(gLabel)
        gLabel := na

    candidateStreak := 0
    outDir    := 0
    outStreak := 0
    outExt    := na
else if wantSeed
    inRange := true
    rLeft   := sb
    rTop    := st
    rBot    := sb2
    rSeedW  := st - sb2
    rejects := 0
    rBox    := na
    rangeStarted := true
    outDir    := 0
    outStreak := 0
    outExt    := na

// ─────────────────────────────────────────────────────────────────────────────
// Drawing
// ─────────────────────────────────────────────────────────────────────────────
if showBoxes and inRange
    if na(rBox)
        rBox := box.new(rLeft, rTop, bar_index, rBot,
             xloc         = xloc.bar_index,
             bgcolor      = color.new(rangeColor, boxTransp),
             border_color = color.new(rangeColor, 15),
             border_style = line.style_solid,
             border_width = 1,
             text_size    = size.tiny,
             text_color   = color.new(rangeColor, 25),
             text_halign  = text.align_left,
             text_valign  = text.align_top)
    else
        box.set_left(rBox,   rLeft)
        box.set_right(rBox,  bar_index)
        box.set_top(rBox,    rTop)
        box.set_bottom(rBox, rBot)
    if rangeResumed
        box.set_bgcolor(rBox, color.new(rangeColor, boxTransp))
        box.set_border_color(rBox, color.new(rangeColor, 15))
    box.set_text(rBox, (showStats and rejects > 0) ? str.tostring(rejects) + " rejected" : "")

if (brokeUp or brokeDown) and not na(gBox)
    color bc = brokeUp ? bullColor : bearColor
    box.set_right(gBox, bar_index)
    box.set_border_color(gBox, bc)
    box.set_bgcolor(gBox, color.new(bc, 94))

if showBreakLbls and (brokeUp or brokeDown)
    gLabel := label.new(bar_index, brokeUp ? gTop : gBot,
         brokeUp ? "Bull break" : "Bear break",
         xloc      = xloc.bar_index,
         yloc      = yloc.price,
         style     = brokeUp ? label.style_label_up : label.style_label_down,
         color     = color.new(brokeUp ? bullColor : bearColor, 10),
         textcolor = color.white,
         size      = size.tiny)

// Box visibility never affects detection or breakout logic.
if not showBoxes and not na(rBox)
    box.delete(rBox)
    rBox := na

// ─────────────────────────────────────────────────────────────────────────────
// Diagnostics
// ─────────────────────────────────────────────────────────────────────────────
plot(showKalmanLine ? kLevel : na, "Kalman Center", linewidth = 1)
plot(lrSlopeAtr,     "LR Slope / ATR",          display = display.data_window)
plot(kalmanSlopeAtr, "Kalman Velocity / ATR",   display = display.data_window)
plot(slopeAtr,       "Combined Slope / ATR",    display = display.data_window)
plot(blendedDrift,   "Combined Drift Ratio",    display = display.data_window)
plot(float(rangeScore), "Range Score (0-6)",    display = display.data_window)
plot(inRange ? 1.0 : 0.0, "Range State",        display = display.data_window)
plot(inRange ? float(bar_index - rLeft + 1) : 0.0, "Range Age (bars)", display = display.data_window)
plot(inRange ? (rTop - rBot) / atrSafe : 0.0,      "Range Width (ATR)", display = display.data_window)
plot(inRange ? float(rejects) : 0.0, "Rejections",  display = display.data_window)
plot(float(outStreak), "Bars Outside",             display = display.data_window)
plot(ghostAlive ? 1.0 : 0.0, "Revivable",          display = display.data_window)
plot(brokeUp ? 1.0 : brokeDown ? -1.0 : 0.0, "Breakout Direction (+1/-1)", display = display.data_window)

alertcondition(rangeStarted, "Range Started",  "A new price range was detected")
alertcondition(rangeResumed, "Range Resumed",  "Price returned inside a broken range; the range was revived")
alertcondition(brokeUp,      "Bullish Range Breakout", "Price confirmed above the active range")
alertcondition(brokeDown,    "Bearish Range Breakout", "Price confirmed below the active range")
