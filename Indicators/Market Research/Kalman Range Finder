f_clamp01(x) =>
    math.max(0.0, math.min(1.0, x))

f_pipSize() =>
    float p = syminfo.mintick
    if syminfo.type == "forex"
        p := syminfo.mintick < 0.001 ? 0.0001 : syminfo.mintick < 0.1 ? 0.01 : syminfo.mintick
    p

f_avg_last(array<float> a, int count) =>
    int n = array.size(a)
    float sum = 0.0
    int used = 0
    if n > 0 and count > 0
        int start = math.max(0, n - count)
        for i = start to n - 1
            float v = array.get(a, i)
            if not na(v)
                sum += v
                used += 1
    used > 0 ? sum / float(used) : na

f_fits_ctx(float hiEdge, float loEdge, int nBars, float seedW, float atrSafe0) =>
    float w = hiEdge - loEdge
    float cap = widthK * math.sqrt(math.max(nBars, winLen)) * atrSafe0
    w > 0 and w <= cap and (na(seedW) or w <= seedW * MAX_GROWTH)

f_profile_arr(int leftIdx, int rightIdx, float topP, float botP, bool useVol) =>
    float pocP = na
    float vahP = na
    float valP = na
    float h = (topP - botP) / float(profileRows)
    int totalBars = rightIdx - leftIdx + 1
    int startIdx = math.max(leftIdx, rightIdx - PROFILE_MAX_BARS + 1)
    if h > 0 and totalBars > 0 and rightIdx >= startIdx and startIdx >= 0
        array<float> w = array.new_float(profileRows, 0.0)
        for k = startIdx to rightIdx
            float bh = math.min(array.get(sHighA, k), topP)
            float bl = math.max(array.get(sLowA, k), botP)
            if bh >= bl
                int i0 = math.max(0, math.min(profileRows - 1, int((bl - botP) / h)))
                int i1 = math.max(0, math.min(profileRows - 1, int((bh - botP) / h)))
                float rawUnit = useVol ? nz(array.get(sVolA, k), 0.0) : 1.0
                float unit = rawUnit / float(i1 - i0 + 1)
                for r = i0 to i1
                    array.set(w, r, array.get(w, r) + unit)
        float total = array.sum(w)
        if total > 0
            int poc = array.indexof(w, array.max(w))
            int up = poc
            int dn = poc
            float acc = array.get(w, poc)
            float target = total * valueAreaPct / 100.0
            while acc < target and (up < profileRows - 1 or dn > 0)
                float a = up < profileRows - 1 ? array.get(w, up + 1) : -1.0
                float b = dn > 0 ? array.get(w, dn - 1) : -1.0
                if a >= b
                    up += 1
                    acc += a
                else
                    dn -= 1
                    acc += b
            pocP := botP + (float(poc) + 0.5) * h
            vahP := botP + float(up + 1) * h
            valP := botP + float(dn) * h
    [pocP, vahP, valP]

f_levelTests_arr(float level, int leftIdx, int rightIdx, float tol, int dir, int kind, int currentIdx) =>
    int tests = 0
    int lastAgo = 1000000
    bool touching = false
    int startIdx = math.max(leftIdx, rightIdx - PROFILE_MAX_BARS + 1)
    if not na(level) and rightIdx >= startIdx and startIdx >= 0
        for k = startIdx to rightIdx
            float hk = array.get(sHighA, k)
            float lk = array.get(sLowA, k)
            float ck = array.get(sCloseA, k)
            bool overlap = lk <= level + tol and hk >= level - tol
            bool edgeRoleReject = dir == 1 ? ck <= level : ck >= level
            bool futureRoleReject = dir == 1 ? ck >= level : ck <= level
            bool tested = overlap and (kind == 0 ? edgeRoleReject : futureRoleReject)
            if tested and not touching
                tests += 1
                lastAgo := currentIdx - k
            touching := tested
    [tests, lastAgo]

f_histEstimate(int idx) =>
    float n = array.get(pbHistEvents, idx)
    float reached = array.get(pbHistReached, idx)
    float reacted = array.get(pbHistReacted, idx)
    float pSuccess = (reacted + 1.0) / (n + 2.0)
    float pReach = (reached + 1.0) / (n + 2.0)
    float pReactionGivenReach = (reacted + 1.0) / (reached + 2.0)
    [pSuccess, pReach, pReactionGivenReach, n]

f_candidateScore_arr(int kind, bool valid, float level, float edgeLevel, float roundLevel, float vaLevel,
     float pocLevel0, float halfW, int dir, int leftIdx, int rightIdx, int currentIdx,
     float breakoutQuality, float currentClose, float atrSafe0) =>
    float score = -1.0
    int tests = 0
    int lastAgo = 1000000
    int confluenceCount = 0
    if valid
        [tests0, lastAgo0] = f_levelTests_arr(level, leftIdx, rightIdx, halfW, dir, kind, currentIdx)
        tests := tests0
        lastAgo := lastAgo0
        float touchStrength = math.min(float(tests), 4.0) / 4.0
        float recency = lastAgo < 1000000 ? math.exp(-float(lastAgo) / math.max(float(winLen), 1.0)) : 0.0
        float distanceAtr = math.abs(currentClose - level) / atrSafe0
        float horizonScale = math.max(0.75, math.sqrt(float(pullbackHorizon)) / 3.0)
        float reachability = math.exp(-distanceAtr / horizonScale)
        float mergeDist = halfW * 1.50
        confluenceCount += not na(edgeLevel) and kind != 0 and math.abs(level - edgeLevel) <= mergeDist ? 1 : 0
        confluenceCount += not na(roundLevel) and kind != 1 and math.abs(level - roundLevel) <= mergeDist ? 1 : 0
        confluenceCount += not na(vaLevel) and kind != 2 and math.abs(level - vaLevel) <= mergeDist ? 1 : 0
        confluenceCount += not na(pocLevel0) and kind != 3 and math.abs(level - pocLevel0) <= mergeDist ? 1 : 0
        float confluence = math.min(float(confluenceCount), 2.0) / 2.0
        bool roundNear = false
        if useForexRoundNumbers and syminfo.type == "forex" and not na(roundLevel)
            float pip = f_pipSize()
            roundNear := math.abs(level - roundLevel) <= math.max(halfW, pip * 5.0)
        float base = kind == 0 ? 0.56 : kind == 1 ? 0.50 : kind == 2 ? 0.47 : 0.42
        float qualityTilt = kind == 0 ? 0.08 * breakoutQuality : kind == 1 ? 0.04 : kind == 2 ? 0.05 * (1.0 - breakoutQuality) : 0.08 * (1.0 - breakoutQuality)
        score := base + 0.08 * touchStrength + 0.06 * recency + 0.06 * (roundNear ? 1.0 : 0.0) +
             0.06 * confluence + 0.10 * (reachability - 0.50) + qualityTilt
        score := math.max(0.05, math.min(0.95, score))
    [score, tests]

f_blendScore(float structureScore, int histIdx) =>
    [histSuccess, histReach, histHold, histN] = f_histEstimate(histIdx)
    float sampleRamp = math.min(1.0, histN / math.max(float(pullbackMinSamples), 1.0))
    float histWeight = pullbackHistoryWeight / 100.0 * sampleRamp
    float blended = structureScore < 0 ? -1.0 : structureScore * (1.0 - histWeight) + histSuccess * histWeight
    [blended, histSuccess, histReach, histHold, histN]

f_candidateName(int kind) =>
    kind == 0 ? "Broken edge / SR flip" : kind == 1 ? "Forex round number" : kind == 2 ? "Value-area edge" : "Range POC"

f_pullbackText(int dir, string candidateName, string confluence, float zBot, float zTop, float rank,
     float observedRate, float observedReach, float observedHold, float observedN, string status) =>
    bool historyReady = observedN >= pullbackMinSamples
    string observedText = "History: learning (n=" + str.tostring(int(observedN)) + ")"
    if historyReady
        observedText := "HTF history: success " + str.tostring(observedRate * 100.0, "#.0") +
             "% | reach " + str.tostring(observedReach * 100.0, "#.0") +
             "% | reaction/reach " + str.tostring(observedHold * 100.0, "#.0") +
             "% (n=" + str.tostring(int(observedN)) + ")"
    (dir == 1 ? "Demand / Support pullback" : "Supply / Resistance pullback") +
         "\nHTF: " + structureTf + " | " + candidateName + confluence +
         "\nZone: " + str.tostring(zBot, format.mintick) + " - " + str.tostring(zTop, format.mintick) +
         "\nRelative rank: " + str.tostring(rank * 100.0, "#.0") + "/100" +
         "\n" + observedText + "\nStatus: " + status

f_entryText(float invalidLevel, string status, float score, bool reclaim, bool displacement,
     bool microBreak, int weakCloses, float microLevel) =>
    string scoreText = na(score) ? "n/a" : str.tostring(score, "#.0") + "/100"
    "\nChart " + timeframe.period + " Entry: " + status +
         "\nReaction score: " + scoreText +
         " | reclaim " + (reclaim ? "Y" : "N") +
         " | displacement " + (displacement ? "Y" : "N") +
         " | micro break " + (microBreak ? "Y" : "N") +
         "\nWeak closes: " + str.tostring(weakCloses) +
         (na(microLevel) ? "" : " | micro: " + str.tostring(microLevel, format.mintick)) +
         "\nHard invalidation: " + str.tostring(invalidLevel, format.mintick)

