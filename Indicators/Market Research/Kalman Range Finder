//@version=6
// Range Finder [Kalman] v6 — Horizontal-Gated Single Range
//
// v6 is a logic redesign of the detection layer, not a threshold tweak.
//
// THREE PROBLEMS v5.3 HAD
//
// 1. New ranges were built out of the old range.
//    rollingTop/rollingBottom are ta.highest/ta.lowest over winLen bars. After a
//    break, that window still straddled the old range AND the impulse leg for
//    winLen bars. The 3-bar cooldown expired long before the window was clean, so
//    the "new" range inherited the old boundaries and the breakout candle's spike,
//    and then immediately broke again. That is the doubled bear break in shot 1.
//
// 2. Horizontality was optional.
//    The old score was 6 fungible votes needing 4. A structure could FAIL slope,
//    FAIL drift and FAIL efficiency, pass width + overlap + atr ratio, and still be
//    accepted. So raising Sensitivity did not find more horizontal ranges — it
//    found more diagonal ones. That is every false box in shot 2.
//
// 3. Nothing tested shelf SHAPE.
//    Every measurement was an aggregate over the whole window. A rising staircase
//    leg and a true shelf can have identical width, overlap and ATR ratio. What
//    separates them is WHERE price spent its time, and no test looked at that.
//
// WHAT v6 DOES
//
//   A. CLEAN WINDOW. A new range cannot be seeded until the entire detection
//      window sits after the last break. Cooldown is now winLen bars, not 3.
//      Candidate evaluation itself is suppressed while the window is dirty, so a
//      contaminated bar cannot even build confirmation streak.
//
//   B. TWO-TIER ACCEPTANCE. Criteria are split by what they mean:
//        MANDATORY (all four must pass — these define "horizontal"):
//          slope, net drift, split-half overlap, two-sided occupancy
//        VOTES (N of four — these describe "clean/quiet"):
//          efficiency, ATR ratio, width, bar-to-bar overlap
//      Sensitivity widens the mandatory thresholds and lowers the vote count.
//      It can never let a structure skip a mandatory gate. Up = more horizontal
//      ranges, not more sloped ones.
//
//   C. SHELF GEOMETRY. Two new tests do the actual discrimination:
//        Split-Half Overlap — the older half and recent half of the window must
//        occupy the SAME price band. A staircase leg fails hard; a shelf scores
//        0.8-1.0.
//        Two-Sided Occupancy — price must visit BOTH the top edge and the bottom
//        edge in BOTH halves of the window. A leg touches one edge early and the
//        other edge late and fails. A shelf fills all four quadrants.
//
//   D. FEWER SETTINGS. Absorb Rejected Probes, Breakout Escape Cap and Show
//      Adaptation Moves are gone — folded into constants at their good values.
//      Range Detection is two knobs plus the resize toggle, and the two knobs are
//      now orthogonal: Size sets the time scale, Sensitivity sets the tolerance.
//
// Kalman filter, probe/confirmation split, wick absorption, escape logic,
// profile, outputs and drawing style are unchanged from v5.3.
//
// CC BY-NC-SA 4.0
// https://creativecommons.org/licenses/by-nc-sa/4.0/

indicator("Range Finder [Kalman] v6 - Horizontal Range", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500, max_bars_back = 750)

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
var string G_CORE = "Range Detection"
var string G_BRK  = "Breakout"
var string G_PROF = "Value Area Profile"
var string G_STY  = "Style"

rangeSize        = input.int(5, "Range Size", minval = 1, maxval = 10, group = G_CORE,
     tooltip = "TIME SCALE ONLY. How many bars of structure must qualify. 1 is ~6 bars, 5 is ~20, 10 is ~93. This knob does not affect how strict detection is - larger windows are naturally harder to keep horizontal, which is the correct behaviour.")
rangeSensitivity = input.int(7, "Range Sensitivity", minval = 1, maxval = 10, group = G_CORE,
     tooltip = "TOLERANCE ONLY. How much slope, drift and shape distortion a horizontal range may carry. Raising this loosens the horizontality thresholds - it never lets a sloped structure skip them. Raise it if true shelves are being missed; lower it if boxes appear on trending legs.")

adaptiveResize = input.bool(true, "Auto Resize To Latest Shelf", group = G_CORE,
     tooltip = "While a range is live, move that SAME box to the latest confirmed nested shelf. The shelf must be at least 15% tighter than the current range and must pass the full horizontality gate, so the box no longer creeps inward on trending structure.")

escapePct    = input.float(15.0, "Breakout Escape (% of range)", minval = 2.0, maxval = 60.0, step = 1.0, group = G_BRK,
     tooltip = "How far past the boundary a close must travel to confirm a break, as a share of range height.")
showTriggers = input.bool(true, "Show Trigger Levels", group = G_BRK,
     tooltip = "Draws the exact prices a break confirms at, on every bar the range is live.")
showProbes   = input.bool(true, "Show Probe Markers", group = G_BRK,
     tooltip = "Triangle on the first close outside the range. Fast trigger, not a confirmed verdict.")

profileBasis   = input.string("Time (TPO)", "Profile Basis", options = ["Off", "Time (TPO)", "Volume"], group = G_PROF,
     tooltip = "Time counts bars per price level and works everywhere. Volume is only meaningful where volume is real.")
profileRows    = input.int(24, "Profile Rows", minval = 6, maxval = 100, group = G_PROF)
valueAreaPct   = input.float(70.0, "Value Area %", minval = 30.0, maxval = 95.0, step = 5.0, group = G_PROF)

showBoxes       = input.bool(true, "Show Range Boxes", group = G_STY)
showBreakLabels = input.bool(true, "Show Breakout Labels", group = G_STY)
boxTransp       = input.int(90, "Range Fill Transparency", minval = 0, maxval = 100, group = G_STY)
rangeColor      = input.color(#787B86, "Range", group = G_STY)
profileColor    = input.color(#F2B705, "POC / Value Area", group = G_STY)
bullColor       = input.color(#26A69A, "Bullish Breakout", group = G_STY)
bearColor       = input.color(#EF5350, "Bearish Breakout", group = G_STY)

// ─────────────────────────────────────────────────────────────────────────────
// Constants  (former inputs folded in at their good values)
// ─────────────────────────────────────────────────────────────────────────────
float MAX_GROWTH       = 2.00
float WICK_ABSORB_ATR  = 1.00
float BACKFILL_TOL_ATR = 0.25
int   MIN_PROBE_BARS   = 2
float KALMAN_WEIGHT    = 0.40
int   PROFILE_MAX_BARS = 500
float ESCAPE_CAP_ATR   = 1.50   // was an input; off-default was never useful
bool  ABSORB_PROBES    = true   // was an input; off made ranges break constantly
float EDGE_ZONE_FRAC   = 0.22   // top/bottom band width for occupancy counting
float SHELF_TIGHTEN    = 0.85   // a resize target must be this much tighter

// ─────────────────────────────────────────────────────────────────────────────
// Scale — Range Size maps to window length only.
//   1=6, 2=8, 3=11, 4=15, 5=20, 6=28, 7=37, 8=51, 9=69, 10=93
// ─────────────────────────────────────────────────────────────────────────────
float z        = float(rangeSize)
float scalePos = (z - 1.0) / 9.0
int   winLen   = int(math.round(6.0 * math.pow(93.0 / 6.0, scalePos)))
int   halfLen  = winLen >= 4 ? winLen / 2 : 2

int   anchorLookback = math.min(500, winLen * 8)
int   confirmWindow  = math.max(6, int(math.round(winLen * 0.33)))
float escapeFrac     = escapePct / 100.0

// ─────────────────────────────────────────────────────────────────────────────
// Tolerances — Range Sensitivity only.
//
// Split by role. The mandatory group defines horizontality and is never skipped.
// The vote group describes consolidation quality and is partially skippable.
// ─────────────────────────────────────────────────────────────────────────────
float s = float(rangeSensitivity)

// mandatory horizontality tolerances
float maxSlopeAtr     = 0.012 + s * 0.0075   //  1: 0.020   7: 0.065   10: 0.087
float maxDrift        = 0.200 + s * 0.0280   //  1: 0.228   7: 0.396   10: 0.480
float minHalfOverlap  = 0.800 - s * 0.0320   //  1: 0.768   7: 0.576   10: 0.480
int   quadrantsNeeded = rangeSensitivity >= 9 ? 3 : 4

// vote tolerances
float maxEfficiency = 0.12 + s * 0.030
float maxAtrRatio   = 0.80 + s * 0.050
float minOverlap    = 0.70 - s * 0.036
float widthK        = 1.375
int   votesNeeded   = rangeSensitivity >= 8 ? 2 : rangeSensitivity >= 5 ? 3 : 4

int   confirmBars    = rangeSensitivity >= 9 ? 2 : rangeSensitivity >= 6 ? 3 : rangeSensitivity >= 3 ? 4 : 5
float breakBufferAtr = rangeSensitivity >= 9 ? 0.10 : rangeSensitivity >= 6 ? 0.15 : 0.20

// ─────────────────────────────────────────────────────────────────────────────
// Measurements
// ─────────────────────────────────────────────────────────────────────────────
float atr         = ta.atr(14)
float atrSafe     = math.max(atr, syminfo.mintick)
float atrBaseline = ta.sma(atr, 50)
float atrRatio    = atr / math.max(nz(atrBaseline, atr), syminfo.mintick)

float rollingTop    = ta.highest(high, winLen)
float rollingBottom = ta.lowest(low, winLen)
float rollingWidth  = math.max(rollingTop - rollingBottom, syminfo.mintick)
float widthAtr      = rollingWidth / atrSafe

float path       = ta.sma(math.abs(close - close[1]), winLen) * winLen
float efficiency = math.abs(close - close[winLen]) / math.max(path, syminfo.mintick)

float lrNow      = ta.linreg(close, winLen, 0)
float lrPrev     = ta.linreg(close, winLen, 1)
float lrSlopeAtr = math.abs(lrNow - lrPrev) / atrSafe

float overlapAmount = math.max(0.0, math.min(high, high[1]) - math.max(low, low[1]))
float overlapBase   = math.max(math.min(high - low, high[1] - low[1]), syminfo.mintick)
float barOverlap    = math.min(1.0, overlapAmount / overlapBase)
float avgOverlap    = ta.sma(barOverlap, winLen)

float driftRatio      = math.abs(close - close[winLen]) / rollingWidth
float positionInRange = (close - rollingBottom) / rollingWidth
bool  notPinnedToEdge = positionInRange > 0.05 and positionInRange < 0.95

// ─────────────────────────────────────────────────────────────────────────────
// SHELF GEOMETRY  (new in v6)
//
// Test 1 — Split-Half Overlap.
// Take the older half and the recent half of the window as two independent
// price bands. A true shelf revisits the same band in both halves, so the bands
// nearly coincide. A staircase leg moves its band upward, so the intersection
// shrinks while the union grows. This is the single cleanest separator between
// the false boxes and the real one in the second screenshot.
// ─────────────────────────────────────────────────────────────────────────────
float topRecent = ta.highest(high, halfLen)
float botRecent = ta.lowest(low,  halfLen)
float topOlder  = ta.highest(high[halfLen], halfLen)
float botOlder  = ta.lowest(low[halfLen],   halfLen)

float unionTop = math.max(topRecent, topOlder)
float unionBot = math.min(botRecent, botOlder)
float interTop = math.min(topRecent, topOlder)
float interBot = math.max(botRecent, botOlder)
float halfOverlap = math.max(0.0, interTop - interBot) / math.max(unionTop - unionBot, syminfo.mintick)

// ─────────────────────────────────────────────────────────────────────────────
// Test 2 — Two-Sided Occupancy.
// Divide the window into four quadrants: {top edge, bottom edge} x {older half,
// recent half}. A range rotates between its boundaries and fills all four. A
// trending leg fills only the diagonal pair - bottom-older and top-recent for an
// uptrend - which is exactly the signature of the false boxes.
// ─────────────────────────────────────────────────────────────────────────────
float edgeZone = rollingWidth * EDGE_ZONE_FRAC

int qTopRecent = 0
int qTopOlder  = 0
int qBotRecent = 0
int qBotOlder  = 0

if bar_index > winLen
    for i = 0 to winLen - 1
        bool isRecent = i < halfLen
        if high[i] >= rollingTop - edgeZone
            if isRecent
                qTopRecent := qTopRecent + 1
            else
                qTopOlder := qTopOlder + 1
        if low[i] <= rollingBottom + edgeZone
            if isRecent
                qBotRecent := qBotRecent + 1
            else
                qBotOlder := qBotOlder + 1

int quadrantsFilled =
     (qTopRecent > 0 ? 1 : 0) + (qTopOlder > 0 ? 1 : 0) +
     (qBotRecent > 0 ? 1 : 0) + (qBotOlder > 0 ? 1 : 0)

// ─────────────────────────────────────────────────────────────────────────────
// Kalman level + velocity filter
// ─────────────────────────────────────────────────────────────────────────────
float qLevel    = math.pow(atrSafe * (0.020 + s * 0.002), 2)
float qVelocity = math.pow(atrSafe * (0.004 + s * 0.0007), 2)
float rMeasure  = math.pow(atrSafe * 0.80, 2)

var float kLevel    = na
var float kVelocity = 0.0
var float p00 = 1.0
var float p01 = 0.0
var float p10 = 0.0
var float p11 = 1.0

if na(kLevel)
    kLevel    := close
    kVelocity := 0.0
    p00 := rMeasure
    p01 := 0.0
    p10 := 0.0
    p11 := rMeasure
else
    float predLevel    = kLevel + kVelocity
    float predVelocity = kVelocity

    float pp00 = p00 + p01 + p10 + p11 + qLevel
    float pp01 = p01 + p11
    float pp10 = p10 + p11
    float pp11 = p11 + qVelocity

    float innovation         = close - predLevel
    float innovationVariance = math.max(pp00 + rMeasure, syminfo.mintick * syminfo.mintick)
    float gainLevel          = pp00 / innovationVariance
    float gainVelocity       = pp10 / innovationVariance

    kLevel    := predLevel + gainLevel * innovation
    kVelocity := predVelocity + gainVelocity * innovation

    p00 := (1.0 - gainLevel) * pp00
    p01 := (1.0 - gainLevel) * pp01
    p10 := pp10 - gainVelocity * pp00
    p11 := pp11 - gainVelocity * pp01

float kalmanSlopeAtr   = math.abs(kVelocity) / atrSafe
float kalmanDriftRatio = not na(kLevel[winLen]) ? math.abs(kLevel - kLevel[winLen]) / rollingWidth : driftRatio

float slopeAtr     = lrSlopeAtr * (1.0 - KALMAN_WEIGHT) + kalmanSlopeAtr * KALMAN_WEIGHT
float blendedDrift = driftRatio * (1.0 - KALMAN_WEIGHT) + kalmanDriftRatio * KALMAN_WEIGHT

// ─────────────────────────────────────────────────────────────────────────────
// State  (declared before acceptance so the clean-window rule can see it)
// ─────────────────────────────────────────────────────────────────────────────
var bool  inRange = false
var float rTop    = na
var float rBot    = na
var float rSeedW  = na
var int   rLeft   = na
var int   rRight  = na
var int   rejects = 0
var box   rBox    = na

var int   probeDir  = 0
var int   probeBars = 0
var float probeExt  = na

var int   lastBreakBar  = na
var int   lastResizeBar = na
var float breakLevel    = na

var line  pocLine  = na
var line  vahLine  = na
var line  valLine  = na
var float pocValue = na
var float vahValue = na
var float valValue = na

// ─────────────────────────────────────────────────────────────────────────────
// CLEAN WINDOW  (new in v6)
//
// Every detection measurement above is an aggregate over the last winLen bars.
// While any of those bars predate the last break, the measurements describe the
// OLD range plus the impulse that killed it. v5.3 waited 3 bars, which is not
// enough for any Range Size, and then read that contaminated window as if it
// were new structure - producing a box built from the old boundaries and the
// breakout spike, which broke again immediately.
//
// The window must now be entirely post-break before a candidate can even be
// evaluated. Suppressing evaluation (rather than just seeding) also stops the
// confirmation streak from being banked on dirty bars.
// ─────────────────────────────────────────────────────────────────────────────
int  barsSinceBreak = na(lastBreakBar) ? 1000000 : bar_index - lastBreakBar
bool cleanWindow    = barsSinceBreak >= winLen

// ─────────────────────────────────────────────────────────────────────────────
// Acceptance — mandatory gates, then quality votes
// ─────────────────────────────────────────────────────────────────────────────
bool gateSlope     = slopeAtr     <= maxSlopeAtr
bool gateDrift     = blendedDrift <= maxDrift
bool gateShape     = halfOverlap  >= minHalfOverlap
bool gateOccupancy = quadrantsFilled >= quadrantsNeeded

bool horizontalOk = gateSlope and gateDrift and gateShape and gateOccupancy

int qualityVotes =
     (efficiency <= maxEfficiency              ? 1 : 0) +
     (atrRatio   <= maxAtrRatio                ? 1 : 0) +
     (widthAtr   <= widthK * math.sqrt(winLen) ? 1 : 0) +
     (avgOverlap >= minOverlap                 ? 1 : 0)

bool rangeCandidate = horizontalOk and qualityVotes >= votesNeeded and
     notPinnedToEdge and cleanWindow and not na(close[winLen])

var int candidateStreak = 0
candidateStreak := rangeCandidate ? candidateStreak + 1 : 0
bool confirmedRangeCandidate = candidateStreak >= confirmBars

// ─────────────────────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────────────────────
f_widthCap(nBars) =>
    widthK * math.sqrt(math.max(nBars, winLen)) * atrSafe

f_fits(hiEdge, loEdge, nBars, seedW) =>
    float w = hiEdge - loEdge
    w > 0 and w <= f_widthCap(nBars) and (na(seedW) or w <= seedW * MAX_GROWTH)

f_backfill(top0, bot0, doIt) =>
    int   startBar = bar_index
    float top = top0
    float bot = bot0
    float tol = atrSafe * BACKFILL_TOL_ATR
    if doIt
        bool stop = false
        for i = 1 to anchorLookback
            if not stop and i <= bar_index
                if math.abs(close[i] - close[i + winLen]) > (top0 - bot0) * maxDrift
                    stop := true
                else if close[i] <= top0 + tol and close[i] >= bot0 - tol
                    startBar := bar_index - i
                    top := math.max(top, math.min(high[i], top0 + atrSafe))
                    bot := math.min(bot, math.max(low[i],  bot0 - atrSafe))
                else
                    stop := true
    // hard floor: a range may never reach back across the last break
    int   floorBar  = math.max(0, nz(lastBreakBar, -1) + 1)
    int   windowBar = math.max(0, bar_index - winLen + 1)
    startBar := math.max(math.min(startBar, windowBar), floorBar)
    int   bars   = bar_index - startBar + 1
    float noSeed = na
    if not f_fits(top, bot, bars, noSeed)
        top      := top0
        bot      := bot0
        startBar := math.max(floorBar, windowBar)
    [startBar, top, bot]

f_profile(backFrom, backTo, topP, botP, rows, vaFrac, useVol, doIt) =>
    float pocP = na
    float vahP = na
    float valP = na
    float h    = (topP - botP) / rows
    int   hi   = math.min(backTo, PROFILE_MAX_BARS)
    if doIt and h > 0 and hi >= backFrom and backFrom >= 0
        array<float> w = array.new_float(rows, 0.0)
        for k = backFrom to hi
            float bh = math.min(high[k], topP)
            float bl = math.max(low[k],  botP)
            if bh >= bl
                int i0 = math.max(0, math.min(rows - 1, int((bl - botP) / h)))
                int i1 = math.max(0, math.min(rows - 1, int((bh - botP) / h)))
                float unit = (useVol ? nz(volume[k], 0.0) : 1.0) / float(i1 - i0 + 1)
                for r = i0 to i1
                    array.set(w, r, array.get(w, r) + unit)
        float total = array.sum(w)
        if total > 0
            int   poc    = array.indexof(w, array.max(w))
            int   up     = poc
            int   dn     = poc
            float acc    = array.get(w, poc)
            float target = total * vaFrac
            while acc < target and (up < rows - 1 or dn > 0)
                float a = up < rows - 1 ? array.get(w, up + 1) : -1.0
                float b = dn > 0        ? array.get(w, dn - 1) : -1.0
                if a >= b
                    up  += 1
                    acc += a
                else
                    dn  -= 1
                    acc += b
            pocP := botP + (poc + 0.5) * h
            vahP := botP + (up + 1) * h
            valP := botP + dn * h
    [pocP, vahP, valP]

// ─────────────────────────────────────────────────────────────────────────────
// Lifecycle
// ─────────────────────────────────────────────────────────────────────────────
bool rangeStarted   = false
bool rangeRefocused = false
bool brokeUp        = false
bool brokeDown      = false
bool probeOpened    = false
int  probeOpenDir   = 0

float buf = atr * breakBufferAtr

if inRange
    int  rBars  = bar_index - rLeft + 1
    bool cAbove = close > rTop + buf
    bool cBelow = close < rBot - buf

    if ABSORB_PROBES and close < rTop and high > rTop and high - rTop <= atrSafe * WICK_ABSORB_ATR and f_fits(high, rBot, rBars, rSeedW)
        rTop := high
    if ABSORB_PROBES and close > rBot and low < rBot and rBot - low <= atrSafe * WICK_ABSORB_ATR and f_fits(rTop, low, rBars, rSeedW)
        rBot := low

    if cAbove or cBelow
        int d = cAbove ? 1 : -1
        if probeDir == d
            probeBars += 1
            probeExt  := d == 1 ? math.max(probeExt, high) : math.min(probeExt, low)
        else
            probeDir  := d
            probeBars := 1
            probeExt  := d == 1 ? high : low
            probeOpened  := true
            probeOpenDir := d

        float span      = math.max(rTop - rBot, syminfo.mintick)
        float dist      = d == 1 ? close - rTop : rBot - close
        bool  escapeHit = dist / span >= escapeFrac or dist / atrSafe >= ESCAPE_CAP_ATR

        if (probeBars >= MIN_PROBE_BARS and escapeHit) or probeBars >= confirmWindow
            brokeUp      := d == 1
            brokeDown    := d == -1
            breakLevel   := d == 1 ? rTop : rBot
            inRange      := false
            lastBreakBar := bar_index
            candidateStreak := 0
            probeDir  := 0
            probeBars := 0
            probeExt  := na
    else
        if probeDir != 0
            rejects += 1
            if ABSORB_PROBES and probeDir == 1 and f_fits(math.max(rTop, probeExt), rBot, rBars, rSeedW)
                rTop := math.max(rTop, probeExt)
            if ABSORB_PROBES and probeDir == -1 and f_fits(rTop, math.min(rBot, probeExt), rBars, rSeedW)
                rBot := math.min(rBot, probeExt)
            probeDir  := 0
            probeBars := 0
            probeExt  := na
        rRight := bar_index

// ─────────────────────────────────────────────────────────────────────────────
// Adaptive resize to the latest shelf
//
// One live range only - the existing box moves, nothing is duplicated.
// v6 adds two conditions the old version lacked:
//   - the target shelf must be materially tighter (SHELF_TIGHTEN), so the box
//     stops creeping inward one tick at a time on drifting structure
//   - resizes are spaced by confirmWindow bars
// Because the resize reuses confirmedRangeCandidate, it now also inherits the
// full horizontality gate - a sloped shelf can no longer capture the box.
// ─────────────────────────────────────────────────────────────────────────────
bool latestShelfInside = inRange and
     rollingTop <= rTop and rollingBottom >= rBot and
     (rollingTop < rTop or rollingBottom > rBot)

bool shelfTighter = inRange and rollingWidth <= math.max(rTop - rBot, syminfo.mintick) * SHELF_TIGHTEN
bool resizeCooled = na(lastResizeBar) or bar_index - lastResizeBar >= confirmWindow

bool canRefocus = adaptiveResize and inRange and probeDir == 0 and
     confirmedRangeCandidate and latestShelfInside and shelfTighter and resizeCooled and
     (bar_index - rLeft + 1) >= winLen

if canRefocus
    if not na(pocLine)
        line.delete(pocLine)
        pocLine := na
    if not na(vahLine)
        line.delete(vahLine)
        vahLine := na
    if not na(valLine)
        line.delete(valLine)
        valLine := na

    pocValue := na
    vahValue := na
    valValue := na

    int floorBar = math.max(0, nz(lastBreakBar, -1) + 1)

    rLeft   := math.max(floorBar, bar_index - winLen + 1)
    rTop    := rollingTop
    rBot    := rollingBottom
    rRight  := bar_index
    rSeedW  := rollingWidth
    rejects := 0

    lastResizeBar := bar_index

    probeDir  := 0
    probeBars := 0
    probeExt  := na

    candidateStreak := 0
    rangeRefocused := true

// ─────────────────────────────────────────────────────────────────────────────
// Seeding
// ─────────────────────────────────────────────────────────────────────────────
bool wantSeed = not inRange and not (brokeUp or brokeDown) and confirmedRangeCandidate

[sb, st, sb2] = f_backfill(rollingTop, rollingBottom, wantSeed)

if wantSeed
    inRange := true
    rLeft   := sb
    rTop    := st
    rBot    := sb2
    rRight  := bar_index
    rSeedW  := st - sb2
    rejects := 0
    rBox    := na
    pocLine := na
    vahLine := na
    valLine := na
    pocValue := na
    vahValue := na
    valValue := na
    rangeStarted := true
    probeDir  := 0
    probeBars := 0
    probeExt  := na

    lastResizeBar   := na
    candidateStreak := 0

// ─────────────────────────────────────────────────────────────────────────────
// Profile
// ─────────────────────────────────────────────────────────────────────────────
bool profileOn  = profileBasis != "Off"
bool profileDue = (inRange and barstate.islast) or brokeUp or brokeDown
bool doProfile  = profileOn and not na(rTop) and not na(rLeft) and profileDue

[pocP, vahP, valP] = f_profile(math.max(0, bar_index - rRight), math.max(0, bar_index - rLeft),
     rTop, rBot, profileRows, valueAreaPct / 100.0, profileBasis == "Volume", doProfile)

if doProfile and not na(pocP)
    pocValue := pocP
    vahValue := vahP
    valValue := valP
    if na(pocLine)
        pocLine := line.new(rLeft, pocP, rRight, pocP, xloc = xloc.bar_index,
             color = profileColor, width = 2)
        vahLine := line.new(rLeft, vahP, rRight, vahP, xloc = xloc.bar_index,
             color = color.new(profileColor, 40), width = 1, style = line.style_dotted)
        valLine := line.new(rLeft, valP, rRight, valP, xloc = xloc.bar_index,
             color = color.new(profileColor, 40), width = 1, style = line.style_dotted)
    else
        line.set_xy1(pocLine, rLeft, pocP)
        line.set_xy2(pocLine, rRight, pocP)
        line.set_xy1(vahLine, rLeft, vahP)
        line.set_xy2(vahLine, rRight, vahP)
        line.set_xy1(valLine, rLeft, valP)
        line.set_xy2(valLine, rRight, valP)

// ─────────────────────────────────────────────────────────────────────────────
// Drawing
// ─────────────────────────────────────────────────────────────────────────────
if showBoxes and inRange
    if na(rBox)
        rBox := box.new(rLeft, rTop, rRight, rBot,
             xloc         = xloc.bar_index,
             bgcolor      = color.new(rangeColor, boxTransp),
             border_color = color.new(rangeColor, 15),
             border_style = line.style_solid,
             border_width = 1)
    else
        box.set_left(rBox,   rLeft)
        box.set_right(rBox,  rRight)
        box.set_top(rBox,    rTop)
        box.set_bottom(rBox, rBot)

if brokeUp or brokeDown
    if not na(rBox)
        color bc = brokeUp ? bullColor : bearColor
        box.set_right(rBox, rRight)
        box.set_border_color(rBox, bc)
        box.set_bgcolor(rBox, color.new(bc, 94))
        rBox := na
    pocLine := na
    vahLine := na
    valLine := na

if showBreakLabels and (brokeUp or brokeDown)
    label.new(bar_index, breakLevel,
         brokeUp ? "Bull break" : "Bear break",
         xloc      = xloc.bar_index,
         yloc      = yloc.price,
         style     = brokeUp ? label.style_label_up : label.style_label_down,
         color     = color.new(brokeUp ? bullColor : bearColor, 10),
         textcolor = color.white,
         size      = size.tiny)

if not showBoxes and not na(rBox)
    box.delete(rBox)
    rBox := na

// ─────────────────────────────────────────────────────────────────────────────
// Entry aids
// ─────────────────────────────────────────────────────────────────────────────
float breakUpLevel   = inRange ? rTop + buf : na
float breakDownLevel = inRange ? rBot - buf : na

plot(showTriggers ? breakUpLevel : na,   "Break Up Level",
     color = color.new(bullColor, 25), style = plot.style_linebr, linewidth = 1)
plot(showTriggers ? breakDownLevel : na, "Break Down Level",
     color = color.new(bearColor, 25), style = plot.style_linebr, linewidth = 1)

plotshape(showProbes and probeOpened and probeOpenDir ==  1, "Probe Up",
     style = shape.triangleup,   location = location.abovebar,
     color = color.new(bullColor, 30), size = size.tiny)
plotshape(showProbes and probeOpened and probeOpenDir == -1, "Probe Down",
     style = shape.triangledown, location = location.belowbar,
     color = color.new(bearColor, 30), size = size.tiny)

// ─────────────────────────────────────────────────────────────────────────────
// Strategy outputs and tuning diagnostics
//
// The gate readouts are the tuning surface. Open the Data Window on a structure
// that was wrongly accepted or wrongly rejected and read which gate decided it,
// then move Range Sensitivity in that direction. This is why every gate is
// exposed individually rather than as one opaque score.
// ─────────────────────────────────────────────────────────────────────────────
plot(brokeUp ? 1.0 : brokeDown ? -1.0 : 0.0, "Breakout Signal (+1/-1)", display = display.data_window)
plot(probeOpened ? float(probeOpenDir) : 0.0, "Probe Signal (+1/-1)", display = display.data_window)
plot(breakUpLevel,   "Break Up Level (value)",   display = display.data_window)
plot(breakDownLevel, "Break Down Level (value)", display = display.data_window)
plot(breakLevel,          "Last Break Level", display = display.data_window)
plot(inRange ? rTop : na, "Range Top",        display = display.data_window)
plot(inRange ? rBot : na, "Range Bottom",     display = display.data_window)
plot(pocValue,            "POC",              display = display.data_window)
plot(vahValue,            "VAH",              display = display.data_window)
plot(valValue,            "VAL",              display = display.data_window)
plot(inRange ? 1.0 : 0.0, "In Range",         display = display.data_window)
plot(float(winLen),       "Detection Window", display = display.data_window)
plot(float(probeBars),    "Bars Outside",     display = display.data_window)
plot(float(rejects),      "Rejected Probes",  display = display.data_window)

// clean-window diagnostics
plot(cleanWindow ? 1.0 : 0.0,   "Gate: Clean Window",  display = display.data_window)
plot(float(barsSinceBreak),     "Bars Since Break",    display = display.data_window)

// mandatory horizontality gates
plot(gateSlope     ? 1.0 : 0.0, "Gate: Slope",         display = display.data_window)
plot(gateDrift     ? 1.0 : 0.0, "Gate: Drift",         display = display.data_window)
plot(gateShape     ? 1.0 : 0.0, "Gate: Half Overlap",  display = display.data_window)
plot(gateOccupancy ? 1.0 : 0.0, "Gate: Occupancy",     display = display.data_window)
plot(horizontalOk  ? 1.0 : 0.0, "Gate: Horizontal ALL",display = display.data_window)

// raw gate measurements
plot(slopeAtr,                  "Slope (ATR/bar)",     display = display.data_window)
plot(blendedDrift,              "Net Drift",           display = display.data_window)
plot(halfOverlap,               "Half Overlap (0-1)",  display = display.data_window)
plot(float(quadrantsFilled),    "Quadrants Filled",    display = display.data_window)

// quality votes
plot(float(qualityVotes),       "Quality Votes (0-4)", display = display.data_window)
plot(float(votesNeeded),        "Votes Needed",        display = display.data_window)
plot(efficiency,                "Efficiency",          display = display.data_window)
plot(avgOverlap,                "Bar Overlap",         display = display.data_window)
plot(widthAtr,                  "Width (ATR)",         display = display.data_window)

plot(inRange ? float(bar_index - rLeft + 1) : 0.0, "Range Age (bars)",  display = display.data_window)
plot(inRange ? (rTop - rBot) / atrSafe : 0.0,      "Range Width (ATR)", display = display.data_window)
plot(rangeRefocused ? 1.0 : 0.0, "Range Auto-Resized", display = display.data_window)

alertcondition(rangeStarted, "Range Started", "A new price range was detected")
alertcondition(rangeRefocused, "Range Auto-Resized", "The active range resized to the latest confirmed nested shelf")
alertcondition(probeOpened and probeOpenDir ==  1, "Probe Up (fast)",   "Price closed above the range - fast trigger, not yet confirmed")
alertcondition(probeOpened and probeOpenDir == -1, "Probe Down (fast)", "Price closed below the range - fast trigger, not yet confirmed")
alertcondition(brokeUp,      "Bullish Range Breakout", "Price confirmed above the range")
alertcondition(brokeDown,    "Bearish Range Breakout", "Price confirmed below the range")
