//@version=6
// Range Finder [Kalman] v5.13 - Lux Core + LTF Trigger Level
//
// Purpose:
//   Detect a selectable confirmed-HTF range using Lux-style close containment and
//   mean +/- ATR boundaries, keep our trend guards and breakout engine,
//   and warn early on the chart timeframe when price forcefully escapes the range.
//
// v5.12-v5.13 detector architecture:
//   1) Lux-style core: current mean of the range window + confirmed HTF ATR(500).
//      Recent closes are tested against that one current mean and ATR envelope.
//   2) Range Sensitivity mainly changes the envelope width; the default stays very
//      close to LuxAlgo's 1.0 ATR width.
//   3) Our efficiency/slope/drift measures are now secondary trend guards, not six
//      equal votes deciding whether a range exists.
//   4) The Lux band caps the visible range while confirmed price extremes set its
//      actual size, so the SAME box can expand, contract or shift as balance evolves.
//   5) Adaptation tracers are restored and show old boundary -> new boundary moves.
//   6) Rejected-probe absorption is user-selectable again.
//   7) v5.13 replaces the fuzzy LTF distance/sensitivity gate with one visible
//      breakout trigger level: HTF edge +/- a user-set % of HTF range height.
//      The arrow only prints when LTF price actually crosses that trigger.
//
// Containment concept derived from Range Detector [LuxAlgo], (c) LuxAlgo,
// licensed CC BY-NC-SA 4.0. This implementation is rewritten for confirmed MTF
// processing and combined with the existing Kalman/adaptive/breakout logic.
//
// CC BY-NC-SA 4.0
// https://creativecommons.org/licenses/by-nc-sa/4.0/
indicator("Range Finder [Kalman] v5.13 - Lux Core Trigger", overlay = true,
     max_boxes_count = 500, max_labels_count = 100, max_lines_count = 500, max_bars_back = 750)

// -----------------------------------------------------------------------------
// Inputs
// -----------------------------------------------------------------------------
var string G_MTF   = "Multi-Timeframe"
var string G_CORE  = "Lux-Core Range Detection"
var string G_ADAPT = "Range Adaptability"
var string G_BRK   = "HTF Breakout"
var string G_EARLY = "LTF Early HTF Break"
var string G_STY   = "Style"

structureTf = input.timeframe("60", "Structure Timeframe", group = G_MTF,
     tooltip = "The timeframe that creates the range. Example: set 60 for 1H while viewing a 5m chart. Only confirmed structure candles are processed.")
showTfBadge = input.bool(true, "Show MTF Status Badge", group = G_MTF)

rangeSize = input.int(5, "Range Size", minval = 1, maxval = 10, group = G_CORE,
     tooltip = "Approximate confirmed structure bars tested around one current mean: 1~6, 5~20, 10~93.")
rangeSensitivity = input.int(7, "Range Sensitivity", minval = 1, maxval = 10, group = G_CORE,
     tooltip = "Higher widens the Lux-style ATR envelope and relaxes the trend guard. Default 7 is approximately a 1.0 x ATR(500) containment band.")

adaptiveRange = input.bool(true, "Adaptive Range Size", group = G_ADAPT,
     tooltip = "Allows the same active HTF box to expand, contract or shift when a newly confirmed Lux-style balance overlaps the current range.")
showAdaptationTrace = input.bool(true, "Show Adaptation Traces", group = G_ADAPT,
     tooltip = "Draws short old-boundary -> new-boundary connectors whenever the active HTF range changes size or position.")
absorbProbes = input.bool(true, "Absorb Rejected Probes", group = G_BRK,
     tooltip = "If price probes beyond a boundary and rejects back into the range, allow the boundary to absorb that rejected extreme. Turn OFF for stricter fixed edges.")

// Confirmed-HTF breakout behavior is intentionally hard-coded.
int luxAtrLen = 500
float probeAbsorbAtr = 1.00
float adaptiveProbeMaxGrowth = 1.80
float adaptiveMinPriceOverlap = 0.50
float adaptiveMaxCenterShiftAtr = 0.90
float escapePct = 15.0
float escapeCapAtr = 1.50
bool showTriggers = false
bool showProbes = false

useEarlyBreak = input.bool(true, "Show Early Break Arrow", group = G_EARLY)
earlyBreakTiming = input.string("Closed LTF bar", "Signal Timing", options = ["Closed LTF bar", "Live LTF bar"], group = G_EARLY,
     tooltip = "Closed requires an LTF candle close through the trigger level. Live can warn as realtime price crosses it, but the arrow can disappear if price rejects before close.")
ltfBreakLevelPct = input.float(5.0, "LTF Break Level (% of HTF Range)", minval = 0.5, maxval = 20.0, step = 0.5, group = G_EARLY,
     tooltip = "The only main LTF breakout-distance setting. Example: 5 means the trigger sits 5% of the HTF range height beyond the top/bottom edge. The arrow cannot print until price crosses that level.")

// Secondary LTF candle-quality checks are intentionally hard-coded. The visible
// trigger level is the main decision rule; these only reject extremely weak drifts.
float earlyBodyAtrTarget = 0.45
float earlyRangeAtrTarget = 0.75
bool earlyRequireDirectionalBody = true

showBoxes = input.bool(true, "Show HTF Range Boxes", group = G_STY)
boxTransp = input.int(90, "Range Fill Transparency", minval = 0, maxval = 100, group = G_STY)
rangeColor = input.color(#787B86, "Active Range", group = G_STY)
bullColor = input.color(#26A69A, "Bullish Break", group = G_STY)
bearColor = input.color(#EF5350, "Bearish Break", group = G_STY)

// -----------------------------------------------------------------------------
// Scale / thresholds
// -----------------------------------------------------------------------------
float z = float(rangeSize)
float scalePos = (z - 1.0) / 9.0
int winLen = int(math.round(6.0 * math.pow(93.0 / 6.0, scalePos)))
int confirmBars = rangeSensitivity >= 7 ? 1 : rangeSensitivity >= 4 ? 2 : 3
int confirmWindow = math.max(6, int(math.round(winLen * 0.33)))
float s = float(rangeSensitivity)

// LuxAlgo's original default is mean +/- 1.0 ATR. Sensitivity 7 maps to 1.01,
// intentionally staying almost exactly on that default while preserving one knob.
float luxBandMult = math.max(0.82, math.min(1.12, 0.80 + 0.03 * s))
// Stay very close to Lux's count == 0 rule. Only the two highest sensitivities
// allow one close outside the current mean/ATR envelope.
int luxAllowedOutside = rangeSensitivity >= 9 ? 1 : 0

// Our old metrics are now generous trend guards rather than equal range votes.
float maxEfficiency = 0.14 + s * 0.032
float maxSlopeAtr = 0.018 + s * 0.011
float maxDrift = 0.30 + s * 0.035
int minTrendGuards = rangeSensitivity >= 6 ? 2 : 3
float breakBufferAtr = rangeSensitivity >= 9 ? 0.10 : rangeSensitivity >= 6 ? 0.15 : 0.20
float escapeFrac = escapePct / 100.0

// LTF breakout distance is now explicit and visible rather than hidden behind
// a sensitivity mapping. All other LTF thresholds remain fixed.

// -----------------------------------------------------------------------------
// Confirmed selectable-HTF feed
// -----------------------------------------------------------------------------
float chartTfSeconds = timeframe.in_seconds(timeframe.period)
float structureTfSeconds = timeframe.in_seconds(structureTf)
bool structureTfValid = not na(chartTfSeconds) and not na(structureTfSeconds) and structureTfSeconds >= chartTfSeconds
if not structureTfValid
    runtime.error("Structure Timeframe must be equal to or higher than the TradingView chart timeframe.")

[sReqO, sReqH, sReqL, sReqC, sReqV, sReqTime, sReqCloseTime, sReqLuxAtr] = request.security(
     syminfo.tickerid, structureTf,
     [open[1], high[1], low[1], close[1], volume[1], time[1], time_close[1], ta.atr(luxAtrLen)[1]],
     lookahead = barmerge.lookahead_on)

var int lastProcessedStructTime = na
bool newStructData = not na(sReqTime) and (na(lastProcessedStructTime) or sReqTime != lastProcessedStructTime)

// -----------------------------------------------------------------------------
// Confirmed HTF storage
// -----------------------------------------------------------------------------
var array<float> sOpenA = array.new_float()
var array<float> sHighA = array.new_float()
var array<float> sLowA = array.new_float()
var array<float> sCloseA = array.new_float()
var array<int> sTimeA = array.new_int()
var array<int> sCloseTimeA = array.new_int()
var array<float> sTrA = array.new_float()
var array<float> sAtrA = array.new_float()
var array<float> sKalmanA = array.new_float()

// -----------------------------------------------------------------------------
// Helpers
// -----------------------------------------------------------------------------
f_clamp01(float x) =>
    math.max(0.0, math.min(1.0, x))

f_avg_last(array<float> a, int count) =>
    int n = array.size(a)
    int start = math.max(0, n - count)
    float sum = 0.0
    int used = 0
    if n > 0
        for i = start to n - 1
            float v = array.get(a, i)
            if not na(v)
                sum += v
                used += 1
    used > 0 ? sum / float(used) : na

f_overlap_ratio(float topA, float botA, float topB, float botB) =>
    float inter = math.max(0.0, math.min(topA, topB) - math.max(botA, botB))
    float base = math.max(math.min(topA - botA, topB - botB), syminfo.mintick)
    math.min(1.0, inter / base)

// -----------------------------------------------------------------------------
// Structure state
// -----------------------------------------------------------------------------
var bool sInRange = false
var float sTop = na
var float sBot = na
var float sSeedW = na
var float sAnchorCenter = na
var int sLeftIdx = na
var int sRightIdx = na
var int sRejects = 0
var int sProbeDir = 0
var int sProbeBars = 0
var float sProbeExt = na
var int sLastBreakIdx = na
var float sBreakLevel = na
var int sCandidateStreak = 0

// Kalman state advances once per confirmed HTF candle.
var float sKLevel = na
var float sKVelocity = 0.0
var float sP00 = 1.0
var float sP01 = 0.0
var float sP10 = 0.0
var float sP11 = 1.0

// Latest diagnostics.
var float sAtrSafe = na
var float sSlowAtr = na
var float sContainment = na
var int sLuxOutsideCount = 0
var float sLuxBandHalfWidth = na
var float sHybridQuality = na
var float sRangeCenter = na
var float sEfficiency = na
var float sSlopeAtr = na
var float sDrift = na
var float sOverlap = na
var float sWidthSlowAtr = na
var float sBreakUpLevel = na
var float sBreakDownLevel = na

bool rangeStarted = false
bool rangeAdapted = false
bool brokeUp = false
bool brokeDown = false
bool probeOpened = false
int probeOpenDir = 0
int structureEventCloseTime = na

// Drawings.
var box rBox = na

// -----------------------------------------------------------------------------
// Process one newly confirmed HTF candle
// -----------------------------------------------------------------------------
if newStructData
    lastProcessedStructTime := sReqTime
    array.push(sOpenA, sReqO)
    array.push(sHighA, sReqH)
    array.push(sLowA, sReqL)
    array.push(sCloseA, sReqC)
    array.push(sTimeA, sReqTime)
    array.push(sCloseTimeA, sReqCloseTime)
    int si = array.size(sCloseA) - 1
    structureEventCloseTime := sReqCloseTime

    float o0 = sReqO
    float h0 = sReqH
    float l0 = sReqL
    float c0 = sReqC
    float prevC = si > 0 ? array.get(sCloseA, si - 1) : c0
    float tr0 = math.max(h0 - l0, math.max(math.abs(h0 - prevC), math.abs(l0 - prevC)))
    array.push(sTrA, tr0)

    // Wilder ATR(14) for breakout/probe scaling.
    float atr0 = na
    if array.size(sTrA) >= 14
        float prevAtr = array.size(sAtrA) > 0 ? array.get(sAtrA, array.size(sAtrA) - 1) : na
        atr0 := na(prevAtr) ? f_avg_last(sTrA, 14) : (prevAtr * 13.0 + tr0) / 14.0
    array.push(sAtrA, atr0)
    float atrSafe0 = math.max(nz(atr0, math.max(h0 - l0, syminfo.mintick)), syminfo.mintick)
    sAtrSafe := atrSafe0

    // Exact Lux-style long ATR baseline from the confirmed structure timeframe.
    // This is Wilder ATR(500), matching ta.atr(500) rather than a simple TR mean.
    float slowAtr0 = na(sReqLuxAtr) ? na : math.max(sReqLuxAtr, syminfo.mintick)
    sSlowAtr := slowAtr0

    bool enoughHistory = si >= winLen - 1 and not na(sReqLuxAtr)
    int rollStart = math.max(0, si - winLen + 1)
    float rollingTop0 = -1e20
    float rollingBot0 = 1e20
    float closeSum0 = 0.0
    for k = rollStart to si
        rollingTop0 := math.max(rollingTop0, array.get(sHighA, k))
        rollingBot0 := math.min(rollingBot0, array.get(sLowA, k))
        closeSum0 += array.get(sCloseA, k)
    int rollCount = si - rollStart + 1

    // Same center concept as LuxAlgo's ta.sma(close, length): ONE current mean is
    // used to judge every close in the lookback window.
    float center0 = closeSum0 / math.max(float(rollCount), 1.0)
    float rollingWidth0 = math.max(rollingTop0 - rollingBot0, syminfo.mintick)
    float widthSlowAtr0 = enoughHistory ? rollingWidth0 / slowAtr0 : na
    float containHalf0 = enoughHistory ? slowAtr0 * luxBandMult : na
    float luxTop0 = enoughHistory ? center0 + containHalf0 : na
    float luxBot0 = enoughHistory ? center0 - containHalf0 : na
    float luxWidth0 = enoughHistory ? math.max(luxTop0 - luxBot0, syminfo.mintick) : na
    // Preserve our adaptability: use confirmed real extremes when they are tighter,
    // but cap them at the Lux envelope so one old wick does not define the whole box.
    // Rejected-probe absorption can deliberately extend beyond this cap later.
    float targetTop0 = enoughHistory ? math.min(rollingTop0, luxTop0) : na
    float targetBot0 = enoughHistory ? math.max(rollingBot0, luxBot0) : na
    float targetWidth0 = enoughHistory ? math.max(targetTop0 - targetBot0, syminfo.mintick) : na

    int outsideCount0 = 0
    int containedCount0 = 0
    if enoughHistory
        for k = rollStart to si
            float ck0 = array.get(sCloseA, k)
            bool inside0 = math.abs(ck0 - center0) <= containHalf0
            containedCount0 += inside0 ? 1 : 0
            outsideCount0 += inside0 ? 0 : 1
    float containment0 = enoughHistory ? float(containedCount0) / float(winLen) : 0.0
    bool luxContainmentPass0 = enoughHistory and outsideCount0 <= luxAllowedOutside

    // Path efficiency remains useful as a trend veto.
    float path0 = 0.0
    float overlapSum0 = 0.0
    if enoughHistory
        for k = rollStart + 1 to si
            float ck = array.get(sCloseA, k)
            float cp = array.get(sCloseA, k - 1)
            path0 += math.abs(ck - cp)
            float hk = array.get(sHighA, k)
            float lk = array.get(sLowA, k)
            float hp = array.get(sHighA, k - 1)
            float lp = array.get(sLowA, k - 1)
            float inter = math.max(0.0, math.min(hk, hp) - math.max(lk, lp))
            float base = math.max(math.min(hk - lk, hp - lp), syminfo.mintick)
            overlapSum0 += math.min(1.0, inter / base)
    float oldClose0 = enoughHistory ? array.get(sCloseA, rollStart) : c0
    float efficiency0 = enoughHistory ? math.abs(c0 - oldClose0) / math.max(path0, syminfo.mintick) : 1.0
    float avgOverlap0 = enoughHistory and winLen > 1 ? overlapSum0 / float(winLen - 1) : 0.0

    // OLS slope across the same confirmed HTF window.
    float lrSlope0 = 0.0
    if enoughHistory
        float n = float(winLen)
        float sumX = n * (n - 1.0) * 0.5
        float sumXX = (n - 1.0) * n * (2.0 * n - 1.0) / 6.0
        float sumY = 0.0
        float sumXY = 0.0
        for j = 0 to winLen - 1
            float y = array.get(sCloseA, rollStart + j)
            sumY += y
            sumXY += float(j) * y
        float denom = n * sumXX - sumX * sumX
        lrSlope0 := denom != 0 ? (n * sumXY - sumX * sumY) / denom : 0.0
    float lrSlopeAtr0 = math.abs(lrSlope0) / atrSafe0
    float driftRatio0 = enoughHistory ? math.abs(c0 - oldClose0) / rollingWidth0 : 1.0

    // Existing Kalman level/velocity supplies a second view of directional drift.
    float qLevel0 = math.pow(atrSafe0 * (0.020 + s * 0.002), 2)
    float qVelocity0 = math.pow(atrSafe0 * (0.004 + s * 0.0007), 2)
    float rMeasure0 = math.pow(atrSafe0 * 0.80, 2)
    if na(sKLevel)
        sKLevel := c0
        sKVelocity := 0.0
        sP00 := rMeasure0
        sP01 := 0.0
        sP10 := 0.0
        sP11 := rMeasure0
    else
        float predLevel = sKLevel + sKVelocity
        float pp00 = sP00 + sP01 + sP10 + sP11 + qLevel0
        float pp01 = sP01 + sP11
        float pp10 = sP10 + sP11
        float pp11 = sP11 + qVelocity0
        float innovation = c0 - predLevel
        float innovationVariance = math.max(pp00 + rMeasure0, syminfo.mintick * syminfo.mintick)
        float gainLevel = pp00 / innovationVariance
        float gainVelocity = pp10 / innovationVariance
        sKLevel := predLevel + gainLevel * innovation
        sKVelocity := sKVelocity + gainVelocity * innovation
        sP00 := (1.0 - gainLevel) * pp00
        sP01 := (1.0 - gainLevel) * pp01
        sP10 := pp10 - gainVelocity * pp00
        sP11 := pp11 - gainVelocity * pp01
    array.push(sKalmanA, sKLevel)
    float kalmanSlopeAtr0 = math.abs(sKVelocity) / atrSafe0
    float oldKalman0 = array.size(sKalmanA) > winLen ? array.get(sKalmanA, array.size(sKalmanA) - 1 - winLen) : na
    float kalmanDrift0 = not na(oldKalman0) ? math.abs(sKLevel - oldKalman0) / rollingWidth0 : driftRatio0
    float slopeAtr0 = lrSlopeAtr0 * 0.60 + kalmanSlopeAtr0 * 0.40
    float blendedDrift0 = driftRatio0 * 0.60 + kalmanDrift0 * 0.40

    // Lux containment now decides whether balance exists. Our measurements only
    // veto obvious directional movement. Two of three guards are enough at normal
    // sensitivities, preserving adaptability without reverting to six equal votes.
    bool efficiencyPass0 = efficiency0 <= maxEfficiency
    bool slopePass0 = slopeAtr0 <= maxSlopeAtr
    bool driftPass0 = blendedDrift0 <= maxDrift
    int trendPassCount0 = (efficiencyPass0 ? 1 : 0) + (slopePass0 ? 1 : 0) + (driftPass0 ? 1 : 0)
    bool trendGuardPass0 = trendPassCount0 >= minTrendGuards

    float luxQuality0 = enoughHistory ? f_clamp01(1.0 - float(outsideCount0) / float(winLen)) : 0.0
    float efficiencyQ = f_clamp01(1.0 - efficiency0 / math.max(maxEfficiency, 0.01))
    float slopeQ = f_clamp01(1.0 - slopeAtr0 / math.max(maxSlopeAtr, 0.001))
    float driftQ = f_clamp01(1.0 - blendedDrift0 / math.max(maxDrift, 0.01))
    float trendQuality0 = (efficiencyQ + slopeQ + driftQ) / 3.0
    float hybridQuality0 = 0.70 * luxQuality0 + 0.30 * trendQuality0

    bool hybridCandidate0 = enoughHistory and luxContainmentPass0 and trendGuardPass0
    sCandidateStreak := hybridCandidate0 ? sCandidateStreak + 1 : 0
    bool confirmedCandidate0 = sCandidateStreak >= confirmBars

    // Save diagnostics.
    sContainment := containment0 * 100.0
    sLuxOutsideCount := outsideCount0
    sLuxBandHalfWidth := containHalf0
    sHybridQuality := hybridQuality0 * 100.0
    sRangeCenter := center0
    sEfficiency := efficiency0
    sSlopeAtr := slopeAtr0
    sDrift := blendedDrift0
    sOverlap := avgOverlap0
    sWidthSlowAtr := widthSlowAtr0

    // -------------------------------------------------------------------------
    // Existing range lifecycle / breakout confirmation.
    // -------------------------------------------------------------------------
    float buf0 = atrSafe0 * breakBufferAtr
    if sInRange
        float traceOldTop0 = sTop
        float traceOldBot0 = sBot
        int rBars0 = si - sLeftIdx + 1
        bool absorbedThisBar0 = false
        bool cAbove0 = c0 > sTop + buf0
        bool cBelow0 = c0 < sBot - buf0

        // Bounded rejected-probe absorption. This expands only; it never shrinks.
        if absorbProbes and c0 < sTop and h0 > sTop and h0 - sTop <= atrSafe0 * probeAbsorbAtr
            float proposedTop = h0
            float proposedW = proposedTop - sBot
            if proposedW <= sSeedW * adaptiveProbeMaxGrowth
                sTop := proposedTop
                absorbedThisBar0 := true
                rangeAdapted := true
        if absorbProbes and c0 > sBot and l0 < sBot and sBot - l0 <= atrSafe0 * probeAbsorbAtr
            float proposedBot = l0
            float proposedW = sTop - proposedBot
            if proposedW <= sSeedW * adaptiveProbeMaxGrowth
                sBot := proposedBot
                absorbedThisBar0 := true
                rangeAdapted := true

        if cAbove0 or cBelow0
            int d = cAbove0 ? 1 : -1
            if sProbeDir == d
                sProbeBars += 1
                sProbeExt := d == 1 ? math.max(sProbeExt, h0) : math.min(sProbeExt, l0)
            else
                sProbeDir := d
                sProbeBars := 1
                sProbeExt := d == 1 ? h0 : l0
                probeOpened := true
                probeOpenDir := d
            float span0 = math.max(sTop - sBot, syminfo.mintick)
            float dist0 = d == 1 ? c0 - sTop : sBot - c0
            bool escapeHit0 = dist0 / span0 >= escapeFrac or (escapeCapAtr > 0 and dist0 / atrSafe0 >= escapeCapAtr)
            bool breakoutReady0 = (sProbeBars >= 2 and escapeHit0) or sProbeBars >= confirmWindow
            if breakoutReady0
                brokeUp := d == 1
                brokeDown := d == -1
                sBreakLevel := d == 1 ? sTop : sBot
                sInRange := false
                sLastBreakIdx := si
                sCandidateStreak := 0
                sProbeDir := 0
                sProbeBars := 0
                sProbeExt := na
        else
            if sProbeDir != 0
                sRejects += 1
                // If the outside attempt fully rejected, optionally absorb its wick.
                if absorbProbes and sProbeDir == 1 and not na(sProbeExt)
                    float proposedTop2 = math.max(sTop, sProbeExt)
                    if proposedTop2 - sBot <= sSeedW * adaptiveProbeMaxGrowth and proposedTop2 > sTop
                        sTop := proposedTop2
                        absorbedThisBar0 := true
                        rangeAdapted := true
                if absorbProbes and sProbeDir == -1 and not na(sProbeExt)
                    float proposedBot2 = math.min(sBot, sProbeExt)
                    if sTop - proposedBot2 <= sSeedW * adaptiveProbeMaxGrowth and proposedBot2 < sBot
                        sBot := proposedBot2
                        absorbedThisBar0 := true
                        rangeAdapted := true
                sProbeDir := 0
                sProbeBars := 0
                sProbeExt := na
            sRightIdx := si

        // Restored adaptive refocus: real confirmed extremes determine the latest
        // box size, but the Lux envelope caps those extremes. This can EXPAND, CONTRACT
        // or SHIFT, while rejected-probe absorption can intentionally extend farther.
        if adaptiveRange and not absorbedThisBar0 and not (brokeUp or brokeDown) and confirmedCandidate0
            float overlap0 = f_overlap_ratio(sTop, sBot, targetTop0, targetBot0)
            float currentCenter0 = (sTop + sBot) * 0.50
            float centerShift0 = math.abs(center0 - currentCenter0) / slowAtr0
            bool sameBalance0 = overlap0 >= adaptiveMinPriceOverlap and centerShift0 <= adaptiveMaxCenterShiftAtr
            bool changed0 = math.abs(targetTop0 - sTop) > syminfo.mintick or math.abs(targetBot0 - sBot) > syminfo.mintick
            if sameBalance0 and changed0
                sTop := targetTop0
                sBot := targetBot0
                sLeftIdx := rollStart
                sRightIdx := si
                sSeedW := targetWidth0
                sAnchorCenter := center0
                sCandidateStreak := 0
                rangeAdapted := true

        // One tracer pair per confirmed HTF update, after all absorption/refocus logic.
        // This captures both expansion and contraction without drawing duplicate lines.
        if rangeAdapted and showAdaptationTrace and sInRange
            int prevCloseTime0 = si > 0 ? array.get(sCloseTimeA, si - 1) : sReqTime
            if sTop != traceOldTop0
                line.new(prevCloseTime0, traceOldTop0, sReqCloseTime, sTop, xloc = xloc.bar_time, extend = extend.none, color = rangeColor, width = 2)
            if sBot != traceOldBot0
                line.new(prevCloseTime0, traceOldBot0, sReqCloseTime, sBot, xloc = xloc.bar_time, extend = extend.none, color = rangeColor, width = 2)

    // Start a new range only after the Lux-core detector has persisted.
    bool cooldownReady0 = na(sLastBreakIdx) or si - sLastBreakIdx > 3
    bool wantSeed0 = not sInRange and not (brokeUp or brokeDown) and confirmedCandidate0 and cooldownReady0
    if wantSeed0
        sInRange := true
        sLeftIdx := rollStart
        sRightIdx := si
        sTop := targetTop0
        sBot := targetBot0
        sSeedW := targetWidth0
        sAnchorCenter := center0
        sRejects := 0
        sProbeDir := 0
        sProbeBars := 0
        sProbeExt := na
        sCandidateStreak := 0
        rangeStarted := true

    sBreakUpLevel := sInRange ? sTop + atrSafe0 * breakBufferAtr : na
    sBreakDownLevel := sInRange ? sBot - atrSafe0 * breakBufferAtr : na

// -----------------------------------------------------------------------------
// HTF range drawing on any lower chart timeframe
// -----------------------------------------------------------------------------
if showBoxes and sInRange and not na(sLeftIdx)
    int leftTime0 = array.get(sTimeA, sLeftIdx)
    int rightTime0 = time_close
    if na(rBox)
        rBox := box.new(leftTime0, sTop, rightTime0, sBot,
             xloc = xloc.bar_time,
             bgcolor = color.new(rangeColor, boxTransp),
             border_color = color.new(rangeColor, 15),
             border_width = 1)
    else
        box.set_left(rBox, leftTime0)
        box.set_right(rBox, rightTime0)
        box.set_top(rBox, sTop)
        box.set_bottom(rBox, sBot)

if (brokeUp or brokeDown) and not na(rBox)
    color breakColor0 = brokeUp ? bullColor : bearColor
    box.set_right(rBox, structureEventCloseTime)
    box.set_border_color(rBox, breakColor0)
    box.set_bgcolor(rBox, color.new(breakColor0, 94))
    rBox := na

if not showBoxes and not na(rBox)
    box.delete(rBox)
    rBox := na

// -----------------------------------------------------------------------------
// LTF early HTF-break trigger engine
// -----------------------------------------------------------------------------
float ltfAtr = ta.atr(14)
float ltfAtrSafe = math.max(ltfAtr, syminfo.mintick)
float candleRange = math.max(high - low, syminfo.mintick)
float candleBody = math.abs(close - open)
float bodyEfficiency = f_clamp01(candleBody / candleRange)
float rangeExpansion = f_clamp01((candleRange / ltfAtrSafe) / math.max(earlyRangeAtrTarget, 0.05))
float bodyExpansion = f_clamp01((candleBody / ltfAtrSafe) / math.max(earlyBodyAtrTarget, 0.05))
float closeLocBull = f_clamp01((close - low) / candleRange)
float closeLocBear = f_clamp01((high - close) / candleRange)
float htfRangeW = sInRange ? math.max(sTop - sBot, syminfo.mintick) : na

// One explicit trigger level on each side of the active HTF box. This is the
// primary LTF break rule. A shallow poke beyond the box is NOT a break.
float ltfBreakDistance = sInRange ? htfRangeW * ltfBreakLevelPct / 100.0 : na
float ltfBreakUpLevel = sInRange ? sTop + ltfBreakDistance : na
float ltfBreakDownLevel = sInRange ? sBot - ltfBreakDistance : na

float distBeyondUp = sInRange ? math.max(0.0, close - sTop) : 0.0
float distBeyondDown = sInRange ? math.max(0.0, sBot - close) : 0.0
float distPctUp = sInRange and htfRangeW > 0 ? distBeyondUp / htfRangeW * 100.0 : 0.0
float distPctDown = sInRange and htfRangeW > 0 ? distBeyondDown / htfRangeW * 100.0 : 0.0

// Force remains diagnostic/secondary. Once the set trigger level is crossed, we
// only reject extremely weak drifts; there is no hidden force-score threshold.
float edgeQUp = sInRange and ltfBreakDistance > 0 ? f_clamp01(distBeyondUp / (ltfBreakDistance * 1.50)) : 0.0
float edgeQDown = sInRange and ltfBreakDistance > 0 ? f_clamp01(distBeyondDown / (ltfBreakDistance * 1.50)) : 0.0
float forceUp = 100.0 * (0.15 * bodyEfficiency + 0.25 * rangeExpansion + 0.20 * bodyExpansion + 0.10 * closeLocBull + 0.30 * edgeQUp)
float forceDown = 100.0 * (0.15 * bodyEfficiency + 0.25 * rangeExpansion + 0.20 * bodyExpansion + 0.10 * closeLocBear + 0.30 * edgeQDown)

bool timingOk = earlyBreakTiming == "Live LTF bar" ? true : barstate.isconfirmed
bool bodyDirUp = not earlyRequireDirectionalBody or close > open
bool bodyDirDown = not earlyRequireDirectionalBody or close < open

// It must CROSS the set level, not merely remain somewhere outside the range.
// Using the current trigger against the previous close also prevents an adaptive
// boundary change from repeatedly printing while price is already beyond it.
bool crossedUp = sInRange and not na(ltfBreakUpLevel) and close >= ltfBreakUpLevel and close[1] < ltfBreakUpLevel
bool crossedDown = sInRange and not na(ltfBreakDownLevel) and close <= ltfBreakDownLevel and close[1] > ltfBreakDownLevel

// Very mild impulse veto only. The trigger distance does the real filtering.
bool impulsePass = rangeExpansion >= 0.30 or bodyExpansion >= 0.30 or bodyEfficiency >= 0.60

// Re-arm only after price closes back inside the actual HTF box. This avoids
// multiple arrows from chopping around the trigger line during one escape attempt.
var bool earlyUpArmed = true
var bool earlyDownArmed = true
if rangeStarted
    earlyUpArmed := true
    earlyDownArmed := true
if sInRange
    if close <= sTop
        earlyUpArmed := true
    if close >= sBot
        earlyDownArmed := true

bool earlyUpNow = useEarlyBreak and timingOk and earlyUpArmed and crossedUp and bodyDirUp and impulsePass
bool earlyDownNow = useEarlyBreak and timingOk and earlyDownArmed and crossedDown and bodyDirDown and impulsePass
if earlyUpNow
    earlyUpArmed := false
if earlyDownNow
    earlyDownArmed := false

// The trigger levels are intentionally visible so you can see exactly where an
// LTF break becomes valid. They disappear when no HTF range is active.
plot(useEarlyBreak ? ltfBreakUpLevel : na, "LTF Break Trigger Up", color = color.new(bullColor, 55), style = plot.style_linebr, linewidth = 1)
plot(useEarlyBreak ? ltfBreakDownLevel : na, "LTF Break Trigger Down", color = color.new(bearColor, 55), style = plot.style_linebr, linewidth = 1)
plotshape(earlyUpNow, "Early HTF Break Up", style = shape.arrowup, location = location.belowbar, color = bullColor, size = size.small)
plotshape(earlyDownNow, "Early HTF Break Down", style = shape.arrowdown, location = location.abovebar, color = bearColor, size = size.small)

plot(showTriggers ? sBreakUpLevel : na, "HTF Break Up Confirm Level", color = color.new(bullColor, 30), style = plot.style_linebr, linewidth = 1)
plot(showTriggers ? sBreakDownLevel : na, "HTF Break Down Confirm Level", color = color.new(bearColor, 30), style = plot.style_linebr, linewidth = 1)
plotshape(showProbes and probeOpened and probeOpenDir == 1, "HTF Probe Up", style = shape.triangleup, location = location.abovebar, color = color.new(bullColor, 35), size = size.tiny)
plotshape(showProbes and probeOpened and probeOpenDir == -1, "HTF Probe Down", style = shape.triangledown, location = location.belowbar, color = color.new(bearColor, 35), size = size.tiny)

// -----------------------------------------------------------------------------
// MTF badge
// -----------------------------------------------------------------------------
var table tfBadge = table.new(position.top_right, 1, 5)
if barstate.islast
    if showTfBadge
        string stateText = sInRange ? "RANGE" : "SEARCHING"
        table.cell(tfBadge, 0, 0, "Structure " + structureTf + " | Chart " + timeframe.period, text_color = color.white, bgcolor = color.new(rangeColor, 35))
        table.cell(tfBadge, 0, 1, stateText + " | Quality " + str.tostring(nz(sHybridQuality, 0.0), "#.0") + "/100", text_color = color.white, bgcolor = color.new(rangeColor, 60))
        table.cell(tfBadge, 0, 2, "Lux outside " + str.tostring(sLuxOutsideCount) + " / " + str.tostring(luxAllowedOutside), text_color = color.white, bgcolor = color.new(rangeColor, 70))
        table.cell(tfBadge, 0, 3, "LTF trigger " + str.tostring(ltfBreakLevelPct, "#.0") + "% | force " + str.tostring(math.max(forceUp, forceDown), "#.0"), text_color = color.white, bgcolor = color.new(rangeColor, 75))
        table.cell(tfBadge, 0, 4, "Adaptive " + (adaptiveRange ? "ON" : "OFF") + " | Absorb " + (absorbProbes ? "ON" : "OFF"), text_color = color.white, bgcolor = color.new(rangeColor, 80))
    else
        for r = 0 to 4
            table.cell(tfBadge, 0, r, "", bgcolor = color.new(color.black, 100))

