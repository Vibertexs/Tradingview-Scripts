alertcondition(rangeAdapted, "HTF Range Adapted", "The active HTF range resized or shifted to the latest confirmed balance")
alertcondition(probeOpened and probeOpenDir == 1, "HTF Probe Up", "A confirmed HTF candle probed above the active range")
alertcondition(probeOpened and probeOpenDir == -1, "HTF Probe Down", "A confirmed HTF candle probed below the active range")
alertcondition(earlyUpNow, "Early HTF Break Up", "Chart-timeframe price crossed the configured LTF breakout trigger above the active HTF range")
alertcondition(earlyDownNow, "Early HTF Break Down", "Chart-timeframe price crossed the configured LTF breakout trigger below the active HTF range")
