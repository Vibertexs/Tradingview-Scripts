    structureEventCloseTime := sReqCloseTime

    float o0 = sReqO
    float h0 = sReqH
    float l0 = sReqL
    float c0 = sReqC
    float prevC = si > 0 ? array.get(sCloseA, si - 1) : c0
    float tr0 = math.max(h0 - l0, math.max(math.abs(h0 - prevC), math.abs(l0 - prevC)))
    array.push(sTrA, tr0)

    float atr0 = na
    if array.size(sTrA) >= 14
        float prevAtr = array.size(sAtrA) > 0 ? array.get(sAtrA, array.size(sAtrA) - 1) : na
        if na(prevAtr)
            atr0 := f_avg_last(sTrA, 14)
        else
            atr0 := (prevAtr * 13.0 + tr0) / 14.0
    array.push(sAtrA, atr0)
    float atrSafe0 = math.max(nz(atr0, math.max(h0 - l0, syminfo.mintick)), syminfo.mintick)
    sAtrSafe := atrSafe0
    float atrBaseline0 = f_avg_last(sAtrA, 50)
    float atrRatio0 = atrSafe0 / math.max(nz(atrBaseline0, atrSafe0), syminfo.mintick)

    // Rolling structure measurements from the virtual confirmed-HTF stream.
    int rollStart = math.max(0, si - winLen + 1)
    float rollingTop0 = -1e20
    float rollingBot0 = 1e20
    for k = rollStart to si
        rollingTop0 := math.max(rollingTop0, array.get(sHighA, k))
        rollingBot0 := math.min(rollingBot0, array.get(sLowA, k))
    float rollingWidth0 = math.max(rollingTop0 - rollingBot0, syminfo.mintick)
    sRollingTop := rollingTop0
    sRollingBot := rollingBot0
    float widthAtr0 = rollingWidth0 / atrSafe0

    bool enoughHistory = si >= winLen
    float path0 = 0.0
    float avgOverlap0 = 0.0
    float oldClose = enoughHistory ? array.get(sCloseA, si - winLen) : c0
    if enoughHistory
        float overlapSum = 0.0
        for k = si - winLen + 1 to si
            float ck = array.get(sCloseA, k)
            float cPrev = array.get(sCloseA, k - 1)
            path0 += math.abs(ck - cPrev)
            float hk = array.get(sHighA, k)
            float lk = array.get(sLowA, k)
            float hp = array.get(sHighA, k - 1)
            float lp = array.get(sLowA, k - 1)
            float overlapAmount = math.max(0.0, math.min(hk, hp) - math.max(lk, lp))
            float overlapBase = math.max(math.min(hk - lk, hp - lp), syminfo.mintick)
            overlapSum += math.min(1.0, overlapAmount / overlapBase)
        avgOverlap0 := overlapSum / float(winLen)
    float efficiency0 = enoughHistory ? math.abs(c0 - oldClose) / math.max(path0, syminfo.mintick) : 1.0

    // OLS slope over the latest winLen confirmed structure closes.
    float lrSlope0 = 0.0
    if si >= winLen - 1
        float n = float(winLen)
        float sumX = n * (n - 1.0) * 0.5
        float sumXX = (n - 1.0) * n * (2.0 * n - 1.0) / 6.0
        float sumY = 0.0
        float sumXY = 0.0
        for j = 0 to winLen - 1
            float y = array.get(sCloseA, si - winLen + 1 + j)
            sumY += y
            sumXY += float(j) * y
        float denom = n * sumXX - sumX * sumX
        lrSlope0 := denom != 0 ? (n * sumXY - sumX * sumY) / denom : 0.0
    float lrSlopeAtr0 = math.abs(lrSlope0) / atrSafe0
    float driftRatio0 = enoughHistory ? math.abs(c0 - oldClose) / rollingWidth0 : 1.0
    float position0 = (c0 - rollingBot0) / rollingWidth0
    bool notPinned0 = position0 > 0.01 and position0 < 0.99

    // Kalman level + velocity on the confirmed HTF stream.
    float qLevel0 = math.pow(atrSafe0 * (0.020 + s * 0.002), 2)
    float qVelocity0 = math.pow(atrSafe0 * (0.004 + s * 0.0007), 2)
    float rMeasure0 = math.pow(atrSafe0 * 0.80, 2)
    if na(sKLevel)
        sKLevel := c0
        sKVelocity := 0.0
        sP00 := rMeasure0
        sP01 := 0.0
        sP10 := 0.0
        sP11 := rMeasure0
    else
        float predLevel = sKLevel + sKVelocity
        float predVelocity = sKVelocity
        float pp00 = sP00 + sP01 + sP10 + sP11 + qLevel0
        float pp01 = sP01 + sP11
        float pp10 = sP10 + sP11
        float pp11 = sP11 + qVelocity0
        float innovation = c0 - predLevel
        float innovationVariance = math.max(pp00 + rMeasure0, syminfo.mintick * syminfo.mintick)
        float gainLevel = pp00 / innovationVariance
        float gainVelocity = pp10 / innovationVariance
        sKLevel := predLevel + gainLevel * innovation
        sKVelocity := predVelocity + gainVelocity * innovation
        sP00 := (1.0 - gainLevel) * pp00
        sP01 := (1.0 - gainLevel) * pp01
        sP10 := pp10 - gainVelocity * pp00
        sP11 := pp11 - gainVelocity * pp01
    array.push(sKalmanA, sKLevel)
    float kalmanSlopeAtr0 = math.abs(sKVelocity) / atrSafe0
    float oldKalman = array.size(sKalmanA) > winLen ? array.get(sKalmanA, array.size(sKalmanA) - 1 - winLen) : na
    float kalmanDrift0 = not na(oldKalman) ? math.abs(sKLevel - oldKalman) / rollingWidth0 : driftRatio0
    float slopeAtr0 = lrSlopeAtr0 * (1.0 - KALMAN_WEIGHT) + kalmanSlopeAtr0 * KALMAN_WEIGHT
    float blendedDrift0 = driftRatio0 * (1.0 - KALMAN_WEIGHT) + kalmanDrift0 * KALMAN_WEIGHT

    int rangeScore0 =
         (efficiency0 <= maxEfficiency ? 1 : 0) +
         (atrRatio0 <= maxAtrRatio ? 1 : 0) +
         (widthAtr0 <= widthK * math.sqrt(float(winLen)) ? 1 : 0) +
         (avgOverlap0 >= minOverlap ? 1 : 0) +
         (slopeAtr0 <= maxSlopeAtr ? 1 : 0) +
         (blendedDrift0 <= maxDrift ? 1 : 0)
    sRangeScore := rangeScore0
    int requiredScore = rangeSensitivity >= 7 ? 4 : 5
    bool rangeCandidate0 = enoughHistory and rangeScore0 >= requiredScore and notPinned0
    sCandidateStreak := rangeCandidate0 ? sCandidateStreak + 1 : 0
    bool confirmedCandidate0 = sCandidateStreak >= confirmBars
    sRangeCandidateConfirmed := confirmedCandidate0

    // Update unresolved historical pullback candidates from this confirmed HTF bar.
    if array.size(pbEvDir) > 0
        int ev = array.size(pbEvDir) - 1
        while ev >= 0
            int evDir = array.get(pbEvDir, ev)
            int evStart = array.get(pbEvStart, ev)
            int evExpiry = array.get(pbEvExpiry, ev)
            float evAtr = array.get(pbEvAtr, ev)
            int histBase = evDir == 1 ? 0 : 4
            for kind = 0 to 3
                float zTopEv = kind == 0 ? array.get(pbEvTop0, ev) : kind == 1 ? array.get(pbEvTop1, ev) : kind == 2 ? array.get(pbEvTop2, ev) : array.get(pbEvTop3, ev)
                float zBotEv = kind == 0 ? array.get(pbEvBot0, ev) : kind == 1 ? array.get(pbEvBot1, ev) : kind == 2 ? array.get(pbEvBot2, ev) : array.get(pbEvBot3, ev)
                bool enteredEv = kind == 0 ? array.get(pbEvEntered0, ev) : kind == 1 ? array.get(pbEvEntered1, ev) : kind == 2 ? array.get(pbEvEntered2, ev) : array.get(pbEvEntered3, ev)
                bool doneEv = kind == 0 ? array.get(pbEvDone0, ev) : kind == 1 ? array.get(pbEvDone1, ev) : kind == 2 ? array.get(pbEvDone2, ev) : array.get(pbEvDone3, ev)
                bool enteredBefore = enteredEv
                bool completedNow = false
                bool reactedNow = false
                if not doneEv and si > evStart
                    bool overlapEv = not na(zTopEv) and not na(zBotEv) and h0 >= zBotEv and l0 <= zTopEv
                    if not enteredEv and overlapEv
                        enteredEv := true
                    bool invalidEv = evDir == 1 ? c0 < zBotEv - pullbackInvalidAtr * evAtr : c0 > zTopEv + pullbackInvalidAtr * evAtr
                    bool favorableEv = enteredBefore and (evDir == 1 ? h0 >= zTopEv + pullbackReactionAtr * evAtr : l0 <= zBotEv - pullbackReactionAtr * evAtr)
                    if favorableEv and not invalidEv
                        doneEv := true
                        completedNow := true
                        reactedNow := true
                    else if invalidEv or si >= evExpiry
                        doneEv := true
                        completedNow := true
                if kind == 0
                    array.set(pbEvEntered0, ev, enteredEv)
                    array.set(pbEvDone0, ev, doneEv)
                else if kind == 1
                    array.set(pbEvEntered1, ev, enteredEv)
                    array.set(pbEvDone1, ev, doneEv)
                else if kind == 2
                    array.set(pbEvEntered2, ev, enteredEv)
                    array.set(pbEvDone2, ev, doneEv)
                else
                    array.set(pbEvEntered3, ev, enteredEv)
                    array.set(pbEvDone3, ev, doneEv)
                if completedNow
                    int hx = histBase + kind
                    array.set(pbHistEvents, hx, array.get(pbHistEvents, hx) + 1.0)
                    array.set(pbHistReached, hx, array.get(pbHistReached, hx) + (enteredEv ? 1.0 : 0.0))
                    array.set(pbHistReacted, hx, array.get(pbHistReacted, hx) + (reactedNow ? 1.0 : 0.0))
            bool allDone = array.get(pbEvDone0, ev) and array.get(pbEvDone1, ev) and array.get(pbEvDone2, ev) and array.get(pbEvDone3, ev)
            if allDone
                array.remove(pbEvDir, ev)
                array.remove(pbEvStart, ev)
                array.remove(pbEvExpiry, ev)
                array.remove(pbEvAtr, ev)
                array.remove(pbEvTop0, ev)
                array.remove(pbEvBot0, ev)
                array.remove(pbEvTop1, ev)
                array.remove(pbEvBot1, ev)
                array.remove(pbEvTop2, ev)
                array.remove(pbEvBot2, ev)
                array.remove(pbEvTop3, ev)
                array.remove(pbEvBot3, ev)
                array.remove(pbEvEntered0, ev)
                array.remove(pbEvEntered1, ev)
                array.remove(pbEvEntered2, ev)
                array.remove(pbEvEntered3, ev)
                array.remove(pbEvDone0, ev)
                array.remove(pbEvDone1, ev)
                array.remove(pbEvDone2, ev)
                array.remove(pbEvDone3, ev)
            ev -= 1

    // Original range lifecycle, now advanced once per confirmed HTF candle.
    float buf0 = atrSafe0 * breakBufferAtr
    if sInRange
        int rBars = si - sLeftIdx + 1
        bool cAbove = c0 > sTop + buf0
        bool cBelow = c0 < sBot - buf0
        if absorbProbes and c0 < sTop and h0 > sTop and h0 - sTop <= atrSafe0 * WICK_ABSORB_ATR and f_fits_ctx(h0, sBot, rBars, sSeedW, atrSafe0)
            sTop := h0
        if absorbProbes and c0 > sBot and l0 < sBot and sBot - l0 <= atrSafe0 * WICK_ABSORB_ATR and f_fits_ctx(sTop, l0, rBars, sSeedW, atrSafe0)
            sBot := l0
        if cAbove or cBelow
            int d = cAbove ? 1 : -1
            if sProbeDir == d
                sProbeBars += 1
                sProbeExt := d == 1 ? math.max(sProbeExt, h0) : math.min(sProbeExt, l0)
            else
                sProbeDir := d
                sProbeBars := 1
                sProbeExt := d == 1 ? h0 : l0
                probeOpened := true
                probeOpenDir := d
            float span = math.max(sTop - sBot, syminfo.mintick)
            float dist = d == 1 ? c0 - sTop : sBot - c0
            bool escapeHit = dist / span >= escapeFrac or (escapeCapAtr > 0 and dist / atrSafe0 >= escapeCapAtr)
            bool breakoutReady = (sProbeBars >= MIN_PROBE_BARS and escapeHit) or sProbeBars >= confirmWindow
            if breakoutReady
                brokeUp := d == 1
                brokeDown := d == -1
                sBreakLevel := d == 1 ? sTop : sBot
                sInRange := false
                sLastBreakIdx := si
                sCandidateStreak := 0
                sProbeDir := 0
                sProbeBars := 0
                sProbeExt := na
        else
            if sProbeDir != 0
                sRejects += 1
                if absorbProbes and sProbeDir == 1 and f_fits_ctx(math.max(sTop, sProbeExt), sBot, rBars, sSeedW, atrSafe0)
                    sTop := math.max(sTop, sProbeExt)
                if absorbProbes and sProbeDir == -1 and f_fits_ctx(sTop, math.min(sBot, sProbeExt), rBars, sSeedW, atrSafe0)
                    sBot := math.min(sBot, sProbeExt)
                sProbeDir := 0
                sProbeBars := 0
                sProbeExt := na
            sRightIdx := si

    // Adaptive resize uses the latest confirmed HTF rolling shelf.
    bool latestShelfInside = sInRange and rollingTop0 <= sTop and rollingBot0 >= sBot and (rollingTop0 < sTop or rollingBot0 > sBot)
    bool canRefocus = adaptiveResize and sInRange and sProbeDir == 0 and confirmedCandidate0 and latestShelfInside and (si - sLeftIdx + 1) >= winLen
    if canRefocus
        float oldTop = sTop
        float oldBot = sBot
        int floorIdx = math.max(0, nz(sLastBreakIdx, -1) + 1)
        sLeftIdx := math.max(floorIdx, si - winLen + 1)
        sTop := rollingTop0
        sBot := rollingBot0
        sRightIdx := si
        sSeedW := rollingWidth0
        sRejects := 0
        sProbeDir := 0
        sProbeBars := 0
        sProbeExt := na
        sCandidateStreak := 0
        rangeRefocused := true
        if showAdaptationTrace
            int prevCloseTime = si > 0 ? array.get(sCloseTimeA, si - 1) : sReqTime
            if sTop != oldTop
                line.new(prevCloseTime, oldTop, sReqCloseTime, sTop, xloc = xloc.bar_time, extend = extend.none, color = rangeColor, width = 2)
            if sBot != oldBot
                line.new(prevCloseTime, oldBot, sReqCloseTime, sBot, xloc = xloc.bar_time, extend = extend.none, color = rangeColor, width = 2)

    bool cooldownReady = na(sLastBreakIdx) or si - sLastBreakIdx > COOLDOWN_BARS
    bool wantSeed = not sInRange and not (brokeUp or brokeDown) and confirmedCandidate0 and cooldownReady
    if wantSeed
        int startIdx = math.max(0, si - winLen + 1)
        float seedTop = rollingTop0
        float seedBot = rollingBot0
        float tol = atrSafe0 * BACKFILL_TOL_ATR
        bool stopBack = false
        for back = 1 to anchorLookback
            int idx = si - back
            if not stopBack and idx >= 0
                if idx - winLen >= 0 and math.abs(array.get(sCloseA, idx) - array.get(sCloseA, idx - winLen)) > (rollingTop0 - rollingBot0) * maxDrift
                    stopBack := true
                else if array.get(sCloseA, idx) <= rollingTop0 + tol and array.get(sCloseA, idx) >= rollingBot0 - tol
                    startIdx := idx
                    seedTop := math.max(seedTop, math.min(array.get(sHighA, idx), rollingTop0 + atrSafe0))
                    seedBot := math.min(seedBot, math.max(array.get(sLowA, idx), rollingBot0 - atrSafe0))
                else
                    stopBack := true
        int floorIdx = math.max(0, nz(sLastBreakIdx, -1) + 1)
        startIdx := math.max(startIdx, floorIdx)
        int seedBars = si - startIdx + 1
        if not f_fits_ctx(seedTop, seedBot, seedBars, na, atrSafe0)
            seedTop := rollingTop0
            seedBot := rollingBot0
            startIdx := math.max(floorIdx, si - winLen + 1)
        sInRange := true
        sLeftIdx := startIdx
        sTop := seedTop
        sBot := seedBot
        sRightIdx := si
        sSeedW := seedTop - seedBot
        sRejects := 0
        sProbeDir := 0
        sProbeBars := 0
        sProbeExt := na
        sCandidateStreak := 0
        rangeStarted := true

    // Profile from confirmed HTF bars. On a break it uses the completed old range.
    bool profileNeeded = (profileBasis != "Off") or showPullbackZone
    if profileNeeded and not na(sLeftIdx) and not na(sRightIdx) and sRightIdx >= sLeftIdx
        bool useVol = profileBasis == "Volume"
        [poc0, vah0, val0] = f_profile_arr(sLeftIdx, sRightIdx, sTop, sBot, useVol)
        sPocValue := poc0
        sVahValue := vah0
        sValValue := val0

    // Create the most-likely pullback zone from the confirmed HTF breakout.
    if showPullbackZone and (brokeUp or brokeDown) and not na(sBreakLevel)
        int newDir = brokeUp ? 1 : -1
        float oldRangeW = math.max(sTop - sBot, syminfo.mintick)
        float halfWRaw = math.max(atrSafe0 * pullbackZoneAtr, oldRangeW * pullbackZoneRangePct / 100.0)
        float halfW = math.max(syminfo.mintick * 2.0, math.min(atrSafe0 * pullbackMaxHalfAtr, halfWRaw))
        float edgeLevel = sBreakLevel
        float roundLevel0 = na
        bool roundValid = false
        if useForexRoundNumbers and syminfo.type == "forex"
            float pip0 = f_pipSize()
            float roundStep0 = math.max(pip0 * float(roundNumberPips), syminfo.mintick)
            roundLevel0 := newDir == 1 ? math.floor((c0 - syminfo.mintick) / roundStep0) * roundStep0 : math.ceil((c0 + syminfo.mintick) / roundStep0) * roundStep0
            roundValid := newDir == 1 ? roundLevel0 < c0 and roundLevel0 >= sBot - halfW : roundLevel0 > c0 and roundLevel0 <= sTop + halfW
        float vaLevel = newDir == 1 ? sVahValue : sValValue
        float pocLevel0 = sPocValue
        bool vaValid = not na(vaLevel) and vaLevel >= sBot and vaLevel <= sTop
        bool pocValid = not na(pocLevel0) and pocLevel0 >= sBot and pocLevel0 <= sTop
        float candleSpan = math.max(h0 - l0, syminfo.mintick)
        float displacementQ = math.min(1.0, math.abs(c0 - edgeLevel) / atrSafe0)
        float bodyQ = math.min(1.0, math.abs(c0 - o0) / candleSpan)
        float closeLocationQ = newDir == 1 ? (c0 - l0) / candleSpan : (h0 - c0) / candleSpan
        float breakoutQuality = f_clamp01(0.45 * displacementQ + 0.25 * bodyQ + 0.30 * closeLocationQ)
        int leftForTests = math.max(0, sLeftIdx)
        int rightForTests = math.max(leftForTests, sRightIdx)
        [struct0, tests0] = f_candidateScore_arr(0, true, edgeLevel, edgeLevel, roundValid ? roundLevel0 : na, vaValid ? vaLevel : na,
             pocValid ? pocLevel0 : na, halfW, newDir, leftForTests, rightForTests, si, breakoutQuality, c0, atrSafe0)
        [struct1, tests1] = f_candidateScore_arr(1, roundValid, roundLevel0, edgeLevel, roundLevel0, vaValid ? vaLevel : na,
             pocValid ? pocLevel0 : na, halfW, newDir, leftForTests, rightForTests, si, breakoutQuality, c0, atrSafe0)
        [struct2, tests2] = f_candidateScore_arr(2, vaValid, vaLevel, edgeLevel, roundValid ? roundLevel0 : na, vaLevel,
             pocValid ? pocLevel0 : na, halfW, newDir, leftForTests, rightForTests, si, breakoutQuality, c0, atrSafe0)
        [struct3, tests3] = f_candidateScore_arr(3, pocValid, pocLevel0, edgeLevel, roundValid ? roundLevel0 : na, vaValid ? vaLevel : na,
             pocLevel0, halfW, newDir, leftForTests, rightForTests, si, breakoutQuality, c0, atrSafe0)
        int histBaseNew = newDir == 1 ? 0 : 4
        [score0, histSuccess0, histReach0, histHold0, histN0] = f_blendScore(struct0, histBaseNew)
        [score1, histSuccess1, histReach1, histHold1, histN1] = f_blendScore(struct1, histBaseNew + 1)
        [score2, histSuccess2, histReach2, histHold2, histN2] = f_blendScore(struct2, histBaseNew + 2)
        [score3, histSuccess3, histReach3, histHold3, histN3] = f_blendScore(struct3, histBaseNew + 3)
        int bestKind = 0
        float bestScore = score0
        float bestLevel = edgeLevel
        float bestHistSuccess = histSuccess0
        float bestHistReach = histReach0
        float bestHistHold = histHold0
        float bestHistN = histN0
        int bestTests = tests0
        if score1 > bestScore
            bestKind := 1
            bestScore := score1
            bestLevel := roundLevel0
            bestHistSuccess := histSuccess1
            bestHistReach := histReach1
            bestHistHold := histHold1
            bestHistN := histN1
            bestTests := tests1
        if score2 > bestScore
            bestKind := 2
            bestScore := score2
            bestLevel := vaLevel
            bestHistSuccess := histSuccess2
            bestHistReach := histReach2
            bestHistHold := histHold2
            bestHistN := histN2
            bestTests := tests2
        if score3 > bestScore
            bestKind := 3
            bestScore := score3
            bestLevel := pocLevel0
            bestHistSuccess := histSuccess3
            bestHistReach := histReach3
            bestHistHold := histHold3
            bestHistN := histN3
            bestTests := tests3
        float outsideW = halfW * 0.45
        float insideW = halfW * 1.15
        float zTop0 = newDir == 1 ? edgeLevel + outsideW : edgeLevel + insideW
        float zBot0 = newDir == 1 ? edgeLevel - insideW : edgeLevel - outsideW
        float zTop1 = roundValid ? roundLevel0 + halfW : na
        float zBot1 = roundValid ? roundLevel0 - halfW : na
        float zTop2 = vaValid ? vaLevel + halfW : na
        float zBot2 = vaValid ? vaLevel - halfW : na
        float zTop3 = pocValid ? pocLevel0 + halfW : na
        float zBot3 = pocValid ? pocLevel0 - halfW : na
        float selectedTop = bestKind == 0 ? zTop0 : bestKind == 1 ? zTop1 : bestKind == 2 ? zTop2 : zTop3
        float selectedBot = bestKind == 0 ? zBot0 : bestKind == 1 ? zBot1 : bestKind == 2 ? zBot2 : zBot3
        string confluenceText = ""
        float mergeDistance = halfW * 1.50
        bool edgeNear = bestKind != 0 and math.abs(bestLevel - edgeLevel) <= mergeDistance
        bool roundNearBest = bestKind != 1 and roundValid and math.abs(bestLevel - roundLevel0) <= mergeDistance
        bool valueNear = bestKind != 2 and vaValid and math.abs(bestLevel - vaLevel) <= mergeDistance
        bool pocNear = bestKind != 3 and pocValid and math.abs(bestLevel - pocLevel0) <= mergeDistance
        if edgeNear
            confluenceText += " + edge"
            if mergePullbackConfluence
                selectedTop := math.max(selectedTop, zTop0)
                selectedBot := math.min(selectedBot, zBot0)
        if roundNearBest
            confluenceText += " + round"
            if mergePullbackConfluence
                selectedTop := math.max(selectedTop, zTop1)
                selectedBot := math.min(selectedBot, zBot1)
        if valueNear
            confluenceText += " + value"
            if mergePullbackConfluence
                selectedTop := math.max(selectedTop, zTop2)
                selectedBot := math.min(selectedBot, zBot2)
        if pocNear
            confluenceText += " + POC"
            if mergePullbackConfluence
                selectedTop := math.max(selectedTop, zTop3)
                selectedBot := math.min(selectedBot, zBot3)

        // Retire prior visual objects according to history preference.
        if not na(pbBox)
            if keepHistoricalPullbackZones
                pbBox := na
            else
                box.delete(pbBox)
                pbBox := na
        if not na(pbLabel)
            if keepHistoricalPullbackZones
                pbLabel := na
            else
                label.delete(pbLabel)
                pbLabel := na
        if not na(pbInvalidLine)
            if keepHistoricalPullbackZones
                pbInvalidLine := na
            else
                line.delete(pbInvalidLine)
                pbInvalidLine := na

        pbDir := newDir
        pbCreatedStructIdx := si
        pbExpiryStructIdx := si + pullbackHorizon
        pbCreatedTime := sReqCloseTime
        pbExpiryTime := sReqCloseTime + int(structureTfSeconds * 1000.0 * float(pullbackHorizon))
        pbEndTime := na
        pbTop := selectedTop
        pbBot := selectedBot
        pbMid := (selectedTop + selectedBot) * 0.50
        pbAtrAtBreak := atrSafe0
        pbRank := bestScore
        pbObservedRate := bestHistSuccess
        pbObservedReach := bestHistReach
        pbObservedHold := bestHistHold
        pbObservedN := bestHistN
        pbCandidateName := f_candidateName(bestKind)
        pbConfluence := confluenceText + " | prior HTF tests: " + str.tostring(bestTests)
        pbStatus := "Waiting"
        pbTouched := false
        pbTouchBar := na
        pbActive := true
        pbInvalidLevel := newDir == 1 ? selectedBot - pullbackInvalidAtr * atrSafe0 : selectedTop + pullbackInvalidAtr * atrSafe0

        pbEntryTouched := false
        pbEntryConfirmed := false
        pbEntryDead := false
        pbAcceptance := false
        pbReclaim := false
        pbDisplacement := false
        pbMicroBreak := false
        pbChartTouchBar := na
        pbChartBarsAfterTouch := 0
        pbWeakCloses := 0
        pbEntryExtreme := na
        pbMicroLevel := na
        pbReactionScore := na
        pbEntryStatus := useChartReaction ? "WAITING FOR RETEST" : "Off"
        array.clear(pbPreHighs)
        array.clear(pbPreLows)

        color zoneColor = newDir == 1 ? bullColor : bearColor
        pbBox := box.new(pbCreatedTime, selectedTop, pbExpiryTime, selectedBot,
             xloc = xloc.bar_time, bgcolor = color.new(zoneColor, 88), border_color = color.new(zoneColor, 15), border_width = 1)
        if showHardInvalidation
            pbInvalidLine := line.new(pbCreatedTime, pbInvalidLevel, pbExpiryTime, pbInvalidLevel,
                 xloc = xloc.bar_time, extend = extend.none, color = color.new(rangeColor, 25), width = 1, style = line.style_dashed)
        if showPullbackLabels
            pbLabel := label.new(pbCreatedTime, newDir == 1 ? selectedBot : selectedTop,
                 f_pullbackText(pbDir, pbCandidateName, pbConfluence, pbBot, pbTop, pbRank,
                      pbObservedRate, pbObservedReach, pbObservedHold, pbObservedN, pbStatus) +
                      f_entryText(pbInvalidLevel, pbEntryStatus, pbReactionScore, pbReclaim, pbDisplacement, pbMicroBreak, pbWeakCloses, pbMicroLevel),
                 xloc = xloc.bar_time, yloc = yloc.price,
                 style = newDir == 1 ? label.style_label_up : label.style_label_down,
                 color = color.new(zoneColor, 10), textcolor = color.white, size = size.tiny)

        // Add all frozen candidates to the HTF learning queue.
        if array.size(pbEvDir) >= PULLBACK_MAX_EVENTS
            array.remove(pbEvDir, 0)
            array.remove(pbEvStart, 0)
            array.remove(pbEvExpiry, 0)
            array.remove(pbEvAtr, 0)
            array.remove(pbEvTop0, 0)
            array.remove(pbEvBot0, 0)
            array.remove(pbEvTop1, 0)
            array.remove(pbEvBot1, 0)
            array.remove(pbEvTop2, 0)
            array.remove(pbEvBot2, 0)
            array.remove(pbEvTop3, 0)
            array.remove(pbEvBot3, 0)
            array.remove(pbEvEntered0, 0)
            array.remove(pbEvEntered1, 0)
            array.remove(pbEvEntered2, 0)
            array.remove(pbEvEntered3, 0)
            array.remove(pbEvDone0, 0)
            array.remove(pbEvDone1, 0)
            array.remove(pbEvDone2, 0)
            array.remove(pbEvDone3, 0)
        array.push(pbEvDir, newDir)
        array.push(pbEvStart, si)
        array.push(pbEvExpiry, si + pullbackHorizon)
        array.push(pbEvAtr, atrSafe0)
        array.push(pbEvTop0, zTop0)
        array.push(pbEvBot0, zBot0)
        array.push(pbEvTop1, zTop1)
        array.push(pbEvBot1, zBot1)
        array.push(pbEvTop2, zTop2)
        array.push(pbEvBot2, zBot2)
        array.push(pbEvTop3, zTop3)
        array.push(pbEvBot3, zBot3)
        array.push(pbEvEntered0, false)
        array.push(pbEvEntered1, false)
        array.push(pbEvEntered2, false)
        array.push(pbEvEntered3, false)
        array.push(pbEvDone0, false)
        array.push(pbEvDone1, not roundValid)
        array.push(pbEvDone2, not vaValid)
        array.push(pbEvDone3, not pocValid)
        pullbackZoneStarted := true

    // Structure trigger values after this confirmed bar.
    sBreakUpLevel := sInRange ? sTop + atrSafe0 * breakBufferAtr : na
    sBreakDownLevel := sInRange ? sBot - atrSafe0 * breakBufferAtr : na

// ─────────────────────────────────────────────────────────────────────────────
// Live HTF range/profile drawings on ANY lower chart timeframe.
// ─────────────────────────────────────────────────────────────────────────────
if showBoxes and sInRange and not na(sLeftIdx) and array.size(sTimeA) > 0
    int leftTime = array.get(sTimeA, sLeftIdx)
    int rightTime = time_close
    if na(rBox)
        rBox := box.new(leftTime, sTop, rightTime, sBot, xloc = xloc.bar_time,
             bgcolor = color.new(rangeColor, boxTransp), border_color = color.new(rangeColor, 15), border_width = 1)
    else
        box.set_left(rBox, leftTime)
        box.set_right(rBox, rightTime)
        box.set_top(rBox, sTop)
        box.set_bottom(rBox, sBot)
else if not showBoxes and not na(rBox)
    box.delete(rBox)
    rBox := na

if (brokeUp or brokeDown) and not na(rBox)
    color bc = brokeUp ? bullColor : bearColor
    box.set_right(rBox, structureEventCloseTime)
    box.set_border_color(rBox, bc)
    box.set_bgcolor(rBox, color.new(bc, 94))
    rBox := na

bool profileOn = profileBasis != "Off"
if profileOn and sInRange and not na(sLeftIdx) and not na(sRightIdx) and not na(sPocValue)
    int pLeftTime = array.get(sTimeA, sLeftIdx)
    int pRightTime = time_close
    if na(pocLine)
        pocLine := line.new(pLeftTime, sPocValue, pRightTime, sPocValue, xloc = xloc.bar_time, color = profileColor, width = 2)
        vahLine := line.new(pLeftTime, sVahValue, pRightTime, sVahValue, xloc = xloc.bar_time, color = color.new(profileColor, 40), width = 1, style = line.style_dotted)
        valLine := line.new(pLeftTime, sValValue, pRightTime, sValValue, xloc = xloc.bar_time, color = color.new(profileColor, 40), width = 1, style = line.style_dotted)
    else
        line.set_xy1(pocLine, pLeftTime, sPocValue)
        line.set_xy2(pocLine, pRightTime, sPocValue)
        line.set_xy1(vahLine, pLeftTime, sVahValue)
        line.set_xy2(vahLine, pRightTime, sVahValue)
        line.set_xy1(valLine, pLeftTime, sValValue)
        line.set_xy2(valLine, pRightTime, sValValue)
else if not profileOn
    if not na(pocLine)
        line.delete(pocLine)
        pocLine := na
    if not na(vahLine)
        line.delete(vahLine)
        vahLine := na
    if not na(valLine)
        line.delete(valLine)
        valLine := na

if brokeUp or brokeDown
    pocLine := na
    vahLine := na
    valLine := na
    if showBreakLabels
        label.new(structureEventCloseTime, sBreakLevel, brokeUp ? "HTF Bull break" : "HTF Bear break",
             xloc = xloc.bar_time, yloc = yloc.price,
             style = brokeUp ? label.style_label_up : label.style_label_down,
             color = color.new(brokeUp ? bullColor : bearColor, 10), textcolor = color.white, size = size.tiny)

// ─────────────────────────────────────────────────────────────────────────────
// Latest-zone generic lifecycle on the chart timeframe.
// This is display/entry responsiveness only; adaptive ranking history above is HTF.
// ─────────────────────────────────────────────────────────────────────────────
if pbActive and not na(pbCreatedTime) and time >= pbCreatedTime
    bool overlapNow = high >= pbBot and low <= pbTop
    if not pbTouched and overlapNow
        pbTouched := true
        pbTouchBar := bar_index
        pbStatus := "Reached - waiting for reaction"
        pullbackZoneTouched := true
    bool currentInvalid = pbDir == 1 ? close < pbInvalidLevel : close > pbInvalidLevel
    bool currentReacted = pbTouched and not na(pbTouchBar) and bar_index > pbTouchBar and
         (pbDir == 1 ? high >= pbTop + pullbackReactionAtr * pbAtrAtBreak : low <= pbBot - pullbackReactionAtr * pbAtrAtBreak)
    if currentReacted and not currentInvalid
        pbActive := false
        pbStatus := "Reacted"
        pbEndTime := time_close
        pullbackZoneReacted := true
        if not na(pbBox)
            box.set_right(pbBox, pbEndTime)
            box.set_border_width(pbBox, 2)
            box.set_bgcolor(pbBox, color.new(pbDir == 1 ? bullColor : bearColor, 82))
    else if currentInvalid
        pbActive := false
        pbStatus := "Invalidated"
        pbEndTime := time_close
        pullbackZoneFailed := true
        if not na(pbBox)
            box.set_right(pbBox, pbEndTime)
            box.set_border_color(pbBox, color.new(rangeColor, 20))
            box.set_bgcolor(pbBox, color.new(rangeColor, 92))
    else if not na(pbExpiryStructIdx) and array.size(sCloseA) - 1 >= pbExpiryStructIdx
        pbActive := false
        pbStatus := pbTouched ? "Expired after reach" : "Expired - not reached"
        pbEndTime := time_close
        pullbackZoneExpired := true
        if not na(pbBox)
            box.set_right(pbBox, pbEndTime)
            box.set_border_color(pbBox, color.new(rangeColor, 35))

if not pbActive and not na(pbInvalidLine) and not na(pbEndTime)
    line.set_x2(pbInvalidLine, pbEndTime)

// ─────────────────────────────────────────────────────────────────────────────
// Chart-timeframe rejection / acceptance engine.
// Only CLOSED chart bars are used. HTF zone never moves because of this engine.
// ─────────────────────────────────────────────────────────────────────────────
if pullbackZoneFailed and not pbEntryConfirmed
    pbEntryDead := true
    pbEntryStatus := "INVALIDATED - AVOID"
    chartEntryInvalidNow := true
if pullbackZoneExpired and not pbEntryConfirmed and not pbEntryDead
    pbEntryDead := true
    pbEntryStatus := "EXPIRED - AVOID"

bool chartBarReady = barstate.isconfirmed
if useChartReaction and chartBarReady and pbDir != 0 and not na(pbCreatedTime) and time >= pbCreatedTime and not pbEntryConfirmed and not pbEntryDead
    float chartAtr = math.max(ta.atr(14), syminfo.mintick)
    float zoneW = math.max(pbTop - pbBot, syminfo.mintick)
    bool overlapChart = high >= pbBot and low <= pbTop

    if not pbEntryTouched and not overlapChart
        array.push(pbPreHighs, high)
        array.push(pbPreLows, low)
        if array.size(pbPreHighs) > microLookback
            array.shift(pbPreHighs)
            array.shift(pbPreLows)

    if not pbEntryTouched and overlapChart
        pbEntryTouched := true
        pbChartTouchBar := bar_index
        pbChartBarsAfterTouch := 1
        pbEntryExtreme := pbDir == 1 ? low : high
        pbMicroLevel := pbDir == 1 ? (array.size(pbPreHighs) > 0 ? array.max(pbPreHighs) : high) :
             (array.size(pbPreLows) > 0 ? array.min(pbPreLows) : low)
        pbEntryStatus := "TESTING - WAIT"
    else if pbEntryTouched
        pbChartBarsAfterTouch += 1
        pbEntryExtreme := pbDir == 1 ? math.min(nz(pbEntryExtreme, low), low) : math.max(nz(pbEntryExtreme, high), high)

    if pbEntryTouched
        float barSpan = math.max(high - low, syminfo.mintick)
        float wickRatio = pbDir == 1 ? (math.min(open, close) - low) / barSpan : (high - math.max(open, close)) / barSpan
        wickRatio := f_clamp01(wickRatio)
        float closeQuality = pbDir == 1 ? f_clamp01((close - pbBot) / zoneW) : f_clamp01((pbTop - close) / zoneW)
        float penetration = pbDir == 1 ? (pbTop - pbEntryExtreme) / zoneW : (pbEntryExtreme - pbBot) / zoneW
        penetration := math.max(0.0, math.min(1.50, penetration))
        float reclaimLevel = reclaimMode == "Outer Edge" ? (pbDir == 1 ? pbTop : pbBot) : pbMid
        bool reclaimNow = reclaimMode == "Off" ? true : (pbDir == 1 ? close > reclaimLevel : close < reclaimLevel)
        if reclaimNow
            pbReclaim := true
        bool displacementNow = pbDir == 1 ? close >= pbEntryExtreme + entryReactionAtr * chartAtr : close <= pbEntryExtreme - entryReactionAtr * chartAtr
        if displacementNow
            pbDisplacement := true
        bool microNow = na(pbMicroLevel) ? false : (pbDir == 1 ? close > pbMicroLevel : close < pbMicroLevel)
        if microNow
            pbMicroBreak := true
        float acceptFrac = acceptanceDepthPct / 100.0
        float weakThreshold = pbDir == 1 ? pbTop - zoneW * acceptFrac : pbBot + zoneW * acceptFrac
        bool weakClose = pbDir == 1 ? close <= weakThreshold : close >= weakThreshold
        pbWeakCloses := weakClose ? pbWeakCloses + 1 : (pbReclaim ? 0 : math.max(0, pbWeakCloses - 1))
        bool hardInvalid = pbDir == 1 ? close < pbInvalidLevel : close > pbInvalidLevel
        bool acceptanceNow = pbWeakCloses >= acceptanceCloses or (penetration >= 1.0 and closeQuality < 0.35)
        if acceptanceNow and not pbAcceptance
            chartAcceptanceWarningNow := true
        pbAcceptance := acceptanceNow
        float reclaimPts = pbReclaim ? 30.0 : 0.0
        float displacementPts = pbDisplacement ? 25.0 : 0.0
        float microPts = requireMicroBreak ? (pbMicroBreak ? 20.0 : 0.0) : 20.0
        float wickPts = 15.0 * wickRatio
        float closePts = 10.0 * closeQuality
        float acceptancePenalty = pbAcceptance ? 20.0 : 0.0
        pbReactionScore := math.max(0.0, math.min(100.0, reclaimPts + displacementPts + microPts + wickPts + closePts - acceptancePenalty))
        bool microPass = not requireMicroBreak or pbMicroBreak
        bool confirmEntry = pbReclaim and pbDisplacement and microPass and pbReactionScore >= minReactionScore and not hardInvalid
        if hardInvalid
            pbEntryDead := true
            pbEntryStatus := "INVALIDATED - AVOID"
            chartEntryInvalidNow := true
        else if confirmEntry
            pbEntryConfirmed := true
            pbEntryStatus := "ENTRY CONFIRMED"
            chartEntryConfirmedNow := true
        else if pbChartBarsAfterTouch >= maxReactionBars
            pbEntryDead := true
            pbEntryStatus := pbAcceptance ? "ACCEPTANCE / NO CONFIRMATION - AVOID" : "NO CONFIRMATION - AVOID"
            chartEntryTimedOutNow := true
        else if pbAcceptance
            pbEntryStatus := "ACCEPTANCE WARNING - WAIT/AVOID"
        else if pbReclaim or pbDisplacement or pbMicroBreak
            pbEntryStatus := "REJECTING - WAIT"
        else
            pbEntryStatus := "TESTING - WAIT"

// Keep current pullback label synchronized.
if showPullbackLabels and not na(pbLabel)
    int labelX = pbActive ? math.min(time_close, pbExpiryTime) : nz(pbEndTime, math.min(time_close, pbExpiryTime))
    label.set_text(pbLabel,
         f_pullbackText(pbDir, pbCandidateName, pbConfluence, pbBot, pbTop, pbRank,
              pbObservedRate, pbObservedReach, pbObservedHold, pbObservedN, pbStatus) +
              f_entryText(pbInvalidLevel, pbEntryStatus, pbReactionScore, pbReclaim, pbDisplacement, pbMicroBreak, pbWeakCloses, pbMicroLevel))
    label.set_x(pbLabel, labelX)
    label.set_y(pbLabel, pbDir == 1 ? pbBot : pbTop)

// MTF status badge.
var table tfTable = table.new(position.top_right, 1, 1)
if barstate.islast
    if showTfBadge
        string badge = "Structure: " + structureTf + "\nReaction: chart " + timeframe.period +
             "\nHTF bars loaded: " + str.tostring(array.size(sCloseA))
        table.cell(tfTable, 0, 0, badge, text_color = color.white, bgcolor = color.new(rangeColor, 20))
    else
        table.clear(tfTable, 0, 0, 0, 0)

// ─────────────────────────────────────────────────────────────────────────────
// Plots / diagnostics
// ─────────────────────────────────────────────────────────────────────────────
plot(showTriggers ? sBreakUpLevel : na, "HTF Break Up Level", color = color.new(bullColor, 25), style = plot.style_linebr, linewidth = 1)
plot(showTriggers ? sBreakDownLevel : na, "HTF Break Down Level", color = color.new(bearColor, 25), style = plot.style_linebr, linewidth = 1)
plotshape(showProbes and probeOpened and probeOpenDir == 1, "HTF Probe Up", style = shape.triangleup, location = location.abovebar, color = color.new(bullColor, 30), size = size.tiny)
plotshape(showProbes and probeOpened and probeOpenDir == -1, "HTF Probe Down", style = shape.triangledown, location = location.belowbar, color = color.new(bearColor, 30), size = size.tiny)

plot(brokeUp ? 1.0 : brokeDown ? -1.0 : 0.0, "HTF Breakout Signal (+1/-1)", display = display.data_window)
plot(sBreakLevel, "Last HTF Break Level", display = display.data_window)
plot(sInRange ? sTop : na, "HTF Range Top", display = display.data_window)
plot(sInRange ? sBot : na, "HTF Range Bottom", display = display.data_window)
plot(sPocValue, "HTF POC", display = display.data_window)
plot(sVahValue, "HTF VAH", display = display.data_window)
plot(sValValue, "HTF VAL", display = display.data_window)
plot(float(sRangeScore), "HTF Range Score (0-6)", display = display.data_window)
plot(float(winLen), "HTF Detection Window", display = display.data_window)
plot(pbTop, "Pullback Zone Top", display = display.data_window)
plot(pbBot, "Pullback Zone Bottom", display = display.data_window)
plot(pbInvalidLevel, "Hard Invalidation Level", display = display.data_window)
plot(pbRank, "Pullback Relative Rank", display = display.data_window)
plot(pbReactionScore, "Chart-TF Reaction Score", display = display.data_window)
plot(pbEntryConfirmed ? 1.0 : 0.0, "Entry Confirmed", display = display.data_window)
plot(pbAcceptance ? 1.0 : 0.0, "Acceptance Warning", display = display.data_window)

// Alerts
alertcondition(rangeStarted, "HTF Range Started", "A new confirmed structure-timeframe range was detected")
alertcondition(rangeRefocused, "HTF Range Auto-Resized", "The confirmed HTF range resized to the latest nested shelf")
alertcondition(probeOpened and probeOpenDir == 1, "HTF Probe Up", "A confirmed structure-timeframe candle probed above the range")
alertcondition(probeOpened and probeOpenDir == -1, "HTF Probe Down", "A confirmed structure-timeframe candle probed below the range")
alertcondition(brokeUp, "HTF Bullish Range Breakout", "A confirmed structure-timeframe bullish breakout occurred")
alertcondition(brokeDown, "HTF Bearish Range Breakout", "A confirmed structure-timeframe bearish breakout occurred")
alertcondition(pullbackZoneStarted, "HTF Pullback Zone Predicted", "A new most-likely HTF supply/demand or support/resistance pullback zone was ranked")
alertcondition(pullbackZoneTouched, "Pullback Zone Reached", "Price reached the predicted HTF pullback zone")
alertcondition(pullbackZoneReacted, "Pullback Zone Reacted", "Price reached the HTF pullback zone and reacted")
alertcondition(pullbackZoneFailed, "Pullback Zone Invalidated", "Price closed beyond the HTF pullback zone hard invalidation")
alertcondition(pullbackZoneExpired, "Pullback Zone Expired", "The HTF pullback zone reached its evaluation horizon")
alertcondition(chartAcceptanceWarningNow, "Chart-TF Acceptance Warning", "Closed chart-timeframe candles are accepting too deeply through the HTF pullback zone")
alertcondition(chartEntryConfirmedNow, "Chart-TF Pullback Entry Confirmed", "The chart timeframe confirmed rejection/reclaim/displacement at the frozen HTF zone")
alertcondition(chartEntryInvalidNow, "Chart-TF Hard Invalidation", "A closed chart-timeframe candle closed beyond the frozen HTF hard-invalidation level")
alertcondition(chartEntryTimedOutNow, "Chart-TF No Confirmation", "The HTF zone was tested but did not confirm within the configured chart-bar limit")
