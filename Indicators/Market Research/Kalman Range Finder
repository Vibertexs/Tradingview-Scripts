//@version=6
// Range Finder [Kalman] v5.3 — Adaptive Single Range
//
// This is a targeted sensitivity tune of the original v5, not a redesign.
//
// Changes:
//   1. Range Size now has much more resolution at the small end:
//        old: 1 ~13 bars, 5 ~31, 10 ~93
//        new: 1 ~6 bars,  5 ~20, 10 ~93
//      The large end is intentionally preserved.
//
//   2. Sensitivity 7+ may accept 4/6 range tests instead of waiting until 8.
//      This removes the old abrupt 7 -> 8 frequency jump.
//
//   3. The current close may sit closer to a range edge during detection
//      (1% edge exclusion instead of 3%).
//
//   4. Break-to-new-range cooldown is reduced from 5 bars to 3.
//
//   5. The single live range automatically RESIZES to the latest confirmed
//      nested shelf. No second overlapping box is created. The existing box moves
//      forward to the newest boundaries.
//
//   6. Optional adaptation marks are drawn ONLY when a resize actually occurs.
//      Each mark is a short old-boundary -> new-boundary connector on that bar;
//      nothing is carried forward into later bars or later ranges.
//
//      There is still only one detector and one live range.
//
// Everything else — Kalman filter, range score, probe/confirmation split,
// wick absorption, escape logic, profile, outputs, and drawing style — stays
// aligned with the original.
//
// CC BY-NC-SA 4.0
// https://creativecommons.org/licenses/by-nc-sa/4.0/

indicator("Range Finder [Kalman] v5.3 - Adaptive Range", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_lines_count = 500, max_bars_back = 750)

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
var string G_CORE = "Range Detection"
var string G_BRK  = "Breakout"
var string G_PROF = "Value Area Profile"
var string G_STY  = "Style"

rangeSize        = input.int(5, "Range Size", minval = 1, maxval = 10, group = G_CORE,
     tooltip = "How big a structure counts as a range. Small-end resolution is increased: 1 is ~6 bars, 5 is ~20, 10 is ~93. Lower values now pick up short shelves that the original 13-bar minimum could miss.")
rangeSensitivity = input.int(7, "Range Sensitivity", minval = 1, maxval = 10, group = G_CORE,
     tooltip = "How readily a range is accepted at that scale. Higher finds more ranges, lower requires cleaner ones. Independent of Range Size.")

adaptiveResize = input.bool(true, "Auto Resize To Latest Shelf", group = G_CORE,
     tooltip = "While a range is live, automatically move that SAME range box to the latest confirmed nested shelf. No overlapping replacement box is created. The range can tighten and shift inward as newer consolidation structure becomes available.")

absorbProbes = input.bool(true, "Absorb Rejected Probes", group = G_BRK,
     tooltip = "A wick or close that pushes past the boundary and comes back moves the boundary to where price was rejected. Off, ranges break far more often.")
escapePct    = input.float(15.0, "Breakout Escape (% of range)", minval = 2.0, maxval = 60.0, step = 1.0, group = G_BRK,
     tooltip = "How far past the boundary a close must travel to confirm a break, as a share of range height.")

escapeCapAtr = input.float(1.50, "Breakout Escape Cap (ATR)", minval = 0.0, maxval = 5.0, step = 0.25, group = G_BRK,
     tooltip = "Confirms a break once price is this far past the boundary even if the % test is not met. 0 disables.")
showTriggers = input.bool(true, "Show Trigger Levels", group = G_BRK,
     tooltip = "Draws the exact prices a break confirms at, on every bar the range is live.")
showProbes   = input.bool(true, "Show Probe Markers", group = G_BRK,
     tooltip = "Triangle on the first close outside the range. Fast trigger, not a confirmed verdict.")

profileBasis   = input.string("Time (TPO)", "Profile Basis", options = ["Off", "Time (TPO)", "Volume"], group = G_PROF,
     tooltip = "Time counts bars per price level and works everywhere. Volume is only meaningful where volume is real.")
profileRows    = input.int(24, "Profile Rows", minval = 6, maxval = 100, group = G_PROF)
valueAreaPct   = input.float(70.0, "Value Area %", minval = 30.0, maxval = 95.0, step = 5.0, group = G_PROF)

showBoxes           = input.bool(true, "Show Range Boxes", group = G_STY)
showAdaptationTrace = input.bool(true, "Show Adaptation Moves", group = G_STY,
     tooltip = "Draws a short connector only when the live box actually resizes: old top -> new top and old bottom -> new bottom. Nothing extends between ranges.")
showBreakLabels     = input.bool(true, "Show Breakout Labels", group = G_STY)
boxTransp       = input.int(90, "Range Fill Transparency", minval = 0, maxval = 100, group = G_STY)
rangeColor      = input.color(#787B86, "Range", group = G_STY)
profileColor    = input.color(#F2B705, "POC / Value Area", group = G_STY)
bullColor       = input.color(#26A69A, "Bullish Breakout", group = G_STY)
bearColor       = input.color(#EF5350, "Bearish Breakout", group = G_STY)

// ─────────────────────────────────────────────────────────────────────────────
// Constants
// ─────────────────────────────────────────────────────────────────────────────
float MAX_GROWTH       = 2.00
float WICK_ABSORB_ATR  = 1.00
float BACKFILL_TOL_ATR = 0.25
int   MIN_PROBE_BARS   = 2
int   COOLDOWN_BARS    = 3    // tuned from 5: permits quicker recognition of a new shelf
float KALMAN_WEIGHT    = 0.40
int   PROFILE_MAX_BARS = 500

// ─────────────────────────────────────────────────────────────────────────────
// Scale — same 10-point knob, but much more resolution at the small end.
//
// Geometric interpolation keeps Range Size 10 at ~93 bars while moving
// Range Size 1 from ~13 bars to ~6.
//   1=6, 2=8, 3=11, 4=15, 5=20, 6=28, 7=37, 8=51, 9=69, 10=93
// ─────────────────────────────────────────────────────────────────────────────
float z = float(rangeSize)
float scalePos = (z - 1.0) / 9.0
int winLen = int(math.round(6.0 * math.pow(93.0 / 6.0, scalePos)))

int anchorLookback = math.min(500, winLen * 8)
int confirmWindow  = math.max(6, int(math.round(winLen * 0.33)))
float escapeFrac   = escapePct / 100.0

// ─────────────────────────────────────────────────────────────────────────────
// Detection thresholds — Range Sensitivity only
// ─────────────────────────────────────────────────────────────────────────────
float s = float(rangeSensitivity)

float maxEfficiency = 0.14  + s * 0.032
float maxAtrRatio   = 0.80  + s * 0.050
float minOverlap    = 0.68  - s * 0.038
float maxSlopeAtr   = 0.018 + s * 0.011
float maxDrift      = 0.30  + s * 0.035

float widthK = 1.375

int   confirmBars    = rangeSensitivity >= 9 ? 2 : rangeSensitivity >= 6 ? 3 : rangeSensitivity >= 3 ? 4 : 5
float breakBufferAtr = rangeSensitivity >= 9 ? 0.10 : rangeSensitivity >= 6 ? 0.15 : 0.20

// ─────────────────────────────────────────────────────────────────────────────
// Measurements
// ─────────────────────────────────────────────────────────────────────────────
float atr         = ta.atr(14)
float atrSafe     = math.max(atr, syminfo.mintick)
float atrBaseline = ta.sma(atr, 50)
float atrRatio    = atr / math.max(nz(atrBaseline, atr), syminfo.mintick)

float rollingTop    = ta.highest(high, winLen)
float rollingBottom = ta.lowest(low, winLen)
float rollingWidth  = math.max(rollingTop - rollingBottom, syminfo.mintick)
float widthAtr      = rollingWidth / atrSafe

float path       = ta.sma(math.abs(close - close[1]), winLen) * winLen
float efficiency = math.abs(close - close[winLen]) / math.max(path, syminfo.mintick)

float lrNow      = ta.linreg(close, winLen, 0)
float lrPrev     = ta.linreg(close, winLen, 1)
float lrSlopeAtr = math.abs(lrNow - lrPrev) / atrSafe

float overlapAmount = math.max(0.0, math.min(high, high[1]) - math.max(low, low[1]))
float overlapBase   = math.max(math.min(high - low, high[1] - low[1]), syminfo.mintick)
float barOverlap    = math.min(1.0, overlapAmount / overlapBase)
float avgOverlap    = ta.sma(barOverlap, winLen)

float driftRatio      = math.abs(close - close[winLen]) / rollingWidth
float positionInRange = (close - rollingBottom) / rollingWidth
bool  notPinnedToEdge = positionInRange > 0.01 and positionInRange < 0.99

// ─────────────────────────────────────────────────────────────────────────────
// Kalman level + velocity filter
// ─────────────────────────────────────────────────────────────────────────────
float qLevel    = math.pow(atrSafe * (0.020 + s * 0.002), 2)
float qVelocity = math.pow(atrSafe * (0.004 + s * 0.0007), 2)
float rMeasure  = math.pow(atrSafe * 0.80, 2)

var float kLevel    = na
var float kVelocity = 0.0
var float p00 = 1.0
var float p01 = 0.0
var float p10 = 0.0
var float p11 = 1.0

if na(kLevel)
    kLevel    := close
    kVelocity := 0.0
    p00 := rMeasure
    p01 := 0.0
    p10 := 0.0
    p11 := rMeasure
else
    float predLevel    = kLevel + kVelocity
    float predVelocity = kVelocity

    float pp00 = p00 + p01 + p10 + p11 + qLevel
    float pp01 = p01 + p11
    float pp10 = p10 + p11
    float pp11 = p11 + qVelocity

    float innovation         = close - predLevel
    float innovationVariance = math.max(pp00 + rMeasure, syminfo.mintick * syminfo.mintick)
    float gainLevel          = pp00 / innovationVariance
    float gainVelocity       = pp10 / innovationVariance

    kLevel    := predLevel + gainLevel * innovation
    kVelocity := predVelocity + gainVelocity * innovation

    p00 := (1.0 - gainLevel) * pp00
    p01 := (1.0 - gainLevel) * pp01
    p10 := pp10 - gainVelocity * pp00
    p11 := pp11 - gainVelocity * pp01

float kalmanSlopeAtr   = math.abs(kVelocity) / atrSafe
float kalmanDriftRatio = not na(kLevel[winLen]) ? math.abs(kLevel - kLevel[winLen]) / rollingWidth : driftRatio

float slopeAtr     = lrSlopeAtr * (1.0 - KALMAN_WEIGHT) + kalmanSlopeAtr * KALMAN_WEIGHT
float blendedDrift = driftRatio * (1.0 - KALMAN_WEIGHT) + kalmanDriftRatio * KALMAN_WEIGHT

// ─────────────────────────────────────────────────────────────────────────────
// Range score
// ─────────────────────────────────────────────────────────────────────────────
int rangeScore =
     (efficiency   <= maxEfficiency                ? 1 : 0) +
     (atrRatio     <= maxAtrRatio                  ? 1 : 0) +
     (widthAtr     <= widthK * math.sqrt(winLen)   ? 1 : 0) +
     (avgOverlap   >= minOverlap                   ? 1 : 0) +
     (slopeAtr     <= maxSlopeAtr                  ? 1 : 0) +
     (blendedDrift <= maxDrift                     ? 1 : 0)

// Original required Sensitivity 8 before dropping from 5/6 to 4/6.
// Moving that transition to 7 makes the default materially more responsive
// without changing any individual measurement or inventing a new score.
int  requiredScore  = rangeSensitivity >= 7 ? 4 : 5
bool rangeCandidate = rangeScore >= requiredScore and notPinnedToEdge and not na(close[winLen])

var int candidateStreak = 0
candidateStreak := rangeCandidate ? candidateStreak + 1 : 0
bool confirmedRangeCandidate = candidateStreak >= confirmBars

// ─────────────────────────────────────────────────────────────────────────────
// State
// ─────────────────────────────────────────────────────────────────────────────
var bool  inRange = false
var float rTop    = na
var float rBot    = na
var float rSeedW  = na
var int   rLeft   = na
var int   rRight  = na
var int   rejects = 0
var box   rBox    = na

var int   probeDir  = 0
var int   probeBars = 0
var float probeExt  = na

var int   lastBreakBar = na
var float breakLevel   = na

var line  pocLine  = na
var line  vahLine  = na
var line  valLine  = na
var float pocValue = na
var float vahValue = na
var float valValue = na

// ─────────────────────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────────────────────
f_widthCap(nBars) =>
    widthK * math.sqrt(math.max(nBars, winLen)) * atrSafe

f_fits(hiEdge, loEdge, nBars, seedW) =>
    float w = hiEdge - loEdge
    w > 0 and w <= f_widthCap(nBars) and (na(seedW) or w <= seedW * MAX_GROWTH)

f_backfill(top0, bot0, doIt) =>
    int   startBar = bar_index
    float top = top0
    float bot = bot0
    float tol = atrSafe * BACKFILL_TOL_ATR
    if doIt
        bool stop = false
        for i = 1 to anchorLookback
            if not stop and i <= bar_index
                if math.abs(close[i] - close[i + winLen]) > (top0 - bot0) * maxDrift
                    stop := true
                else if close[i] <= top0 + tol and close[i] >= bot0 - tol
                    startBar := bar_index - i
                    top := math.max(top, math.min(high[i], top0 + atrSafe))
                    bot := math.min(bot, math.max(low[i],  bot0 - atrSafe))
                else
                    stop := true
    int   floorBar  = math.max(0, nz(lastBreakBar, -1) + 1)
    int   windowBar = math.max(0, bar_index - winLen + 1)
    startBar := math.max(math.min(startBar, windowBar), floorBar)
    int   bars   = bar_index - startBar + 1
    float noSeed = na
    if not f_fits(top, bot, bars, noSeed)
        top      := top0
        bot      := bot0
        startBar := math.max(floorBar, windowBar)
    [startBar, top, bot]

f_profile(backFrom, backTo, topP, botP, rows, vaFrac, useVol, doIt) =>
    float pocP = na
    float vahP = na
    float valP = na
    float h    = (topP - botP) / rows
    int   hi   = math.min(backTo, PROFILE_MAX_BARS)
    if doIt and h > 0 and hi >= backFrom and backFrom >= 0
        array<float> w = array.new_float(rows, 0.0)
        for k = backFrom to hi
            float bh = math.min(high[k], topP)
            float bl = math.max(low[k],  botP)
            if bh >= bl
                int i0 = math.max(0, math.min(rows - 1, int((bl - botP) / h)))
                int i1 = math.max(0, math.min(rows - 1, int((bh - botP) / h)))
                float unit = (useVol ? nz(volume[k], 0.0) : 1.0) / float(i1 - i0 + 1)
                for r = i0 to i1
                    array.set(w, r, array.get(w, r) + unit)
        float total = array.sum(w)
        if total > 0
            int   poc    = array.indexof(w, array.max(w))
            int   up     = poc
            int   dn     = poc
            float acc    = array.get(w, poc)
            float target = total * vaFrac
            while acc < target and (up < rows - 1 or dn > 0)
                float a = up < rows - 1 ? array.get(w, up + 1) : -1.0
                float b = dn > 0        ? array.get(w, dn - 1) : -1.0
                if a >= b
                    up  += 1
                    acc += a
                else
                    dn  -= 1
                    acc += b
            pocP := botP + (poc + 0.5) * h
            vahP := botP + (up + 1) * h
            valP := botP + dn * h
    [pocP, vahP, valP]

// ─────────────────────────────────────────────────────────────────────────────
// Lifecycle
// ─────────────────────────────────────────────────────────────────────────────
bool rangeStarted   = false
bool rangeRefocused = false
bool brokeUp        = false
bool brokeDown      = false
bool probeOpened    = false
int  probeOpenDir   = 0

float buf = atr * breakBufferAtr

if inRange
    int  rBars  = bar_index - rLeft + 1
    bool cAbove = close > rTop + buf
    bool cBelow = close < rBot - buf

    if absorbProbes and close < rTop and high > rTop and high - rTop <= atrSafe * WICK_ABSORB_ATR and f_fits(high, rBot, rBars, rSeedW)
        rTop := high
    if absorbProbes and close > rBot and low < rBot and rBot - low <= atrSafe * WICK_ABSORB_ATR and f_fits(rTop, low, rBars, rSeedW)
        rBot := low

    if cAbove or cBelow
        int d = cAbove ? 1 : -1
        if probeDir == d
            probeBars += 1
            probeExt  := d == 1 ? math.max(probeExt, high) : math.min(probeExt, low)
        else
            probeDir  := d
            probeBars := 1
            probeExt  := d == 1 ? high : low
            probeOpened  := true
            probeOpenDir := d

        float span      = math.max(rTop - rBot, syminfo.mintick)
        float dist      = d == 1 ? close - rTop : rBot - close
        bool  escapeHit = dist / span >= escapeFrac or (escapeCapAtr > 0 and dist / atrSafe >= escapeCapAtr)

        if (probeBars >= MIN_PROBE_BARS and escapeHit) or probeBars >= confirmWindow
            brokeUp      := d == 1
            brokeDown    := d == -1
            breakLevel   := d == 1 ? rTop : rBot
            inRange      := false
            lastBreakBar := bar_index
            candidateStreak := 0
            probeDir  := 0
            probeBars := 0
            probeExt  := na
    else
        if probeDir != 0
            rejects += 1
            if absorbProbes and probeDir == 1 and f_fits(math.max(rTop, probeExt), rBot, rBars, rSeedW)
                rTop := math.max(rTop, probeExt)
            if absorbProbes and probeDir == -1 and f_fits(rTop, math.min(rBot, probeExt), rBars, rSeedW)
                rBot := math.min(rBot, probeExt)
            probeDir  := 0
            probeBars := 0
            probeExt  := na
        rRight := bar_index

// ─────────────────────────────────────────────────────────────────────────────
// Adaptive resize to the latest shelf
//
// The old version froze the broad box and created a second smaller box. That made
// the chart show overlapping ranges. This version keeps ONE live range only.
//
// Once the same detector confirms a newer rolling shelf fully inside the current
// range, the CURRENT box is resized to that latest shelf. Because rTop/rBot are
// normal series values, the optional step-line traces below preserve the old
// boundaries historically even though the box itself moves.
// ─────────────────────────────────────────────────────────────────────────────
float liveWidth = inRange ? math.max(rTop - rBot, syminfo.mintick) : na

bool latestShelfInside = inRange and
     rollingTop <= rTop and rollingBottom >= rBot and
     (rollingTop < rTop or rollingBottom > rBot)

bool canRefocus = adaptiveResize and inRange and probeDir == 0 and
     confirmedRangeCandidate and latestShelfInside and
     (bar_index - rLeft + 1) >= winLen

if canRefocus
    // Capture the old boundaries before moving the SAME live box.
    float oldTop = rTop
    float oldBot = rBot

    // Remove the CURRENT profile drawings before resizing. They belonged to the
    // previous dimensions of this same live range and would otherwise visually
    // overlap the freshly-sized profile.
    if not na(pocLine)
        line.delete(pocLine)
        pocLine := na
    if not na(vahLine)
        line.delete(vahLine)
        vahLine := na
    if not na(valLine)
        line.delete(valLine)
        valLine := na

    pocValue := na
    vahValue := na
    valValue := na

    int floorBar = math.max(0, nz(lastBreakBar, -1) + 1)

    // Resize the SAME live range to the latest confirmed rolling shelf.
    // rBox is deliberately NOT deleted or replaced here. The normal drawing
    // update below moves its left/top/bottom/right coordinates in-place.
    rLeft   := math.max(floorBar, bar_index - winLen + 1)
    rTop    := rollingTop
    rBot    := rollingBottom
    rRight  := bar_index
    rSeedW  := rollingWidth
    rejects := 0

    // Event-only adaptation marks. These exist ONLY on the resize bar and show
    // how each boundary moved. They do not extend through the life of the range
    // and cannot bridge into the next range.
    if showAdaptationTrace
        if rTop != oldTop
            line.new(bar_index - 1, oldTop, bar_index, rTop,
                 xloc = xloc.bar_index,
                 extend = extend.none,
                 color = color.new(rangeColor, 0),
                 width = 2)
        if rBot != oldBot
            line.new(bar_index - 1, oldBot, bar_index, rBot,
                 xloc = xloc.bar_index,
                 extend = extend.none,
                 color = color.new(rangeColor, 0),
                 width = 2)

    probeDir  := 0
    probeBars := 0
    probeExt  := na

    // Require a fresh confirmation streak before another resize. This prevents
    // the box from jittering inward on every single bar.
    candidateStreak := 0
    rangeRefocused := true

bool cooldownReady = na(lastBreakBar) or bar_index - lastBreakBar > COOLDOWN_BARS
bool wantSeed      = not inRange and not (brokeUp or brokeDown) and confirmedRangeCandidate and cooldownReady

[sb, st, sb2] = f_backfill(rollingTop, rollingBottom, wantSeed)

if wantSeed
    inRange := true
    rLeft   := sb
    rTop    := st
    rBot    := sb2
    rRight  := bar_index
    rSeedW  := st - sb2
    rejects := 0
    rBox    := na
    pocLine := na
    vahLine := na
    valLine := na
    pocValue := na
    vahValue := na
    valValue := na
    rangeStarted := true
    probeDir  := 0
    probeBars := 0
    probeExt  := na

    // A new seed should earn its own confirmation streak before it can refocus.
    candidateStreak := 0

// ─────────────────────────────────────────────────────────────────────────────
// Profile
// ─────────────────────────────────────────────────────────────────────────────
bool profileOn = profileBasis != "Off"
bool profileDue = (inRange and barstate.islast) or brokeUp or brokeDown
bool doProfile  = profileOn and not na(rTop) and not na(rLeft) and profileDue

[pocP, vahP, valP] = f_profile(math.max(0, bar_index - rRight), math.max(0, bar_index - rLeft),
     rTop, rBot, profileRows, valueAreaPct / 100.0, profileBasis == "Volume", doProfile)

if doProfile and not na(pocP)
    pocValue := pocP
    vahValue := vahP
    valValue := valP
    if na(pocLine)
        pocLine := line.new(rLeft, pocP, rRight, pocP, xloc = xloc.bar_index,
             color = profileColor, width = 2)
        vahLine := line.new(rLeft, vahP, rRight, vahP, xloc = xloc.bar_index,
             color = color.new(profileColor, 40), width = 1, style = line.style_dotted)
        valLine := line.new(rLeft, valP, rRight, valP, xloc = xloc.bar_index,
             color = color.new(profileColor, 40), width = 1, style = line.style_dotted)
    else
        line.set_xy1(pocLine, rLeft, pocP)
        line.set_xy2(pocLine, rRight, pocP)
        line.set_xy1(vahLine, rLeft, vahP)
        line.set_xy2(vahLine, rRight, vahP)
        line.set_xy1(valLine, rLeft, valP)
        line.set_xy2(valLine, rRight, valP)

// ─────────────────────────────────────────────────────────────────────────────
// Drawing
// ─────────────────────────────────────────────────────────────────────────────
if showBoxes and inRange
    if na(rBox)
        rBox := box.new(rLeft, rTop, rRight, rBot,
             xloc         = xloc.bar_index,
             bgcolor      = color.new(rangeColor, boxTransp),
             border_color = color.new(rangeColor, 15),
             border_style = line.style_solid,
             border_width = 1)
    else
        box.set_left(rBox,   rLeft)
        box.set_right(rBox,  rRight)
        box.set_top(rBox,    rTop)
        box.set_bottom(rBox, rBot)

if brokeUp or brokeDown
    if not na(rBox)
        color bc = brokeUp ? bullColor : bearColor
        box.set_right(rBox, rRight)
        box.set_border_color(rBox, bc)
        box.set_bgcolor(rBox, color.new(bc, 94))
        rBox := na
    pocLine := na
    vahLine := na
    valLine := na

if showBreakLabels and (brokeUp or brokeDown)
    label.new(bar_index, breakLevel,
         brokeUp ? "Bull break" : "Bear break",
         xloc      = xloc.bar_index,
         yloc      = yloc.price,
         style     = brokeUp ? label.style_label_up : label.style_label_down,
         color     = color.new(brokeUp ? bullColor : bearColor, 10),
         textcolor = color.white,
         size      = size.tiny)

if not showBoxes and not na(rBox)
    box.delete(rBox)
    rBox := na

// ─────────────────────────────────────────────────────────────────────────────
// Entry aids
// ─────────────────────────────────────────────────────────────────────────────
float breakUpLevel   = inRange ? rTop + buf : na
float breakDownLevel = inRange ? rBot - buf : na

plot(showTriggers ? breakUpLevel : na,   "Break Up Level",
     color = color.new(bullColor, 25), style = plot.style_linebr, linewidth = 1)
plot(showTriggers ? breakDownLevel : na, "Break Down Level",
     color = color.new(bearColor, 25), style = plot.style_linebr, linewidth = 1)

plotshape(showProbes and probeOpened and probeOpenDir ==  1, "Probe Up",
     style = shape.triangleup,   location = location.abovebar,
     color = color.new(bullColor, 30), size = size.tiny)
plotshape(showProbes and probeOpened and probeOpenDir == -1, "Probe Down",
     style = shape.triangledown, location = location.belowbar,
     color = color.new(bearColor, 30), size = size.tiny)

// ─────────────────────────────────────────────────────────────────────────────
// Strategy outputs and diagnostics
// ─────────────────────────────────────────────────────────────────────────────
plot(brokeUp ? 1.0 : brokeDown ? -1.0 : 0.0, "Breakout Signal (+1/-1)", display = display.data_window)
plot(probeOpened ? float(probeOpenDir) : 0.0, "Probe Signal (+1/-1)", display = display.data_window)
plot(breakUpLevel,   "Break Up Level (value)",   display = display.data_window)
plot(breakDownLevel, "Break Down Level (value)", display = display.data_window)
plot(breakLevel,          "Last Break Level", display = display.data_window)
plot(inRange ? rTop : na, "Range Top",        display = display.data_window)
plot(inRange ? rBot : na, "Range Bottom",     display = display.data_window)
plot(pocValue,            "POC",              display = display.data_window)
plot(vahValue,            "VAH",              display = display.data_window)
plot(valValue,            "VAL",              display = display.data_window)
plot(inRange ? 1.0 : 0.0, "In Range",         display = display.data_window)
plot(float(winLen),       "Detection Window", display = display.data_window)
plot(float(probeBars),    "Bars Outside",     display = display.data_window)
plot(float(rejects),      "Rejected Probes",  display = display.data_window)
plot(float(rangeScore),   "Range Score (0-6)", display = display.data_window)
plot(inRange ? float(bar_index - rLeft + 1) : 0.0, "Range Age (bars)",  display = display.data_window)
plot(inRange ? (rTop - rBot) / atrSafe : 0.0,      "Range Width (ATR)", display = display.data_window)
plot(rangeRefocused ? 1.0 : 0.0, "Range Auto-Resized", display = display.data_window)

alertcondition(rangeStarted, "Range Started", "A new price range was detected")
alertcondition(rangeRefocused, "Range Auto-Resized", "The active range resized to the latest confirmed nested shelf")
alertcondition(probeOpened and probeOpenDir ==  1, "Probe Up (fast)",   "Price closed above the range - fast trigger, not yet confirmed")
alertcondition(probeOpened and probeOpenDir == -1, "Probe Down (fast)", "Price closed below the range - fast trigger, not yet confirmed")
alertcondition(brokeUp,      "Bullish Range Breakout", "Price confirmed above the range")
alertcondition(brokeDown,    "Bearish Range Breakout", "Price confirmed below the range")
