//@version=6

// Swing Structure Bias [v10 - Adaptive Sensitivity]

// Derived from "Trend Angle Momentum [MarkitTick]" supplied by the user.

// Box behavior is inspired by the user's supplied "Sessions [LuxAlgo]" script.

// Swing filtering follows the general confirmed-pivot + alternating ZigZag approach

// documented by TradingView, with an added ATR significance filter.

// Fast swing dots use the filtered ZigZag engine, while box direction uses an

// adaptive structure engine that becomes progressively faster as sensitivity rises.

//

// Source scripts supplied by the user are CC BY-NC-SA 4.0; this derivative is

// provided under the same license.

// https://creativecommons.org/licenses/by-nc-sa/4.0/

indicator("Swing Structure Bias [v10 - Adaptive Sensitivity]", overlay = true, max_boxes_count = 500, max_labels_count = 500)

// ─────────────────────────────────────────────────────────────────────────────

// Inputs

// ─────────────────────────────────────────────────────────────────────────────

var string G_CORE   = "Core"
var string G_STYLE  = "Style"

// Keep the user-facing menu small. The stable/default values below are
// intentionally fixed so the indicator stays easy to tune.
int pivotLegs = 3
int atrLength = 14
int atrFloorLength = 50
float atrFloorMult = 0.80
float minReversalPct = 0.00
bool useBodyBreaks = true
float structureBreakAtr = 0.00
bool showSwingText = false
bool showStructuralSwingPoints = false
color rangeColor = #808080

minReversalAtr = input.float(0.80, "Swing Filter (ATR)", minval = 0.0, step = 0.05, group = G_CORE,
     tooltip = "Controls how large a reversal must be before a fast swing dot is accepted. Higher = fewer swing dots.")

structureSensitivity = input.int(5, "Structure Sensitivity", minval = 1, maxval = 10, group = G_CORE,
     tooltip = "1 = very stable/slow, 5 = balanced, 10 = very tight/fast. At high settings the boxes use fast filtered or raw pivots directly instead of waiting for the slow two-stage structure engine.")

// Sensitivity changes the actual regime engine, not just the swing dots.
// 1-4  = slow structural swings + two-stage CHoCH/BOS confirmation
// 5-7  = shorter structural swings + direct opposite break
// 8-9  = filtered fast swings + direct opposite break
// 10   = raw confirmed pivots + direct opposite break
int structureSwingLength = structureSensitivity == 1 ? 80 : structureSensitivity == 2 ? 65 : structureSensitivity == 3 ? 50 : structureSensitivity == 4 ? 40 : structureSensitivity == 5 ? 30 : structureSensitivity == 6 ? 22 : structureSensitivity == 7 ? 14 : structureSensitivity == 8 ? 12 : structureSensitivity == 9 ? 10 : 8
bool useTwoStageStructure = structureSensitivity <= 4
bool useSlowDirectStructure = structureSensitivity >= 5 and structureSensitivity <= 7
bool useFilteredFastStructure = structureSensitivity >= 8 and structureSensitivity <= 9
bool useRawFastStructure = structureSensitivity == 10
float adaptiveBreakBufferAtr = structureSensitivity == 5 ? 0.20 : structureSensitivity == 6 ? 0.10 : structureSensitivity == 8 ? 0.15 : 0.00

showSwingPoints = input.bool(true, "Show Swing Points", group = G_CORE)
showStateBoxes = input.bool(true, "Show Structure Boxes", group = G_CORE)

boxTransparency = input.int(88, "Box Transparency", minval = 0, maxval = 100, group = G_STYLE)
bullColor = input.color(#089981, "Bullish", group = G_STYLE)
bearColor = input.color(#f23645, "Bearish", group = G_STYLE)

// ─────────────────────────────────────────────────────────────────────────────

// Helpers

// ─────────────────────────────────────────────────────────────────────────────

f_requiredMove(float fromPrice, float atrValue) =>

    float atrMove = nz(atrValue) * minReversalAtr

    float pctMove = math.abs(fromPrice) * minReversalPct / 100.0

    math.max(atrMove, pctMove)

f_stateText(int state) =>

    state == 1 ? "BULLISH" : state == -1 ? "BEARISH" : state == 2 ? "RANGE" : ""

f_stateColor(int state) =>

    state == 1 ? bullColor : state == -1 ? bearColor : rangeColor

f_highText(float price, float previousHigh) =>

    na(previousHigh) ? "SH" : price > previousHigh ? "HH" : "LH"

f_lowText(float price, float previousLow) =>

    na(previousLow) ? "SL" : price < previousLow ? "LL" : "HL"

f_makeSwingMarker(int swingType, int swingBar, float swingPrice, string swingText) =>

    label marker = na

    if showSwingPoints

        color pointColor = swingType == 1 ? bearColor : bullColor

        string markerText = showSwingText ? swingText : ""

        marker := label.new(

             x = swingBar,

             y = swingPrice,

             text = markerText,

             xloc = xloc.bar_index,

             yloc = yloc.price,

             style = label.style_circle,

             color = pointColor,

             textcolor = color.white,

             size = showSwingText ? size.small : size.tiny)

    marker

// ─────────────────────────────────────────────────────────────────────────────

// 1) Raw confirmed pivots

//

// A short pivot length gives responsive candidate points. We DO NOT use every

// candidate. The next section converts them into an alternating swing sequence.

// ─────────────────────────────────────────────────────────────────────────────

float rawHigh = ta.pivothigh(high, pivotLegs, pivotLegs)

float rawLow  = ta.pivotlow(low, pivotLegs, pivotLegs)

int rawPivotBar = bar_index - pivotLegs

// ATR regime filter: use normal ATR when volatility expands, but keep a slow
// baseline floor so the required swing move does not collapse in quiet chop.
float atrNow = ta.atr(atrLength)
float atrBaseline = ta.sma(atrNow, atrFloorLength)
float filteredAtr = math.max(atrNow, nz(atrBaseline, atrNow) * atrFloorMult)
float atrAtPivot = filteredAtr[pivotLegs]

// ─────────────────────────────────────────────────────────────────────────────

// 2) Filtered alternating swing engine

//

// Rules:

// • Highs and lows must alternate.

// • If another pivot of the SAME type appears before a valid reversal, only the

//   more extreme one survives. This removes double/triple tops of tiny pivots.

// • An opposite pivot is accepted only after a minimum ATR/% reversal.

//

// This is the key difference from v2, where independently detected highs/lows

// were paired together and could produce inconsistent structure boxes.

// ─────────────────────────────────────────────────────────────────────────────

var int zzType = 0                     // 1 = latest swing high, -1 = latest swing low

var float zzPrice = na

var int zzBar = na

var label zzMarker = na

var float lastHigh = na

var float prevHigh = na

var int lastHighBar = na

var int prevHighBar = na

var float lastLow = na

var float prevLow = na

var int lastLowBar = na

var int prevLowBar = na

var bool highLevelBroken = false

var bool lowLevelBroken = false

bool newAlternatingSwing = false

int newSwingType = 0

// Rare outside bars can qualify as both a raw high and raw low. For a clean

// structure map we prefer the candidate OPPOSITE the current ZigZag direction

// and do not create two structural pivots on the same candle.

bool candidateHigh = not na(rawHigh) and barstate.isconfirmed

bool candidateLow  = not na(rawLow) and barstate.isconfirmed

if candidateHigh and candidateLow

    if zzType == 1

        candidateHigh := false

    else if zzType == -1

        candidateLow := false

    else

        // No established direction yet: start with the side farther from close.

        float highDistance = math.abs(rawHigh - close[pivotLegs])

        float lowDistance = math.abs(close[pivotLegs] - rawLow)

        if highDistance >= lowDistance

            candidateLow := false

        else

            candidateHigh := false

// ----- High candidate ---------------------------------------------------------

if candidateHigh

    if zzType == 0

        zzType := 1

        zzPrice := rawHigh

        zzBar := rawPivotBar

        lastHigh := rawHigh

        lastHighBar := rawPivotBar

        highLevelBroken := false

        zzMarker := f_makeSwingMarker(1, zzBar, zzPrice, f_highText(zzPrice, prevHigh))

    else if zzType == 1

        // Same-side extension: keep only the more extreme high.

        if rawHigh > zzPrice

            zzPrice := rawHigh

            zzBar := rawPivotBar

            lastHigh := rawHigh

            lastHighBar := rawPivotBar

            highLevelBroken := false

            if not na(zzMarker)

                label.delete(zzMarker)

            zzMarker := f_makeSwingMarker(1, zzBar, zzPrice, f_highText(zzPrice, prevHigh))

    else

        // Opposite pivot: require a meaningful reversal from the last low.

        float requiredMove = f_requiredMove(zzPrice, atrAtPivot)

        if rawHigh - zzPrice >= requiredMove

            prevHigh := lastHigh

            prevHighBar := lastHighBar

            lastHigh := rawHigh

            lastHighBar := rawPivotBar

            zzType := 1

            zzPrice := rawHigh

            zzBar := rawPivotBar

            highLevelBroken := false

            zzMarker := f_makeSwingMarker(1, zzBar, zzPrice, f_highText(zzPrice, prevHigh))

            newAlternatingSwing := true

            newSwingType := 1

// ----- Low candidate ----------------------------------------------------------

if candidateLow

    if zzType == 0

        zzType := -1

        zzPrice := rawLow

        zzBar := rawPivotBar

        lastLow := rawLow

        lastLowBar := rawPivotBar

        lowLevelBroken := false

        zzMarker := f_makeSwingMarker(-1, zzBar, zzPrice, f_lowText(zzPrice, prevLow))

    else if zzType == -1

        // Same-side extension: keep only the more extreme low.

        if rawLow < zzPrice

            zzPrice := rawLow

            zzBar := rawPivotBar

            lastLow := rawLow

            lastLowBar := rawPivotBar

            lowLevelBroken := false

            if not na(zzMarker)

                label.delete(zzMarker)

            zzMarker := f_makeSwingMarker(-1, zzBar, zzPrice, f_lowText(zzPrice, prevLow))

    else

        // Opposite pivot: require a meaningful reversal from the last high.

        float requiredMove = f_requiredMove(zzPrice, atrAtPivot)

        if zzPrice - rawLow >= requiredMove

            prevLow := lastLow

            prevLowBar := lastLowBar

            lastLow := rawLow

            lastLowBar := rawPivotBar

            zzType := -1

            zzPrice := rawLow

            zzBar := rawPivotBar

            lowLevelBroken := false

            zzMarker := f_makeSwingMarker(-1, zzBar, zzPrice, f_lowText(zzPrice, prevLow))

            newAlternatingSwing := true

            newSwingType := -1

// ─────────────────────────────────────────────────────────────────────────────

// 3) Adaptive structural regime engine + true range detection
//
// Structure Sensitivity now changes the actual box engine:
//
//   1-4  Stable: slow structural legs + two-stage CHoCH -> new pivot -> BOS.
//   5-7  Balanced: shorter structural legs and an opposite close flips directly.
//   8-9  Fast: filtered ZigZag swings become the protected structure directly.
//   10   Tightest: raw confirmed pivots become the protected structure directly.
//
// RANGE stays separate from CHoCH. It is still created only by a contained
// filtered LH + HL pair, and its boundaries stay locked until a body-close exits.
// ─────────────────────────────────────────────────────────────────────────────

var int structureLeg = 0              // -1 = bearish leg from structural high, 1 = bullish leg from structural low
var float structuralHigh = na
var int structuralHighBar = na
var bool structuralHighCrossed = false

var float structuralLow = na
var int structuralLowBar = na
var bool structuralLowCrossed = false

var label structuralHighMarker = na
var label structuralLowMarker = na

// Raw-pivot structure used only at sensitivity 10.
var float rawStructureHigh = na
var int rawStructureHighBar = na
var bool rawStructureHighCrossed = false
var float rawStructureLow = na
var int rawStructureLowBar = na
var bool rawStructureLowCrossed = false

if not na(rawHigh) and barstate.isconfirmed
    rawStructureHigh := rawHigh
    rawStructureHighBar := rawPivotBar
    rawStructureHighCrossed := false

if not na(rawLow) and barstate.isconfirmed
    rawStructureLow := rawLow
    rawStructureLowBar := rawPivotBar
    rawStructureLowCrossed := false

// Confirmed regime and low-sensitivity two-stage reversal state.
var int structureState = 0            // 1 bull, -1 bear, 2 range, 0 warming up
var int pendingReversal = 0           // 1 = bullish CHoCH pending, -1 = bearish CHoCH pending
var int pendingReversalBar = na
var bool bullishConfirmationArmed = false
var bool bearishConfirmationArmed = false

// True range boundaries come from a contained pair of filtered fast swings.
var float rangeTop = na
var float rangeBottom = na

// Slow structural legs. These remain available for sensitivities 1-7.
bool newLegHigh = not na(high[structureSwingLength]) and high[structureSwingLength] > ta.highest(high, structureSwingLength)
bool newLegLow = not na(low[structureSwingLength]) and low[structureSwingLength] < ta.lowest(low, structureSwingLength)

int previousStructureLeg = structureLeg

if newLegHigh
    structureLeg := -1
else if newLegLow
    structureLeg := 1

bool newStructuralHigh = structureLeg == -1 and previousStructureLeg != -1
bool newStructuralLow = structureLeg == 1 and previousStructureLeg != 1

if newStructuralHigh
    structuralHigh := high[structureSwingLength]
    structuralHighBar := bar_index - structureSwingLength
    structuralHighCrossed := false

    // Only stable mode uses the second BOS confirmation.
    if useTwoStageStructure and pendingReversal == 1 and not na(pendingReversalBar) and structuralHighBar > pendingReversalBar
        bullishConfirmationArmed := true

    if showStructuralSwingPoints
        if not na(structuralHighMarker)
            label.delete(structuralHighMarker)
        structuralHighMarker := label.new(
             x = structuralHighBar,
             y = structuralHigh,
             text = useTwoStageStructure and pendingReversal == 1 and bullishConfirmationArmed ? "BOS H" : "SH",
             xloc = xloc.bar_index,
             yloc = yloc.price,
             style = label.style_circle,
             color = bearColor,
             textcolor = color.white,
             size = size.small)

if newStructuralLow
    structuralLow := low[structureSwingLength]
    structuralLowBar := bar_index - structureSwingLength
    structuralLowCrossed := false

    if useTwoStageStructure and pendingReversal == -1 and not na(pendingReversalBar) and structuralLowBar > pendingReversalBar
        bearishConfirmationArmed := true

    if showStructuralSwingPoints
        if not na(structuralLowMarker)
            label.delete(structuralLowMarker)
        structuralLowMarker := label.new(
             x = structuralLowBar,
             y = structuralLow,
             text = useTwoStageStructure and pendingReversal == -1 and bearishConfirmationArmed ? "BOS L" : "SL",
             xloc = xloc.bar_index,
             yloc = yloc.price,
             style = label.style_circle,
             color = bullColor,
             textcolor = color.white,
             size = size.small)

float bullBreakSource = useBodyBreaks ? close : high
float bearBreakSource = useBodyBreaks ? close : low

// Each sensitivity band gets its own protected levels.
float slowBuffer = filteredAtr * adaptiveBreakBufferAtr
bool slowBreakUp = not na(structuralHigh) and not structuralHighCrossed and bar_index > structuralHighBar and bullBreakSource > structuralHigh + slowBuffer
bool slowBreakDown = not na(structuralLow) and not structuralLowCrossed and bar_index > structuralLowBar and bearBreakSource < structuralLow - slowBuffer

float fastBuffer = filteredAtr * adaptiveBreakBufferAtr
bool filteredFastBreakUp = not na(lastHigh) and not highLevelBroken and bar_index > lastHighBar and bullBreakSource > lastHigh + fastBuffer
bool filteredFastBreakDown = not na(lastLow) and not lowLevelBroken and bar_index > lastLowBar and bearBreakSource < lastLow - fastBuffer

bool rawFastBreakUp = not na(rawStructureHigh) and not rawStructureHighCrossed and bar_index > rawStructureHighBar and bullBreakSource > rawStructureHigh
bool rawFastBreakDown = not na(rawStructureLow) and not rawStructureLowCrossed and bar_index > rawStructureLowBar and bearBreakSource < rawStructureLow

bool activeBreakUp = (useTwoStageStructure or useSlowDirectStructure) ? slowBreakUp : useFilteredFastStructure ? filteredFastBreakUp : rawFastBreakUp
bool activeBreakDown = (useTwoStageStructure or useSlowDirectStructure) ? slowBreakDown : useFilteredFastStructure ? filteredFastBreakDown : rawFastBreakDown

// Actual sideways/contained structure still comes from the filtered swings.
bool haveTwoFastHighs = not na(lastHigh) and not na(prevHigh)
bool haveTwoFastLows = not na(lastLow) and not na(prevLow)
bool fastHigherHigh = haveTwoFastHighs and lastHigh > prevHigh
bool fastLowerHigh = haveTwoFastHighs and lastHigh <= prevHigh
bool fastHigherLow = haveTwoFastLows and lastLow >= prevLow
bool fastLowerLow = haveTwoFastLows and lastLow < prevLow
bool fastInsidePattern = fastLowerHigh and fastHigherLow
bool actualRangeCandidate = structureState != 0 and structureState != 2 and newAlternatingSwing and fastInsidePattern and prevHigh > prevLow

bool rangeBreakUp = structureState == 2 and not na(rangeTop) and bullBreakSource > rangeTop
bool rangeBreakDown = structureState == 2 and not na(rangeBottom) and bearBreakSource < rangeBottom

int proposedState = structureState
float proposedRangeTop = rangeTop
float proposedRangeBottom = rangeBottom
bool stateChangeRequested = false
bool bullishChochCandidate = false
bool bearishChochCandidate = false
bool bullishBosConfirmed = false
bool bearishBosConfirmed = false

// RANGE always has first priority once active.
if structureState == 2
    if rangeBreakUp and not rangeBreakDown
        proposedState := 1
        proposedRangeTop := na
        proposedRangeBottom := na
        stateChangeRequested := true
        bullishBosConfirmed := true
        pendingReversal := 0
        pendingReversalBar := na
        bullishConfirmationArmed := false
        bearishConfirmationArmed := false

    else if rangeBreakDown and not rangeBreakUp
        proposedState := -1
        proposedRangeTop := na
        proposedRangeBottom := na
        stateChangeRequested := true
        bearishBosConfirmed := true
        pendingReversal := 0
        pendingReversalBar := na
        bullishConfirmationArmed := false
        bearishConfirmationArmed := false

else
    // Mark whichever protected level fired so the same level cannot trigger again.
    if activeBreakUp and not activeBreakDown
        if useTwoStageStructure or useSlowDirectStructure
            structuralHighCrossed := true
        else if useFilteredFastStructure
            highLevelBroken := true
        else
            rawStructureHighCrossed := true

    if activeBreakDown and not activeBreakUp
        if useTwoStageStructure or useSlowDirectStructure
            structuralLowCrossed := true
        else if useFilteredFastStructure
            lowLevelBroken := true
        else
            rawStructureLowCrossed := true

    // First directional classification.
    if structureState == 0
        if activeBreakUp and not activeBreakDown
            proposedState := 1
            stateChangeRequested := true
        else if activeBreakDown and not activeBreakUp
            proposedState := -1
            stateChangeRequested := true

        if stateChangeRequested
            pendingReversal := 0
            pendingReversalBar := na
            bullishConfirmationArmed := false
            bearishConfirmationArmed := false

    // Stable sensitivities 1-4 retain the deliberately slow two-stage reversal.
    else if useTwoStageStructure
        if activeBreakUp and not activeBreakDown
            if structureState == 1
                // Bullish continuation cancels an unfinished bearish reversal.
                if pendingReversal == -1
                    pendingReversal := 0
                    pendingReversalBar := na
                    bearishConfirmationArmed := false
            else
                // Current regime is bearish.
                if pendingReversal != 1
                    pendingReversal := 1
                    pendingReversalBar := bar_index
                    bullishConfirmationArmed := false
                    bearishConfirmationArmed := false
                    bullishChochCandidate := true
                else if bullishConfirmationArmed
                    proposedState := 1
                    proposedRangeTop := na
                    proposedRangeBottom := na
                    stateChangeRequested := true
                    bullishBosConfirmed := true
                    pendingReversal := 0
                    pendingReversalBar := na
                    bullishConfirmationArmed := false
                    bearishConfirmationArmed := false

        if activeBreakDown and not activeBreakUp
            if structureState == -1
                // Bearish continuation cancels an unfinished bullish reversal.
                if pendingReversal == 1
                    pendingReversal := 0
                    pendingReversalBar := na
                    bullishConfirmationArmed := false
            else
                // Current regime is bullish.
                if pendingReversal != -1
                    pendingReversal := -1
                    pendingReversalBar := bar_index
                    bearishConfirmationArmed := false
                    bullishConfirmationArmed := false
                    bearishChochCandidate := true
                else if bearishConfirmationArmed
                    proposedState := -1
                    proposedRangeTop := na
                    proposedRangeBottom := na
                    stateChangeRequested := true
                    bearishBosConfirmed := true
                    pendingReversal := 0
                    pendingReversalBar := na
                    bullishConfirmationArmed := false
                    bearishConfirmationArmed := false

    // Sensitivities 5-10 are genuinely reactive: one opposite protected-level
    // close is enough to reverse the box. What counts as the protected level gets
    // progressively faster as sensitivity rises.
    else
        if activeBreakUp and not activeBreakDown
            if structureState != 1
                proposedState := 1
                proposedRangeTop := na
                proposedRangeBottom := na
                stateChangeRequested := true
                bullishBosConfirmed := true
            pendingReversal := 0
            pendingReversalBar := na
            bullishConfirmationArmed := false
            bearishConfirmationArmed := false

        else if activeBreakDown and not activeBreakUp
            if structureState != -1
                proposedState := -1
                proposedRangeTop := na
                proposedRangeBottom := na
                stateChangeRequested := true
                bearishBosConfirmed := true
            pendingReversal := 0
            pendingReversalBar := na
            bullishConfirmationArmed := false
            bearishConfirmationArmed := false

    // True RANGE is independent of CHoCH. It only starts when no directional
    // break happened and the filtered structure forms a contained LH + HL pair.
    if not stateChangeRequested and not activeBreakUp and not activeBreakDown and actualRangeCandidate
        proposedState := 2
        proposedRangeTop := prevHigh
        proposedRangeBottom := prevLow
        stateChangeRequested := true
        pendingReversal := 0
        pendingReversalBar := na
        bullishConfirmationArmed := false
        bearishConfirmationArmed := false

bool stateChanged = stateChangeRequested and proposedState != structureState

if stateChanged
    structureState := proposedState
    rangeTop := proposedRangeTop
    rangeBottom := proposedRangeBottom

    if structureState != 2
        rangeTop := na
        rangeBottom := na

// ─────────────────────────────────────────────────────────────────────────────

// 4) Persistent phase boxes

//

// One continuous box per structural regime. Continuation BOS does not split it.

// RANGE is reserved for an actual contained LH + HL structure.

// CHoCH alone never creates a gray box, and fast internal swings never split directional boxes.

// ─────────────────────────────────────────────────────────────────────────────

var box activeBox = na

var float phaseTop = na

var float phaseBottom = na

if stateChanged

    if showStateBoxes and not na(activeBox)

        box.set_right(activeBox, bar_index)

    if showStateBoxes

        color phaseColor = f_stateColor(structureState)

        float newTop = structureState == 2 and not na(rangeTop) ? rangeTop : high

        float newBottom = structureState == 2 and not na(rangeBottom) ? rangeBottom : low

        phaseTop := newTop

        phaseBottom := newBottom

        activeBox := box.new(

             left = bar_index,

             top = newTop,

             right = bar_index,

             bottom = newBottom,

             xloc = xloc.bar_index,

             bgcolor = color.new(phaseColor, boxTransparency),

             border_color = phaseColor,

             border_style = line.style_dotted,

             border_width = 1,

             text = f_stateText(structureState),

             text_color = phaseColor,

             text_size = size.tiny,

             text_halign = text.align_left,

             text_valign = text.align_top)

if showStateBoxes and not na(activeBox)

    box.set_right(activeBox, bar_index)

    if structureState == 2 and not na(rangeTop) and not na(rangeBottom)
        phaseTop := rangeTop
        phaseBottom := rangeBottom
    else
        phaseTop := na(phaseTop) ? high : math.max(phaseTop, high)
        phaseBottom := na(phaseBottom) ? low : math.min(phaseBottom, low)

    box.set_top(activeBox, phaseTop)

    box.set_bottom(activeBox, phaseBottom)

// If boxes are disabled after one already exists, hide the active one rather

// than continuing to update it visibly.

if not showStateBoxes and not na(activeBox)

    box.delete(activeBox)

    activeBox := na

// ─────────────────────────────────────────────────────────────────────────────

// Alerts

// ─────────────────────────────────────────────────────────────────────────────

bool bullishStateChange = stateChanged and structureState == 1

bool bearishStateChange = stateChanged and structureState == -1
bool rangeStateChange = stateChanged and structureState == 2

alertcondition(bullishChochCandidate, "Bullish CHoCH Candidate", "Bullish CHoCH candidate formed; waiting for confirmation BOS")
alertcondition(bearishChochCandidate, "Bearish CHoCH Candidate", "Bearish CHoCH candidate formed; waiting for confirmation BOS")
alertcondition(bullishBosConfirmed, "Bullish Direction Confirmed", "Bullish direction confirmed by the active structure engine")
alertcondition(bearishBosConfirmed, "Bearish Direction Confirmed", "Bearish direction confirmed by the active structure engine")
alertcondition(bullishStateChange, "Bullish Structure", "Filtered swing structure turned BULLISH")
alertcondition(bearishStateChange, "Bearish Structure", "Filtered swing structure turned BEARISH")
alertcondition(rangeStateChange, "Range Structure", "Filtered swing structure entered a contained RANGE")

