//@version=6
indicator("Market Structure + Consolidation v2", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ==================================================
// CONSOLIDATION MODEL - two scale-free ratios, no ATR thresholds
//
//   CONTAINMENT   compRatio = range(10 bars) / range(30 bars)
//                 Low value = the recent bars sit inside the prior swing range
//                 and are not the ones making the extremes.
//
//   INEFFICIENCY  effRatio = |net move| / total path travelled, over 10 bars
//                 Low value = bars overlap and go nowhere.
//
// TWO INDEPENDENT KNOBS - one for count, one for size.
//
//   Detection Sensitivity  moves the SEED test  -> how many zones are found
//   Zone Size              moves the HOLD test  -> how big each one gets
//
// They stay separate because a zone is seeded once and then lives on its own
// geometry. A long-lived zone also blocks new seeds, so raising Zone Size
// merges what would have been several small zones into one instead of
// fragmenting the chart. If zones are running too large, drop Zone Size and
// leave Detection alone.
// ==================================================

// --------------------------------------------------
// INPUTS
// --------------------------------------------------
len        = input.int(5, "Swing Length", minval=2)
showLabels = input.bool(true, "Show HH/HL Labels")
showLines  = input.bool(true, "Show Structure Lines")
showConsol = input.bool(true, "Show Consolidation Zones")
det        = input.int(5, "Detection Sensitivity", minval=1, maxval=10, tooltip="HOW MANY zones get found. Low = only clean, obvious coils. High = catches looser sideways patches too. Barely affects how big each zone is.")
zsize      = input.int(4, "Zone Size", minval=1, maxval=10, tooltip="HOW BIG each zone is allowed to get. Low = tight boxes that break out early. High = wide, long-lived boxes that ride out noise. Turn this DOWN if zones are running too large.")
minScore   = input.int(0, "Min Score for Breakout Signal", minval=0, maxval=100, tooltip="Suppresses breakout labels and alerts from low-quality zones. Zones still draw either way. 0 = signal on every break. 27 = drop the worst quarter. 44 = top half only. 65 = top quarter only.")
showBrk    = input.bool(true, "Show Breakout Labels")

// --- derived internally, nothing else to tune ---
winN     = 10
longN    = 30
seedBars = 3
formLen  = winN + seedBars - 1
maxLife  = 500

// Detection moves the seed test only -> changes the COUNT of zones
seedComp = 0.30 + det * 0.022
seedEff  = 0.20 + det * 0.022

// Zone Size moves the hold test only -> changes the EXTENT of each zone
padPct  = 0.02 + zsize * 0.026
capMult = 1.15 + zsize * 0.115

// Quality score anchors. Each dimension ramps 0..1 between LO and HI, then the
// three are averaged and scaled to 0-100. Anchors sit near the p10/p90 of each
// measured distribution, so the score spreads across its full range instead of
// bunching up. All three are causal - nothing here needs future bars.
LO_DUR = 12.0
HI_DUR = 45.0
LO_HT  = 1.5
HI_HT  = 5.0
LO_GR  = 1.0
HI_GR  = 1.6

// --------------------------------------------------
// VOLATILITY CONTEXT
// --------------------------------------------------
atr    = ta.atr(14)
atrAvg = ta.sma(atr, 20)

momentum =
     atr > atrAvg * 1.2 ? "Expansion" :
     atr < atrAvg * 0.8 ? "Compression" :
     "Normal"

// --------------------------------------------------
// PIVOT DETECTION (CONFIRMED SWINGS)
// --------------------------------------------------
ph = ta.pivothigh(high, len, len)
pl = ta.pivotlow(low, len, len)

var float lastHigh = na
var float lastLow  = na

var float prevPivotPrice = na
var int   prevPivotIndex = na

var string trend     = "Range"
var string lastEvent = "None"

// --------------------------------------------------
// HIGH STRUCTURE
// --------------------------------------------------
if not na(ph)
    pivotIndex = bar_index - len

    if not na(lastHigh)
        if ph > lastHigh
            lastEvent := "HH"
            if showLabels
                label.new(pivotIndex, ph, "HH", style=label.style_label_down, color=color.green, textcolor=color.white)
        else
            lastEvent := "LH"
            if showLabels
                label.new(pivotIndex, ph, "LH", style=label.style_label_down, color=color.red, textcolor=color.white)

    if not na(lastHigh) and ph > lastHigh
        if trend == "Bearish"
            trend := "Transition Up"
        else
            trend := "Bullish"

    lastHigh := ph

    if showLines and not na(prevPivotPrice)
        line.new(prevPivotIndex, prevPivotPrice, pivotIndex, ph, width=2, color=color.gray)

    prevPivotPrice := ph
    prevPivotIndex := pivotIndex

// --------------------------------------------------
// LOW STRUCTURE
// --------------------------------------------------
if not na(pl)
    pivotIndex = bar_index - len

    if not na(lastLow)
        if pl > lastLow
            lastEvent := "HL"
            if showLabels
                label.new(pivotIndex, pl, "HL", style=label.style_label_up, color=color.green, textcolor=color.white)
        else
            lastEvent := "LL"
            if showLabels
                label.new(pivotIndex, pl, "LL", style=label.style_label_up, color=color.red, textcolor=color.white)

    if not na(lastLow) and pl < lastLow
        if trend == "Bullish"
            trend := "Transition Down"
        else
            trend := "Bearish"

    lastLow := pl

    if showLines and not na(prevPivotPrice)
        line.new(prevPivotIndex, prevPivotPrice, pivotIndex, pl, width=2, color=color.gray)

    prevPivotPrice := pl
    prevPivotIndex := pivotIndex

// --------------------------------------------------
// CONSOLIDATION DETECTION
// --------------------------------------------------
shortHi = ta.highest(high, winN)
shortLo = ta.lowest(low, winN)
longHi  = ta.highest(high, longN)
longLo  = ta.lowest(low, longN)

rangeS = shortHi - shortLo
rangeL = longHi - longLo

compRatio = rangeL > 0 ? rangeS / rangeL : 1.0

netMove  = math.abs(close - close[winN])
pathMove = math.sum(math.abs(close - close[1]), winN)
effRatio = pathMove > 0 ? netMove / pathMove : 1.0

formHi = ta.highest(high, formLen)
formLo = ta.lowest(low, formLen)

// a zone can only be SEEDED here; staying alive is handled below
seed = showConsol and bar_index >= longN and compRatio <= seedComp and effRatio <= seedEff

// --------------------------------------------------
// CONSOLIDATION STATE MACHINE
// --------------------------------------------------
var int    runLen    = 0
var bool   conActive = false
var box    conBox    = na
var float  conTop    = na
var float  conBot    = na
var float  conH0     = na
var float  conScore  = 0.0
var int    conLeft   = na
var int    brkBar    = na
var string conState  = "None"

bool newCon  = false
bool bullBrk = false
bool bearBrk = false

runLen := seed ? runLen + 1 : 0

// seed a new zone
if not conActive and runLen == seedBars
    conActive := true
    conLeft   := bar_index - formLen + 1
    conTop    := formHi
    conBot    := formLo
    conH0     := math.max(formHi - formLo, syminfo.mintick)
    conState  := "Active"
    conScore  := 0.0
    newCon    := true

    conBox := box.new(
         conLeft,
         conTop,
         bar_index,
         conBot,
         border_color=color.new(color.orange, 25),
         border_width=1,
         bgcolor=color.new(color.orange, 88),
         text="CONSOLIDATION",
         text_color=color.new(color.orange, 15),
         text_size=size.tiny,
         text_halign=text.align_center,
         text_valign=text.align_top)

// manage the live zone
if conActive
    // --- live quality score -----------------------------------------------
    qDur = math.min(math.max((bar_index - conLeft + 1 - LO_DUR) / (HI_DUR - LO_DUR), 0), 1)

    qHt = math.min(
         math.max(
             ((conTop - conBot) / math.max(atr, syminfo.mintick) - LO_HT) /
             (HI_HT - LO_HT),
             0),
         1)

    qGr = math.min(
         math.max(
             ((conTop - conBot) / conH0 - LO_GR) /
             (HI_GR - LO_GR),
             0),
         1)

    conScore := (qDur + qHt + qGr) / 3 * 100

    pad = (conTop - conBot) * padPct
    upB = close > conTop + pad
    dnB = close < conBot - pad

    box.set_right(conBox, bar_index)
    box.set_text(conBox, "CONSOLIDATION  " + str.tostring(conScore, "#"))

    box.set_border_color(
         conBox,
         conScore >= 65 ? color.new(color.orange, 0) :
         conScore >= 27 ? color.new(color.orange, 35) :
         color.new(color.gray, 45))

    if upB or dnB
        // a break from a low-scoring zone still draws, it just does not signal
        ok = conScore >= minScore

        conActive := false
        runLen    := 0
        brkBar    := bar_index
        conState  := upB ? "Broke Up" : "Broke Down"
        bullBrk   := upB and ok
        bearBrk   := dnB and ok

        box.set_bgcolor(
             conBox,
             color.new(upB ? color.green : color.red, ok ? 85 : 93))

        box.set_border_color(
             conBox,
             color.new(upB ? color.green : color.red, ok ? 25 : 60))

        if showBrk and ok
            label.new(
                 bar_index,
                 upB ? conTop : conBot,
                 (upB ? "BREAK ▲  " : "BREAK ▼  ") + str.tostring(conScore, "#"),
                 style=upB ? label.style_label_up : label.style_label_down,
                 color=upB ? color.green : color.red,
                 textcolor=color.white,
                 size=size.small)

    else
        // absorb the bar, but never let the box jump further than the pad
        newTop = math.max(conTop, math.min(high, conTop + pad))
        newBot = math.min(conBot, math.max(low, conBot - pad))

        if newTop - newBot > capMult * conH0 or bar_index - conLeft > maxLife
            conActive := false
            runLen    := 0
            conState  := "Ended"
        else
            conTop := newTop
            conBot := newBot
            box.set_top(conBox, conTop)
            box.set_bottom(conBox, conBot)

// --------------------------------------------------
// IGNITION - a one-shot check on the break bar
// --------------------------------------------------
IGNITE_BARS = 3

fastDrive = compRatio > 0.55 and effRatio > 0.45

// FIX:
// Direction of the current net move over winN bars.
//  1 = upward
// -1 = downward
//  0 = flat
dirSign = close > close[winN] ? 1 : close < close[winN] ? -1 : 0

var string impState = "None"
var int    impBar   = na
var int    impDir   = 0
var float  impLvl   = na
var float  impRisk  = na
var float  impPeak  = 0.0

bool ignited = false

if bullBrk or bearBrk
    impState := "Watching"
    impBar   := bar_index
    impDir   := bullBrk ? 1 : -1
    impLvl   := bullBrk ? conTop : conBot
    impRisk  := math.max(conTop - conBot, syminfo.mintick)
    impPeak  := 0.0

// extension since the break, in units of the range height
// 1R = the consolidation box height
ext = impState == "None" or na(impLvl) ? 0.0 : (close - impLvl) * impDir / impRisk

if impState == "Watching"
    if fastDrive and dirSign == impDir
        impState := "Ignited"
        ignited  := true
    else if bar_index - impBar > IGNITE_BARS
        impState := "Fizzled"

else if impState == "Ignited"
    impPeak := math.max(impPeak, ext)

    if compRatio < 0.45
        impState := "Done"

// --------------------------------------------------
// ALERTS
// --------------------------------------------------
alertcondition(
     newCon,
     "Consolidation Detected",
     "Price is consolidating inside the prior swing range")

alertcondition(
     bullBrk,
     "Range Break Up",
     "Consolidation broken to the upside")

alertcondition(
     bearBrk,
     "Range Break Down",
     "Consolidation broken to the downside")

alertcondition(
     ignited,
     "Breakout Ignited",
     "Break confirmed - it caught within 3 bars")

// --------------------------------------------------
// TRADING BIAS ENGINE
// --------------------------------------------------
freshBrk = not na(brkBar) and bar_index - brkBar <= winN

bias =
     conActive ? "In Range - wait for break" :
     impState == "Watching" ? "Break unconfirmed - wait for ignition" :
     impState == "Ignited" ? "Following - " + str.tostring(ext, "#.#") + "R extended" :
     impState == "Done" and freshBrk ? "Leg done - trail, do not add" :
     impState == "Fizzled" and freshBrk ? "Break failed to ignite - stand aside" :
     trend == "Bullish" ? "Pullbacks Long (HL)" :
     trend == "Bearish" ? "Rallies Short (LH)" :
     trend == "Transition Up" ? "Reversal Possible ↑" :
     trend == "Transition Down" ? "Reversal Possible ↓" :
     "No Edge"

// --------------------------------------------------
// TABLE PANEL
// --------------------------------------------------
var table panel = table.new(position.top_right, 2, 8, border_width=1)

bg  = color.white
txt = color.black

if barstate.islast
    stateTxt = conActive ? "Consolidating" : trend

    stateCol =
         conActive ? color.orange :
         trend == "Bullish" ? color.green :
         trend == "Bearish" ? color.red :
         color.orange

    conTxt =
         conActive ?
         "Active (" + str.tostring(bar_index - conLeft + 1) + " bars)" :
         conState

    conCol =
         conActive ? color.orange :
         conState == "Broke Up" ? color.green :
         conState == "Broke Down" ? color.red :
         color.gray

    impTxt =
         impState == "Ignited" ?
         "Ignited  " + str.tostring(ext, "#.#") + "R" :
         impState == "Done" ?
         "Done  peak " + str.tostring(impPeak, "#.#") + "R" :
         impState == "None" ?
         "-" :
         impState

    impStCol =
         impState == "Ignited" ? color.rgb(59, 130, 246) :
         impState == "Watching" ? color.orange :
         color.gray

    scoreTxt =
         conState == "None" ?
         "-" :
         str.tostring(conScore, "#") + " / 100"

    scoreCol =
         conState == "None" ? color.gray :
         conScore >= 65 ? color.green :
         conScore >= 27 ? color.orange :
         color.gray

    table.cell(
         panel,
         0,
         0,
         "Market State",
         text_color=txt,
         bgcolor=bg)

    table.cell(
         panel,
         1,
         0,
         stateTxt,
         text_color=color.white,
         bgcolor=stateCol)

    table.cell(
         panel,
         0,
         1,
         "Breakout",
         text_color=txt,
         bgcolor=bg)

    table.cell(
         panel,
         1,
         1,
         impTxt,
         text_color=color.white,
         bgcolor=impStCol)

    table.cell(
         panel,
         0,
         2,
         "Consolidation",
         text_color=txt,
         bgcolor=bg)

    table.cell(
         panel,
         1,
         2,
         conTxt,
         text_color=color.white,
         bgcolor=conCol)

    table.cell(
         panel,
         0,
         3,
         "Zone Score",
         text_color=txt,
         bgcolor=bg)

    table.cell(
         panel,
         1,
         3,
         scoreTxt,
         text_color=color.white,
         bgcolor=scoreCol)

    table.cell(
         panel,
         0,
         4,
         "Last Structure",
         text_color=txt,
         bgcolor=bg)

    table.cell(
         panel,
         1,
         4,
         lastEvent,
         text_color=txt,
         bgcolor=bg)

    table.cell(
         panel,
         0,
         5,
         "Volatility",
         text_color=txt,
         bgcolor=bg)

    table.cell(
         panel,
         1,
         5,
         momentum,
         text_color=txt,
         bgcolor=bg)

    table.cell(
         panel,
         0,
         6,
         "Trading Bias",
         text_color=txt,
         bgcolor=bg)

    table.cell(
         panel,
         1,
         6,
         bias,
         text_color=txt,
         bgcolor=bg)

    table.cell(
         panel,
         0,
         7,
         "ATR(14)",
         text_color=txt,
         bgcolor=bg)

    table.cell(
         panel,
         1,
         7,
         str.tostring(atr, format.mintick),
         text_color=txt,
         bgcolor=bg)
