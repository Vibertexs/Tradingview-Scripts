//@version=6
// Session Bias Engine v2 — Adaptive Operating Bias
//
// v1 locked the bias at the London open and refused to change it. The reasoning
// was that "whether London agreed" is a different question from "what the bias
// was". That reasoning is correct, and the implementation was still wrong: it
// printed the invalidation cross, knew perfectly well it was wrong, and then held
// a bearish box across an entire bullish day. A filter that stays wrong all day
// is not a filter.
//
// The mistake was collapsing two different things into one number:
//
//   THE LOCKED BIAS is a prediction, made at a fixed moment from fixed inputs.
//   It must never change, because it is the record you evaluate the model
//   against. Let it drift and you can never tell whether the model works.
//
//   THE OPERATING BIAS is what you should be trading with right now. It starts
//   as the locked bias and updates on evidence that did not exist at lock time.
//
// v2 publishes both. The locked bias still never moves. The operating bias runs
// a live evidence score and sits in one of three states:
//
//   HOLDING   evidence is consistent with the locked bias
//   UNSURE    contrary evidence exists but has not met the bar to flip, or the
//             day has taken both sides and has no side to be on
//   FLIPPED   contrary evidence met the bar; operate against the locked bias
//
// ─── WHAT JUSTIFIES A FLIP ──────────────────────────────────────────────────
//
// Four things, all measured only AFTER the lock, all signed relative to the
// locked bias so positive means "holding up":
//
//   STRUCTURE     a qualifying close beyond an Asian boundary, regime-adjusted
//   DISPLACEMENT  how far past that boundary price actually travelled, in ATR.
//                 This is what separates a two-tick poke from a real run, and it
//                 is the single most reliable idea in this whole literature:
//                 size conditions meaning.
//   ACCEPTANCE    share of post-lock bars closing beyond each boundary. Time
//                 based, so one spike cannot flip the day.
//   LOCATION      where price sits versus the Asian midpoint right now. The same
//                 variable that locked the bias, re-read continuously.
//
// ─── WHY IT WILL NOT WHIPSAW ────────────────────────────────────────────────
//
//   • Flipping needs a much higher score than going unsure, and needs an actual
//     structural break against the bias — not just score drift.
//   • Falling out of a flip drops to UNSURE first. It never snaps straight back.
//   • Flips are capped per day (1 by default). After the cap, further contrary
//     evidence forces UNSURE, never another flip. A day that wants to flip twice
//     is, by definition, an unsure day.
//   • If price has closed beyond BOTH Asian boundaries, the unsure band widens to
//     cover any contrary reading at all. That is the two-sided sweep day, and the
//     honest answer on one is "no side".
//
// The box is now SEGMENTED: it closes and reopens at every state change, so a day
// that locked bearish and flipped bullish draws a red segment and then a green
// one. Border style carries state too — dotted is provisional or unsure, solid is
// holding, dashed is flipped.
//
// Requires an intraday chart. 5m–1h is useful; 15m is a good default.
//
// CC BY-NC-SA 4.0 · https://creativecommons.org/licenses/by-nc-sa/4.0/

indicator("Session Bias Engine v2", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
var string G_SESS = "Sessions"
var string G_BIAS = "Bias — Lock"
var string G_LIVE = "Bias — Adaptation"
var string G_REG  = "Regime"
var string G_STY  = "Style"

sessionTz = input.string("GMT+0", "Session Timezone", group = G_SESS,
     options = ["GMT+0", "GMT+1", "GMT+2", "GMT+3", "GMT+8", "GMT+9", "GMT+10",
                "GMT-4", "GMT-5", "GMT-6", "GMT-7", "GMT-8",
                "Europe/London", "America/New_York", "Asia/Tokyo", "Asia/Shanghai", "Australia/Sydney"],
     tooltip = "The timezone the session strings below are written in. Set this FIRST - everything depends on it. GMT+0 with the default sessions is the standard FX convention.")

asiaSession   = input.session("0000-0800", "Asian Session (decision window)", group = G_SESS,
     tooltip = "Asia's internal structure is read live inside this window. Sessions must not overlap - the London open input is meaningless if London starts before Asia ends.")
londonSession = input.session("0800-1600", "London Session (expression window)", group = G_SESS,
     tooltip = "The bias locks at this session's open, then adapts to evidence through it.")

wAsia     = input.float(0.30, "Weight · Asia Internal Read",      minval = 0.0, maxval = 2.0, step = 0.05, group = G_BIAS,
     tooltip = "Asia's own four-factor structure score. Weighted lowest because session direction is the component with the weakest evidence behind it.")
wSweep    = input.float(0.25, "Weight · Prior-Day Sweep/Fail",    minval = 0.0, maxval = 2.0, step = 0.05, group = G_BIAS,
     tooltip = "Asia took out yesterday's high or low and closed back inside. The only component reading anything outside the current day.")
wLocation = input.float(0.45, "Weight · London Open vs Asia Mid", minval = 0.0, maxval = 2.0, step = 0.05, group = G_BIAS,
     tooltip = "Where London opens relative to the Asian midpoint. Weighted highest because it has by far the largest supporting sample.")

biasThresh  = input.float(0.20, "Neutral Threshold", minval = 0.0, maxval = 0.90, step = 0.05, group = G_BIAS,
     tooltip = "Lock score at or above this is bullish, at or below its negative is bearish, between is UNSURE from the outset. Set to 0 to force a direction every day.")
minAsiaBars = input.int(4, "Minimum Asian Bars", minval = 2, maxval = 60, group = G_BIAS,
     tooltip = "Asia's read stays undecided until the session has this many bars. On a 15m chart, 4 is one hour.")
invertAsiaLocation = input.bool(false, "Invert Asia Location Factor", group = G_BIAS,
     tooltip = "Flips the sign of Asia's close-location factor. The published evidence on this quantity (Internal Bar Strength) is mean-reverting on equity indices and untested in FX - test both signs rather than inheriting an assumption.")

allowFlip     = input.bool(true, "Allow Bias To Flip", group = G_LIVE,
     tooltip = "Off makes the operating bias behave like v1: it can go UNSURE but never reverses. On is the default - when the evidence says the lock was wrong, say so.")
unsureThresh  = input.float(0.20, "Unsure Threshold", minval = 0.05, maxval = 0.90, step = 0.05, group = G_LIVE,
     tooltip = "Live evidence at or below minus this puts the operating bias in UNSURE. Lower = quicker to admit doubt.")
flipThresh    = input.float(0.55, "Flip Threshold", minval = 0.20, maxval = 1.00, step = 0.05, group = G_LIVE,
     tooltip = "Live evidence at or below minus this reverses the operating bias, and a structural break against the lock is also required. Deliberately far above the unsure threshold - reversing a prior should cost more than doubting it.")
maxFlips      = input.int(1, "Max Flips Per Day", minval = 0, maxval = 4, group = G_LIVE,
     tooltip = "After this many reversals, further contrary evidence forces UNSURE instead of another flip. A day that wants to flip twice is an unsure day. 1 is the sane default.")
dispScaleAtr  = input.float(0.50, "Displacement Full Scale (Daily ATR)", minval = 0.10, maxval = 3.00, step = 0.05, group = G_LIVE,
     tooltip = "How far beyond an Asian boundary counts as a fully committed move. The displacement component saturates here. Smaller = more sensitive to shallow breaks.")

coiledMax   = input.float(0.35, "COILED · Asia Range / Daily ATR at or below", minval = 0.05, maxval = 2.0, step = 0.05, group = G_REG)
expandedMin = input.float(0.70, "EXPANDED · Asia Range / Daily ATR at or above", minval = 0.10, maxval = 3.0, step = 0.05, group = G_REG)
structureBufferAtr = input.float(0.02, "Structure Break Buffer (Daily ATR)", minval = 0.0, maxval = 0.30, step = 0.005, group = G_REG,
     tooltip = "How far beyond the Asian range a London close must sit to count as structure. Automatically doubled in COILED and reduced in EXPANDED.")
regimeAdapts = input.bool(true, "Regime Adapts Break Handling", group = G_REG,
     tooltip = "A coiled Asia sweeps BOTH sides roughly a third of the time versus an eighth for a wide one, but travels much further once it goes. COILED widens the buffer and demands two consecutive closes; EXPANDED narrows it and accepts one.")

showAsiaBox = input.bool(true,  "Show Asian Range Box",       group = G_STY)
showBiasBox = input.bool(true,  "Show Bias Box",              group = G_STY)
showLevels  = input.bool(true,  "Project Asian High/Low/Mid", group = G_STY)
showTable   = input.bool(true,  "Show Bias Panel",            group = G_STY)
historyDays = input.int(20, "Days To Keep On Chart", minval = 1, maxval = 60, group = G_STY)

boxTransp    = input.int(90, "Box Transparency", minval = 0, maxval = 100, group = G_STY)
bullColor    = input.color(#089981, "Bullish",  group = G_STY)
bearColor    = input.color(#f23645, "Bearish",  group = G_STY)
neutralColor = input.color(#8a8f99, "Unsure",   group = G_STY)
asiaColor    = input.color(#787b86, "Asian Session", group = G_STY)
flagColor    = input.color(#f2b705, "Alert / Regime Flag", group = G_STY)

// Asia's internal factor weights stay fixed — each is published individually.
float W_LOCATION = 1.00
float W_DRIVE    = 0.80
float W_VWAP     = 0.70
float W_SEQUENCE = 0.50
float W_ASIA_TOT = W_LOCATION + W_DRIVE + W_VWAP + W_SEQUENCE

// Live evidence weights. Structure leads because it is the discrete event;
// displacement and acceptance together outweigh it, because a break that goes
// nowhere and a break that is held are very different things.
float E_STRUCT = 0.35
float E_DISP   = 0.25
float E_ACCEPT = 0.25
float E_LOC    = 0.15

int RANGE_MEMORY = 20

// ─────────────────────────────────────────────────────────────────────────────
// Higher-timeframe references
//
// lookahead_on with a [1] offset is the documented NON-repainting idiom for
// prior-HTF-bar values. [1] without lookahead_on leaves you a day stale;
// lookahead_on without [1] leaks today's finished daily bar into today.
// ─────────────────────────────────────────────────────────────────────────────
float prevDayHigh = request.security(syminfo.tickerid, "D", high[1],       gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float prevDayLow  = request.security(syminfo.tickerid, "D", low[1],        gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float prevDayAtr  = request.security(syminfo.tickerid, "D", ta.atr(14)[1], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float atrSafe     = math.max(nz(prevDayAtr, ta.atr(14)), syminfo.mintick)

float atrNow    = ta.atr(14)
float atrRegime = atrNow / math.max(nz(ta.sma(atrNow, 50), atrNow), syminfo.mintick)

// ─────────────────────────────────────────────────────────────────────────────
// Session detection
// ─────────────────────────────────────────────────────────────────────────────
bool inAsia   = not na(time(timeframe.period, asiaSession,   sessionTz))
bool inLondon = not na(time(timeframe.period, londonSession, sessionTz))

bool asiaOpened   = inAsia    and (bar_index == 0 or not inAsia[1])
bool asiaClosed   = not inAsia  and bar_index > 0 and inAsia[1]
bool londonOpened = inLondon  and (bar_index == 0 or not inLondon[1])
bool londonClosed = not inLondon and bar_index > 0 and inLondon[1]

bool tfOk = timeframe.isintraday and timeframe.in_seconds() <= 3600
bool sessionsOverlap = inAsia and inLondon

// ─────────────────────────────────────────────────────────────────────────────
// Live Asian session accumulation
// ─────────────────────────────────────────────────────────────────────────────
var float asiaHigh      = na
var float asiaLow       = na
var float asiaOpenPx    = na
var int   asiaHighBar   = na
var int   asiaLowBar    = na
var int   asiaStartBar  = na
var int   asiaBarCount  = 0
var int   asiaAboveVwap = 0
var float vwapNumer     = 0.0
var float vwapDenom     = 0.0
var float asiaVwap      = na

if asiaOpened
    asiaHigh      := high
    asiaLow       := low
    asiaOpenPx    := open
    asiaHighBar   := bar_index
    asiaLowBar    := bar_index
    asiaStartBar  := bar_index
    asiaBarCount  := 0
    asiaAboveVwap := 0
    vwapNumer     := 0.0
    vwapDenom     := 0.0
    asiaVwap      := na

if inAsia
    if not na(asiaHigh) and high > asiaHigh
        asiaHigh    := high
        asiaHighBar := bar_index
    if not na(asiaLow) and low < asiaLow
        asiaLow    := low
        asiaLowBar := bar_index

    float w = nz(volume, 0.0) > 0.0 ? volume : 1.0
    vwapNumer := vwapNumer + hlc3 * w
    vwapDenom := vwapDenom + w
    asiaVwap  := vwapNumer / math.max(vwapDenom, 1e-10)

    asiaBarCount := asiaBarCount + 1
    if close > asiaVwap
        asiaAboveVwap := asiaAboveVwap + 1

// ─────────────────────────────────────────────────────────────────────────────
// Asia's four internal factors — each normalised to [-1, +1]
// ─────────────────────────────────────────────────────────────────────────────
float asiaSpan = math.max(nz(asiaHigh - asiaLow, 0.0), syminfo.mintick)

float fLocationRaw = 2.0 * (close - asiaLow) / asiaSpan - 1.0
float fLocation    = invertAsiaLocation ? -fLocationRaw : fLocationRaw
float fDrive       = math.max(-1.0, math.min(1.0, (close - asiaOpenPx) / (asiaSpan * 0.5)))
float fVwap        = asiaBarCount > 0 ? 2.0 * (float(asiaAboveVwap) / float(asiaBarCount)) - 1.0 : 0.0
float fSequence    = na(asiaHighBar) or na(asiaLowBar) ? 0.0 :
     asiaHighBar > asiaLowBar ? 1.0 : asiaHighBar < asiaLowBar ? -1.0 : 0.0

float asiaScore = (fLocation * W_LOCATION + fDrive * W_DRIVE + fVwap * W_VWAP + fSequence * W_SEQUENCE) / W_ASIA_TOT
bool  asiaMature = asiaBarCount >= minAsiaBars

var float asiaFinalScore = na
if asiaOpened
    asiaFinalScore := na
if inAsia and asiaMature and not na(asiaScore)
    asiaFinalScore := asiaScore

// ─────────────────────────────────────────────────────────────────────────────
// Day state
// ─────────────────────────────────────────────────────────────────────────────
var float lockHigh  = na
var float lockLow   = na
var float lockMid   = na
var float lockRange = na
var float rangeAtr  = na
var float rangePct  = na
var int   regime    = 0
var int   sweepDir  = 0
var float asiaRead  = na
var int   dayStage  = 0        // 0 forming · 1 provisional · 2 locked
var int   lockBar   = na
var bool  dayDone   = false

// Post-lock evidence accumulators
var int   postBars      = 0
var int   barsAboveHigh = 0
var int   barsBelowLow  = 0
var float maxAbove      = 0.0
var float maxBelow      = 0.0
var bool  tookHigh      = false
var bool  tookLow       = false
var int   lastBreakDir  = 0    // re-latches on each new qualifying break

// Operating state
var int lockedBias = 0         // the prediction — never changes after lock
var int operBias   = 0         // what to trade with now
var int biasState  = 0         // 0 holding · 1 unsure · 2 flipped
var int flipCount  = 0

var array<float> rangeMemory = array.new_float()

bool provisionalSet = false

if asiaOpened
    dayStage   := 0
    sweepDir   := 0
    regime     := 0
    lockHigh   := na
    lockLow    := na
    lockMid    := na
    lockRange  := na
    rangeAtr   := na
    rangePct   := na
    asiaRead   := na
    dayDone    := false
    lockedBias := 0
    operBias   := 0
    biasState  := 0
    flipCount  := 0
    postBars      := 0
    barsAboveHigh := 0
    barsBelowLow  := 0
    maxAbove      := 0.0
    maxBelow      := 0.0
    tookHigh      := false
    tookLow       := false
    lastBreakDir  := 0

// ─────────────────────────────────────────────────────────────────────────────
// STAGE 1 — Asian close: provisional bias
// ─────────────────────────────────────────────────────────────────────────────
if asiaClosed and not na(asiaHigh) and not na(asiaLow) and not na(asiaFinalScore)
    lockHigh  := asiaHigh
    lockLow   := asiaLow
    lockMid   := (asiaHigh + asiaLow) * 0.5
    lockRange := math.max(asiaHigh - asiaLow, syminfo.mintick)
    asiaRead  := asiaFinalScore

    rangeAtr := lockRange / atrSafe
    regime   := rangeAtr <= coiledMax ? -1 : rangeAtr >= expandedMin ? 1 : 0

    float avgRange = array.size(rangeMemory) >= 5 ? array.avg(rangeMemory) : na
    rangePct := na(avgRange) or avgRange <= 0 ? na : lockRange / avgRange * 100.0
    array.push(rangeMemory, lockRange)
    if array.size(rangeMemory) > RANGE_MEMORY
        array.shift(rangeMemory)

    // Both sides sweeping is ambiguous, not neutral — the day already took
    // liquidity in both directions.
    bool bullSweepFail = asiaLow  < prevDayLow  and close[1] > prevDayLow
    bool bearSweepFail = asiaHigh > prevDayHigh and close[1] < prevDayHigh
    sweepDir := bullSweepFail and not bearSweepFail ? 1 : bearSweepFail and not bullSweepFail ? -1 : 0

    dayStage := 1
    provisionalSet := true

// ─────────────────────────────────────────────────────────────────────────────
// STAGE 2 — London open: the bias locks
// ─────────────────────────────────────────────────────────────────────────────
var int   locationDir  = 0
var float londonOpenPx = na
var float lockScore    = na

bool biasLocked = false

if londonOpened and dayStage == 1 and not na(lockMid) and not sessionsOverlap
    londonOpenPx := open
    locationDir  := open > lockMid ? 1 : open < lockMid ? -1 : 0
    dayStage     := 2
    lockBar      := bar_index
    biasLocked   := true

// Lock score — computed at every stage so the panel can show it forming.
float provWeights = math.max(wAsia + wSweep, 0.0001)
float fullWeights = math.max(wAsia + wSweep + wLocation, 0.0001)
float provScore = dayStage >= 1 and not na(asiaRead) ?
     (asiaRead * wAsia + float(sweepDir) * wSweep) / provWeights : na
float liveLockScore = dayStage >= 2 and not na(asiaRead) ?
     (asiaRead * wAsia + float(sweepDir) * wSweep + float(locationDir) * wLocation) / fullWeights : provScore

if biasLocked
    lockScore  := liveLockScore
    lockedBias := na(lockScore) ? 0 :
         lockScore >= biasThresh ? 1 : lockScore <= -biasThresh ? -1 : 0
    // A lock score inside the neutral band means the components disagreed. That
    // is UNSURE from the outset, not a coin-flip direction.
    biasState := lockedBias == 0 ? 1 : 0
    operBias  := lockedBias

// ─────────────────────────────────────────────────────────────────────────────
// Regime-adjusted structure detection
// ─────────────────────────────────────────────────────────────────────────────
float bufMult  = not regimeAdapts ? 1.0 : regime == -1 ? 2.0 : regime == 1 ? 0.75 : 1.0
int   needBars = not regimeAdapts ? 1 : regime == -1 ? 2 : 1
float structBuf = atrSafe * structureBufferAtr * bufMult

var int structureDir = 0       // FIRST qualifying break of the day, latched
var int structureBar = na
var int upStreak = 0
var int dnStreak = 0

if asiaOpened
    structureDir := 0
    structureBar := na
    upStreak := 0
    dnStreak := 0

bool newBreakUp   = false
bool newBreakDown = false

if inLondon and dayStage >= 1 and not na(lockHigh)
    if close > lockHigh + structBuf
        upStreak := upStreak + 1
        dnStreak := 0
        if upStreak >= needBars and lastBreakDir != 1
            lastBreakDir := 1
            newBreakUp := true
            if structureDir == 0
                structureDir := 1
                structureBar := bar_index
    else if close < lockLow - structBuf
        dnStreak := dnStreak + 1
        upStreak := 0
        if dnStreak >= needBars and lastBreakDir != -1
            lastBreakDir := -1
            newBreakDown := true
            if structureDir == 0
                structureDir := -1
                structureBar := bar_index
    else
        upStreak := 0
        dnStreak := 0

// ─────────────────────────────────────────────────────────────────────────────
// Post-lock evidence accumulation
// ─────────────────────────────────────────────────────────────────────────────
if dayStage >= 2 and inLondon and not na(lockHigh)
    postBars := postBars + 1
    if close > lockHigh
        barsAboveHigh := barsAboveHigh + 1
        maxAbove      := math.max(maxAbove, close - lockHigh)
        tookHigh      := true
    if close < lockLow
        barsBelowLow := barsBelowLow + 1
        maxBelow     := math.max(maxBelow, lockLow - close)
        tookLow      := true

bool bothSides = tookHigh and tookLow

// ─────────────────────────────────────────────────────────────────────────────
// Live evidence score — signed so POSITIVE means the locked bias is holding up
// ─────────────────────────────────────────────────────────────────────────────
float dispScale = math.max(atrSafe * dispScaleAtr, syminfo.mintick)

// STRUCTURE — the discrete event, from the most recent qualifying break.
float eStruct = lockedBias == 0 ? 0.0 : float(lastBreakDir * lockedBias)

// DISPLACEMENT — how far it actually went. A poke and a run are not the same.
float netDisp = math.max(-1.0, math.min(1.0, (maxAbove - maxBelow) / dispScale))
float eDisp   = lockedBias == 0 ? 0.0 : netDisp * lockedBias

// ACCEPTANCE — share of post-lock bars held beyond each boundary. Time based, so
// a single spike cannot carry it. Saturates at a third of the session.
float accUp  = postBars > 0 ? float(barsAboveHigh) / float(postBars) : 0.0
float accDn  = postBars > 0 ? float(barsBelowLow)  / float(postBars) : 0.0
float netAcc = math.max(-1.0, math.min(1.0, (accUp - accDn) * 3.0))
float eAccept = lockedBias == 0 ? 0.0 : netAcc * lockedBias

// LOCATION — the 76% variable, re-read continuously instead of only at the open.
float locNow = na(lockRange) ? 0.0 :
     math.max(-1.0, math.min(1.0, 2.0 * (close - lockLow) / lockRange - 1.0))
float eLoc = lockedBias == 0 ? 0.0 : locNow * lockedBias

float liveScore = dayStage >= 2 and lockedBias != 0 ?
     eStruct * E_STRUCT + eDisp * E_DISP + eAccept * E_ACCEPT + eLoc * E_LOC : na

// ─────────────────────────────────────────────────────────────────────────────
// Operating state machine
//
// Hysteresis: flipping costs far more than doubting, falling out of a flip lands
// in UNSURE rather than snapping back, and flips are capped. On a day that has
// taken both sides the unsure band widens to cover any contrary reading at all.
// ─────────────────────────────────────────────────────────────────────────────
bool justFlipped   = false
bool justUnsure    = false
bool justRecovered = false

if dayStage >= 2 and inLondon and lockedBias != 0 and not na(liveScore) and not dayDone
    float effUnsure = bothSides ? 0.0 : unsureThresh
    int   prevState = biasState

    if biasState != 2
        // Not yet flipped. Contrary evidence can push to UNSURE, or all the way
        // over if it is decisive AND a real structural break backs it.
        bool structAgainst = lastBreakDir != 0 and lastBreakDir != lockedBias
        if allowFlip and liveScore <= -flipThresh and structAgainst and flipCount < maxFlips
            biasState := 2
            operBias  := -lockedBias
            flipCount := flipCount + 1
        else if liveScore <= -effUnsure
            biasState := 1
            operBias  := 0
        else
            biasState := 0
            operBias  := lockedBias
    else
        // Already flipped. liveScore is still measured against the ORIGINAL lock,
        // so a score climbing back toward zero means the flip itself is failing.
        if liveScore >= flipThresh and flipCount < maxFlips
            biasState := 0
            operBias  := lockedBias
            flipCount := flipCount + 1
        else if liveScore >= -unsureThresh
            biasState := 1
            operBias  := 0
        else
            operBias := -lockedBias

    if biasState != prevState
        justFlipped   := biasState == 2
        justUnsure    := biasState == 1
        justRecovered := biasState == 0 and prevState != 0

// ─────────────────────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────────────────────
f_dirColor(int d) => d == 1 ? bullColor : d == -1 ? bearColor : neutralColor
f_dirWord(int d)  => d == 1 ? "BULLISH" : d == -1 ? "BEARISH" : "UNSURE"
f_dirText(int d)  => d == 1 ? "+1  bull" : d == -1 ? "−1  bear" : "0"
f_stateWord(int s) => s == 2 ? "FLIPPED" : s == 1 ? "UNSURE" : "HOLDING"
f_regimeText(int r) => r == -1 ? "COILED" : r == 1 ? "EXPANDED" : "NORMAL"
f_regimeNote(int r) => r == -1 ? "confirm first break" : r == 1 ? "first break usable" : "standard"

f_trimBoxes(array<box> a, int keep) =>
    while array.size(a) > keep
        box.delete(array.shift(a))
f_trimLines(array<line> a, int keep) =>
    while array.size(a) > keep
        line.delete(array.shift(a))
f_trimLabels(array<label> a, int keep) =>
    while array.size(a) > keep
        label.delete(array.shift(a))

var array<box>   asiaBoxes  = array.new<box>()
var array<box>   biasBoxes  = array.new<box>()
var array<line>  hiLines    = array.new<line>()
var array<line>  loLines    = array.new<line>()
var array<line>  midLines   = array.new<line>()
var array<label> biasLabels = array.new<label>()

var box   curAsiaBox = na
var box   curBiasBox = na
var line  curHiLine  = na
var line  curLoLine  = na
var line  curMidLine = na
var float segTop = na
var float segBot = na

// ─────────────────────────────────────────────────────────────────────────────
// Asian range box, drawn live as the session forms
// ─────────────────────────────────────────────────────────────────────────────
if showAsiaBox and tfOk
    if asiaOpened
        curAsiaBox := box.new(bar_index, high, bar_index, low,
             xloc = xloc.bar_index,
             bgcolor      = color.new(asiaColor, math.min(99, boxTransp + 4)),
             border_color = color.new(asiaColor, 40),
             border_style = line.style_dotted,
             border_width = 1,
             text = "ASIA", text_color = color.new(asiaColor, 25), text_size = size.tiny,
             text_halign = text.align_left, text_valign = text.align_top)
        array.push(asiaBoxes, curAsiaBox)
        f_trimBoxes(asiaBoxes, historyDays)
    if inAsia and not na(curAsiaBox)
        box.set_right(curAsiaBox, bar_index)
        box.set_top(curAsiaBox, asiaHigh)
        box.set_bottom(curAsiaBox, asiaLow)

// ─────────────────────────────────────────────────────────────────────────────
// SEGMENTED bias box
//
// One segment per state. The segment key changes whenever the visual should
// change, and each change closes the running box and opens a fresh one — so a
// day that locked bearish and flipped bullish draws red, then green. That is the
// whole point of v2, and it is what the single-box version could not express.
//
// State is encoded in border style as well as colour:
//   dotted  provisional, or unsure
//   solid   holding the locked bias
//   dashed  flipped against it
// ─────────────────────────────────────────────────────────────────────────────
var int lastSegKey = -999

int segKey = dayStage == 0 ? -999 :
     dayStage == 1 ? 1000 :
     2000 + biasState * 10 + (operBias + 1)

bool segChanged = tfOk and showBiasBox and dayStage >= 1 and segKey != lastSegKey and not dayDone

if segChanged
    if not na(curBiasBox)
        box.set_right(curBiasBox, bar_index)

    color sc = dayStage == 1 ? f_dirColor(na(provScore) ? 0 : provScore >= biasThresh ? 1 : provScore <= -biasThresh ? -1 : 0)
             : f_dirColor(operBias)
    string sTxt = dayStage == 1 ? "PROVISIONAL"
             : biasState == 2 ? "FLIP → " + f_dirWord(operBias)
             : biasState == 1 ? "UNSURE"
             : f_dirWord(operBias) + "  ·  " + f_regimeText(regime)
    string sStyle = dayStage == 1 or biasState == 1 ? line.style_dotted
             : biasState == 2 ? line.style_dashed : line.style_solid

    segTop := high
    segBot := low
    curBiasBox := box.new(bar_index, high, bar_index, low,
         xloc = xloc.bar_index,
         bgcolor      = color.new(sc, dayStage == 1 ? math.min(99, boxTransp + 3) : boxTransp),
         border_color = color.new(sc, biasState == 1 ? 50 : 25),
         border_style = sStyle,
         border_width = 1,
         text = sTxt, text_color = sc, text_size = dayStage == 1 ? size.tiny : size.small,
         text_halign = text.align_left,
         text_valign = operBias == 1 ? text.align_top : text.align_bottom)
    array.push(biasBoxes, curBiasBox)
    f_trimBoxes(biasBoxes, historyDays * 4)
    lastSegKey := segKey

    // A transition label only where it carries information — a flip or a
    // recovery. Going unsure is legible from the box alone.
    if biasState == 2 or justRecovered
        label lb = label.new(bar_index, operBias == 1 ? low : high,
             text = (biasState == 2 ? "FLIP " : "BACK ") + (operBias == 1 ? "▲" : "▼"),
             xloc = xloc.bar_index, yloc = yloc.price,
             style = operBias == 1 ? label.style_label_up : label.style_label_down,
             color = color.new(sc, 10), textcolor = color.white, size = size.tiny)
        array.push(biasLabels, lb)
        f_trimLabels(biasLabels, historyDays * 3)

// Level lines, created once the range is final
if provisionalSet and showLevels and tfOk
    curHiLine  := line.new(asiaStartBar, lockHigh, bar_index, lockHigh, xloc = xloc.bar_index,
         color = color.new(neutralColor, 35), width = 1)
    curLoLine  := line.new(asiaStartBar, lockLow,  bar_index, lockLow,  xloc = xloc.bar_index,
         color = color.new(neutralColor, 35), width = 1)
    curMidLine := line.new(asiaStartBar, lockMid,  bar_index, lockMid,  xloc = xloc.bar_index,
         color = color.new(neutralColor, 60), width = 1, style = line.style_dashed)
    array.push(hiLines,  curHiLine)
    array.push(loLines,  curLoLine)
    array.push(midLines, curMidLine)
    f_trimLines(hiLines,  historyDays)
    f_trimLines(loLines,  historyDays)
    f_trimLines(midLines, historyDays)

if londonClosed
    dayDone := true

bool extendDay = dayStage >= 1 and not dayDone and not inAsia and tfOk

if extendDay
    if showBiasBox and not na(curBiasBox)
        segTop := na(segTop) ? high : math.max(segTop, high)
        segBot := na(segBot) ? low  : math.min(segBot, low)
        box.set_right(curBiasBox, bar_index)
        box.set_top(curBiasBox, segTop)
        box.set_bottom(curBiasBox, segBot)
    if showLevels and not na(curHiLine)
        line.set_color(curHiLine,  color.new(f_dirColor(operBias), 30))
        line.set_color(curLoLine,  color.new(f_dirColor(operBias), 30))
        line.set_x2(curHiLine,  bar_index)
        line.set_x2(curLoLine,  bar_index)
        line.set_x2(curMidLine, bar_index)

if not showAsiaBox and array.size(asiaBoxes) > 0
    f_trimBoxes(asiaBoxes, 0)
    curAsiaBox := na
if not showBiasBox and array.size(biasBoxes) > 0
    f_trimBoxes(biasBoxes, 0)
    f_trimLabels(biasLabels, 0)
    curBiasBox := na
if not showLevels and array.size(hiLines) > 0
    f_trimLines(hiLines, 0)
    f_trimLines(loLines, 0)
    f_trimLines(midLines, 0)
    curHiLine  := na
    curLoLine  := na
    curMidLine := na

// ─────────────────────────────────────────────────────────────────────────────
// Bar markers
// ─────────────────────────────────────────────────────────────────────────────
plotshape(biasLocked and locationDir ==  1, "London Opened Above Asia Mid", shape.triangleup,
     location.belowbar, color.new(bullColor, 25), size = size.tiny, text = "MID+")
plotshape(biasLocked and locationDir == -1, "London Opened Below Asia Mid", shape.triangledown,
     location.abovebar, color.new(bearColor, 25), size = size.tiny, text = "MID−")
plotshape(newBreakUp,   "Break Above Asia High", shape.triangleup,
     location.belowbar, color.new(bullColor, 55), size = size.tiny)
plotshape(newBreakDown, "Break Below Asia Low",  shape.triangledown,
     location.abovebar, color.new(bearColor, 55), size = size.tiny)
plotshape(justUnsure, "Bias Went Unsure", shape.diamond,
     location.abovebar, color.new(flagColor, 20), size = size.tiny)

// ─────────────────────────────────────────────────────────────────────────────
// Panel
// ─────────────────────────────────────────────────────────────────────────────
var table panel = table.new(position.top_right, 2, 18,
     border_width = 1, border_color = color.new(color.gray, 65),
     frame_width = 1, frame_color = color.new(color.gray, 65))

f_row(int r, string k, string v, color c) =>
    table.cell(panel, 0, r, k, text_size = size.tiny, text_color = color.new(color.gray, 15),
         text_halign = text.align_left,  bgcolor = color.new(color.black, 86))
    table.cell(panel, 1, r, v, text_size = size.tiny, text_color = c,
         text_halign = text.align_right, bgcolor = color.new(color.black, 86))

f_section(int r, string k) =>
    table.cell(panel, 0, r, k, text_size = size.tiny, text_color = color.new(color.gray, 40),
         text_halign = text.align_left,  bgcolor = color.new(color.black, 70))
    table.cell(panel, 1, r, "", text_size = size.tiny, bgcolor = color.new(color.black, 70))

f_num(float v, string fmt) => na(v) ? "—" : str.tostring(v, fmt)

if showTable and barstate.islast
    if not tfOk
        table.cell(panel, 0, 0, "Use an intraday chart (5m–1h)", text_size = size.small,
             text_color = bearColor, bgcolor = color.new(color.black, 80))
    else
        string stageText = dayStage == 2 ? "LOCKED" : dayStage == 1 ? "PROVISIONAL" : inAsia ? "ASIA FORMING" : "—"

        f_row(0, "OPERATING BIAS", dayStage < 2 ? "—" : f_dirWord(operBias), f_dirColor(operBias))
        f_row(1, "State", dayStage < 2 ? "—" : f_stateWord(biasState)
             + (flipCount > 0 ? "  (" + str.tostring(flipCount, "#") + ")" : ""),
             biasState == 2 ? flagColor : biasState == 1 ? neutralColor : f_dirColor(operBias))
        f_row(2, "Locked bias", dayStage < 2 ? "—" : f_dirWord(lockedBias) + "  " + f_num(lockScore, "#.00"),
             color.new(color.gray, 15))
        f_row(3, "Stage", stageText, color.new(color.gray, 15))

        f_section(4, "LIVE EVIDENCE  (+ holds · − contradicts)")
        f_row(5, "Score", f_num(liveScore, "#.00"),
             na(liveScore) ? color.new(color.gray, 15) : liveScore >= 0 ? bullColor : bearColor)
        f_row(6, "· Structure", lastBreakDir == 0 ? "no break" :
             (lastBreakDir == 1 ? "above high" : "below low"),
             lockedBias == 0 or lastBreakDir == 0 ? color.new(color.gray, 15) :
             lastBreakDir == lockedBias ? bullColor : bearColor)
        f_row(7, "· Displacement", f_num(math.max(maxAbove, maxBelow) / atrSafe, "#.00") + "× ATR "
             + (maxAbove > maxBelow ? "up" : maxBelow > 0 ? "down" : ""),
             dayStage < 2 or lockedBias == 0 ? color.new(color.gray, 15) : eDisp >= 0 ? bullColor : bearColor)
        f_row(8, "· Acceptance", postBars == 0 ? "—" :
             str.tostring(math.round(math.max(accUp, accDn) * 100), "#") + "% "
             + (accUp >= accDn ? "above" : "below"),
             dayStage < 2 or lockedBias == 0 ? color.new(color.gray, 15) : eAccept >= 0 ? bullColor : bearColor)
        f_row(9, "· Location now", f_num(locNow, "#.00"),
             dayStage < 2 or lockedBias == 0 ? color.new(color.gray, 15) : eLoc >= 0 ? bullColor : bearColor)
        f_row(10, "Both sides taken", bothSides ? "YES — no side" : "no",
             bothSides ? flagColor : color.new(color.gray, 15))

        f_section(11, "ASIA READ" + (invertAsiaLocation ? "   (inverted)" : ""))
        f_row(12, "· Loc / Drv / VWAP", f_num(fLocation, "#.0") + "  " + f_num(fDrive, "#.0") + "  " + f_num(fVwap, "#.0"),
             na(asiaRead) ? color.new(color.gray, 15) : nz(asiaRead) >= 0 ? bullColor : bearColor)
        f_row(13, "· Sequence", fSequence > 0 ? "low → high" : fSequence < 0 ? "high → low" : "—",
             fSequence > 0 ? bullColor : fSequence < 0 ? bearColor : color.new(color.gray, 15))

        f_section(14, "LOCK COMPONENTS")
        f_row(15, "London open vs mid", dayStage >= 2 ? f_dirText(locationDir) : "waiting",
             locationDir > 0 ? bullColor : locationDir < 0 ? bearColor : color.new(color.gray, 15))
        f_row(16, "Prior-day sweep/fail", dayStage >= 1 ? f_dirText(sweepDir) : "waiting",
             sweepDir > 0 ? bullColor : sweepDir < 0 ? bearColor : color.new(color.gray, 15))

        f_row(17, f_regimeText(regime),
             (na(rangeAtr) ? "—" : str.tostring(rangeAtr, "#.00") + "× ATR")
             + "  ·  " + f_regimeNote(regime) + (needBars > 1 ? " (2)" : ""),
             regime == 0 ? color.new(color.gray, 15) : flagColor)

// ─────────────────────────────────────────────────────────────────────────────
// Filter outputs
//
// OPERATING BIAS is the one to trade off — it is 0 whenever the engine is unsure,
// which is a real answer and not a missing one. LOCKED BIAS is the unchanged
// prediction, kept so you can score the model separately from the adaptation.
// Comparing the two over a sample tells you whether flipping is earning its keep.
// ─────────────────────────────────────────────────────────────────────────────
float operOut   = dayStage >= 2 ? float(operBias) : 0.0
float lockedOut = dayStage >= 2 ? float(lockedBias) : 0.0
float provOut   = dayStage == 1 and not na(provScore) ?
     (provScore >= biasThresh ? 1.0 : provScore <= -biasThresh ? -1.0 : 0.0) : 0.0

plot(operOut,          "Operating Bias (+1/0/-1)",       display = display.data_window)
plot(lockedOut,        "Locked Bias (+1/-1)",            display = display.data_window)
plot(provOut,          "Provisional Bias (+1/-1)",       display = display.data_window)
plot(float(biasState), "State (0 hold/1 unsure/2 flip)",  display = display.data_window)
plot(float(flipCount), "Flips Today",                    display = display.data_window)
plot(float(dayStage),  "Stage (0 form/1 prov/2 lock)",   display = display.data_window)

plot(lockScore,  "Lock Score (-1..+1)",  display = display.data_window)
plot(liveScore,  "Live Evidence (-1..+1)", display = display.data_window)
plot(na(liveScore) ? 0.0 : math.abs(liveScore), "Evidence Conviction (0-1)", display = display.data_window)

plot(eStruct,  "Evidence: Structure",    display = display.data_window)
plot(eDisp,    "Evidence: Displacement", display = display.data_window)
plot(eAccept,  "Evidence: Acceptance",   display = display.data_window)
plot(eLoc,     "Evidence: Location Now", display = display.data_window)
plot(bothSides ? 1.0 : 0.0, "Both Sides Taken (0/1)", display = display.data_window)
plot(float(lastBreakDir),   "Last Break Direction",   display = display.data_window)

plot(float(locationDir), "Lock: London vs Asia Mid", display = display.data_window)
plot(float(sweepDir),    "Lock: Prior-Day Sweep",    display = display.data_window)
plot(nz(asiaRead),       "Lock: Asia Read",          display = display.data_window)

plot(fLocation, "Asia Factor: Location", display = display.data_window)
plot(fDrive,    "Asia Factor: Drive",    display = display.data_window)
plot(fVwap,     "Asia Factor: VWAP",     display = display.data_window)
plot(fSequence, "Asia Factor: Sequence", display = display.data_window)

plot(float(regime), "Regime (-1 coiled/0/+1 expanded)", display = display.data_window)
plot(rangeAtr,      "Asia Range / Daily ATR",           display = display.data_window)
plot(rangePct,      "Asia Range (% of own avg)",        display = display.data_window)
plot(atrRegime,     "Volatility Regime (ATR / avg)",    display = display.data_window)

plot(dayStage >= 1 ? lockHigh : na, "Asia High", display = display.data_window)
plot(dayStage >= 1 ? lockLow  : na, "Asia Low",  display = display.data_window)
plot(dayStage >= 1 ? lockMid  : na, "Asia Mid",  display = display.data_window)
plot(asiaVwap,      "Asia VWAP",      display = display.data_window)
plot(prevDayHigh,   "Prior Day High", display = display.data_window)
plot(prevDayLow,    "Prior Day Low",  display = display.data_window)

plot(inAsia   ? 1.0 : 0.0, "In Asia",   display = display.data_window)
plot(inLondon ? 1.0 : 0.0, "In London", display = display.data_window)

// ─────────────────────────────────────────────────────────────────────────────
// Alerts
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(provisionalSet, "Provisional Bias Set",
     "Asian session closed - provisional bias set, awaiting the London open")
alertcondition(biasLocked and lockedBias ==  1, "Daily Bias Bullish",
     "London opened - daily bias LOCKED BULLISH")
alertcondition(biasLocked and lockedBias == -1, "Daily Bias Bearish",
     "London opened - daily bias LOCKED BEARISH")
alertcondition(biasLocked and lockedBias ==  0, "Daily Bias Unsure",
     "London opened - lock components disagree, no directional bias today")
alertcondition(justFlipped, "Bias FLIPPED",
     "Evidence reversed the operating bias against the locked bias")
alertcondition(justUnsure, "Bias Went UNSURE",
     "Contrary evidence - operating bias is now flat, not directional")
alertcondition(justRecovered, "Bias Recovered",
     "Evidence returned to the locked bias - operating bias is directional again")
alertcondition(biasLocked and regime == -1, "Coiled Asia",
     "Asian range closed coiled - higher two-sided sweep risk, confirm the first break")
alertcondition(biasLocked and regime ==  1, "Expanded Asia",
     "Asian range closed expanded - first break more trustworthy, less follow-through")
