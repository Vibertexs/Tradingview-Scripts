//@version=6
strategy(
     "Asian Range Break-and-Retrace v3",
     overlay = true,
     initial_capital = 10000,
     default_qty_type = strategy.fixed,
     default_qty_value = 1,
     commission_type = strategy.commission.percent,
     commission_value = 0.00267,
     pyramiding = 0,
     calc_on_every_tick = false,
     calc_on_order_fills = false,
     process_orders_on_close = false,
     backtest_fill_limits_assumption = 1,
     use_bar_magnifier = true,
     max_boxes_count = 500
)


// =====================================================================
// SETTINGS
// =====================================================================

string TZ = "Europe/London"

// Monday-Friday.
// Asian:  00:00-07:00 London
// London: 08:00-16:00 London
string ASIA_SESSION = "0000-0700:23456"
string LONDON_SESSION = "0800-1600:23456"


// Entry
float retracePct = input.float(
     50.0,
     "Retrace % of Asian range",
     minval = 0.0,
     maxval = 100.0,
     step = 5.0,
     group = "Entry"
)

int maxTrades = input.int(
     2,
     "Max trades per day",
     minval = 1,
     maxval = 4,
     group = "Entry"
)


// Stop
bool useStop = input.bool(
     true,
     "Use Stop Loss",
     group = "Stop Loss"
)

float stopPct = input.float(
     50.0,
     "Stop distance (% of Asian range)",
     minval = 5.0,
     maxval = 200.0,
     step = 5.0,
     group = "Stop Loss"
)


// Target
string targetMode = input.string(
     "Extension",
     "Take Profit",
     options = ["Off", "Extension", "R multiple"],
     group = "Take Profit"
)

float targetR = input.float(
     1.0,
     "Target R multiple",
     minval = 0.25,
     maxval = 5.0,
     step = 0.25,
     group = "Take Profit"
)


// End of day
bool useEodExit = input.bool(
     true,
     "Close at 21:00 London",
     group = "Time Exit"
)


// Display
bool showSessions = input.bool(
     true,
     "Draw Asian & London sessions",
     group = "Display"
)

bool showAsianLevels = input.bool(
     true,
     "Show Asian High / Low",
     group = "Display"
)

bool showOrders = input.bool(
     true,
     "Show Entry / SL / TP",
     group = "Display"
)


// =====================================================================
// SESSION DETECTION
// =====================================================================

bool inAsia = not na(time(timeframe.period, ASIA_SESSION, TZ))
bool inLondon = not na(time(timeframe.period, LONDON_SESSION, TZ))

bool asiaStart = inAsia and not inAsia[1]
bool asiaEnd = not inAsia and inAsia[1]

bool londonStart = inLondon and not inLondon[1]
bool londonEnd = not inLondon and inLondon[1]


// Do not place an order on the final London bar.
//
// 15m:
// last placement = 15:30 close
// possible fill = 15:45-16:00
//
// 5m:
// last placement = 15:50 close
// possible fill = 15:55-16:00
int closeHourLondon = hour(time_close, TZ)

bool canPlace = inLondon and closeHourLondon < 16


// 21:00 London closing bar.
// Works automatically on 5m and 15m.
int barCloseHour = hour(time_close, TZ)
int barCloseMinute = minute(time_close, TZ)

bool eodBar = barCloseHour == 21 and barCloseMinute == 0


// =====================================================================
// ASIAN RANGE
// =====================================================================

var float asiaHigh = na
var float asiaLow = na
var bool asiaReady = false


if asiaStart

    asiaHigh := high
    asiaLow := low
    asiaReady := false


else if inAsia

    asiaHigh := math.max(asiaHigh, high)
    asiaLow := math.min(asiaLow, low)


if asiaEnd
    asiaReady := true


float asiaRange = na

if asiaReady
    asiaRange := asiaHigh - asiaLow


bool rangeOK = asiaReady and not na(asiaRange) and asiaRange > 0


// =====================================================================
// SESSION BOXES
// =====================================================================

var box asiaBox = na
var box londonBox = na

var float londonHigh = na
var float londonLow = na


// ---------------- ASIAN BOX

if asiaStart

    if showSessions
        asiaBox := box.new(
             left = bar_index,
             top = high,
             right = bar_index,
             bottom = low,
             bgcolor = color.new(color.gray, 90),
             border_color = color.new(color.gray, 55)
        )


if inAsia

    if showSessions and not na(asiaBox)

        box.set_right(asiaBox, bar_index)
        box.set_top(asiaBox, asiaHigh)
        box.set_bottom(asiaBox, asiaLow)


// ---------------- LONDON BOX

if londonStart

    londonHigh := high
    londonLow := low

    if showSessions
        londonBox := box.new(
             left = bar_index,
             top = high,
             right = bar_index,
             bottom = low,
             bgcolor = color.new(color.blue, 92),
             border_color = color.new(color.blue, 65)
        )


else if inLondon

    londonHigh := math.max(londonHigh, high)
    londonLow := math.min(londonLow, low)


if inLondon

    if showSessions and not na(londonBox)

        box.set_right(londonBox, bar_index)
        box.set_top(londonBox, londonHigh)
        box.set_bottom(londonBox, londonLow)


// =====================================================================
// DAILY STRATEGY STATE
// =====================================================================

var int tradesToday = 0

// 0  = no setup
// 1  = long setup
// -1 = short setup
var int setupDir = 0

var float extension = na

var float entryLevel = na
var float stopLevel = na
var float targetLevel = na


// Reset on each new Asian session.
if asiaStart

    tradesToday := 0

    setupDir := 0
    extension := na

    if strategy.position_size == 0

        strategy.cancel("ARR")
        strategy.cancel("ARR-X")

        entryLevel := na
        stopLevel := na
        targetLevel := na


// =====================================================================
// DETECT BREAKOUT
// =====================================================================

if rangeOK and inLondon and strategy.position_size == 0

    if setupDir == 0 and tradesToday < maxTrades

        // Upside breakout.
        if close > asiaHigh

            setupDir := 1
            extension := high


        // Downside breakout.
        else if close < asiaLow

            setupDir := -1
            extension := low


    // ---------------------------------------------------------------
    // Once breakout exists, keep tracking the furthest extension.
    // ---------------------------------------------------------------

    else if setupDir == 1

        extension := math.max(extension, high)


    else if setupDir == -1

        extension := math.min(extension, low)


// =====================================================================
// ENTRY TRIGGER
//
// ORIGINAL STRATEGY LOGIC:
//
// LONG:
// extension - X% of Asian range
//
// SHORT:
// extension + X% of Asian range
// =====================================================================

float trigger = na


if setupDir == 1 and rangeOK

    trigger := extension - retracePct / 100.0 * asiaRange


if setupDir == -1 and rangeOK

    trigger := extension + retracePct / 100.0 * asiaRange


// =====================================================================
// PLACE ENTRY + PREDEFINED SL / TP
// =====================================================================

if canPlace and setupDir != 0 and not na(trigger)

    if strategy.position_size == 0 and tradesToday < maxTrades

        // -------------------------------------------------------------
        // ENTRY
        // -------------------------------------------------------------

        entryLevel := trigger


        // -------------------------------------------------------------
        // STOP
        // -------------------------------------------------------------

        stopLevel := na

        if useStop

            float stopDistance = stopPct / 100.0 * asiaRange

            if setupDir == 1
                stopLevel := entryLevel - stopDistance

            if setupDir == -1
                stopLevel := entryLevel + stopDistance


        // -------------------------------------------------------------
        // TARGET
        // -------------------------------------------------------------

        targetLevel := na


        // Retest the breakout extension.
        if targetMode == "Extension"

            targetLevel := extension


        // R-multiple target.
        if targetMode == "R multiple"

            if useStop and not na(stopLevel)

                float risk = math.abs(entryLevel - stopLevel)

                if setupDir == 1
                    targetLevel := entryLevel + targetR * risk

                if setupDir == -1
                    targetLevel := entryLevel - targetR * risk


        // -------------------------------------------------------------
        // LONG ENTRY
        // -------------------------------------------------------------

        if setupDir == 1

            strategy.entry(
                 "ARR",
                 strategy.long,
                 limit = entryLevel
            )


        // -------------------------------------------------------------
        // SHORT ENTRY
        // -------------------------------------------------------------

        if setupDir == -1

            strategy.entry(
                 "ARR",
                 strategy.short,
                 limit = entryLevel
            )


        // -------------------------------------------------------------
        // SL + TP
        //
        // These are created BEFORE the entry fills.
        // -------------------------------------------------------------

        bool hasStop = useStop and not na(stopLevel)
        bool hasTarget = targetMode != "Off" and not na(targetLevel)


        if hasStop and hasTarget

            strategy.exit(
                 "ARR-X",
                 from_entry = "ARR",
                 stop = stopLevel,
                 limit = targetLevel
            )


        else if hasStop

            strategy.exit(
                 "ARR-X",
                 from_entry = "ARR",
                 stop = stopLevel
            )


        else if hasTarget

            strategy.exit(
                 "ARR-X",
                 from_entry = "ARR",
                 limit = targetLevel
            )


// =====================================================================
// COUNT ACTUAL FILLS
// =====================================================================

int totalTrades = strategy.closedtrades + strategy.opentrades
int previousTotalTrades = nz(totalTrades[1], 0)

bool newTradeFilled = totalTrades > previousTotalTrades


if newTradeFilled

    tradesToday += totalTrades - previousTotalTrades

    setupDir := 0
    extension := na


// =====================================================================
// END OF LONDON SESSION
//
// Kill any entry that never filled.
// Do NOT cancel SL/TP if a position is already open.
// =====================================================================

if londonEnd

    strategy.cancel("ARR")

    if strategy.position_size == 0

        strategy.cancel("ARR-X")

        setupDir := 0
        extension := na

        entryLevel := na
        stopLevel := na
        targetLevel := na


// =====================================================================
// 21:00 LONDON EXIT
// =====================================================================

if useEodExit and eodBar

    strategy.cancel("ARR")

    setupDir := 0
    extension := na

    if strategy.position_size != 0

        strategy.cancel("ARR-X")

        strategy.close(
             "ARR",
             comment = "21:00 London",
             immediately = true
        )


// =====================================================================
// CLEAR OLD TRADE LEVELS AFTER EXIT
// =====================================================================

bool tradeClosed = strategy.closedtrades > nz(strategy.closedtrades[1], 0)


if tradeClosed and strategy.position_size == 0

    entryLevel := na
    stopLevel := na
    targetLevel := na


// =====================================================================
// PLOTS
// =====================================================================

// Only show completed Asian levels AFTER the Asian session.
float asiaHighPlot = na
float asiaLowPlot = na

if showAsianLevels and asiaReady and not inAsia

    asiaHighPlot := asiaHigh
    asiaLowPlot := asiaLow


plot(
     asiaHighPlot,
     "Asian High",
     color = color.new(color.green, 0),
     linewidth = 2,
     style = plot.style_linebr
)

plot(
     asiaLowPlot,
     "Asian Low",
     color = color.new(color.red, 0),
     linewidth = 2,
     style = plot.style_linebr
)


// Extension while waiting for retracement.
float extensionPlot = na

if setupDir != 0
    extensionPlot := extension


plot(
     extensionPlot,
     "Extension",
     color = color.gray,
     linewidth = 1,
     style = plot.style_linebr
)


// Entry.
float entryPlot = na

if showOrders
    if setupDir != 0 or strategy.position_size != 0
        entryPlot := entryLevel


plot(
     entryPlot,
     "Entry",
     color = color.blue,
     linewidth = 2,
     style = plot.style_linebr
)


// Stop.
float stopPlot = na

if showOrders
    if setupDir != 0 or strategy.position_size != 0
        stopPlot := stopLevel


plot(
     stopPlot,
     "Stop Loss",
     color = color.red,
     linewidth = 2,
     style = plot.style_linebr
)


// Target.
float targetPlot = na

if showOrders
    if setupDir != 0 or strategy.position_size != 0
        targetPlot := targetLevel


plot(
     targetPlot,
     "Take Profit",
     color = color.green,
     linewidth = 2,
     style = plot.style_linebr
)
